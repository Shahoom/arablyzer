{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  // `src` leaves out the folders whose names start with a dot: security.txt lives in one.
  "include": [
    ".astro/types.d.ts",
    "astro.config.ts",
    "src",
    "src/pages/.well-known/security.txt.ts",
    "test",
    "scripts"
  ],
  "exclude": ["dist"]
}
