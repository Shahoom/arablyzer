{
  "name": "@arablyzer/web",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/generate.ts && astro dev",
    "build": "tsx scripts/generate.ts && astro build && tsx scripts/og-images.ts && tsx scripts/indexnow.ts --write-key --on-build",
    "preview": "astro preview",
    "typecheck": "tsx scripts/generate.ts && astro check && tsc --noEmit",
    "test": "vitest run --exclude \"test/browser/**\"",
    "test:browser": "vitest run test/browser",
    "lighthouse": "tsx scripts/lighthouse.ts",
    "generate": "tsx scripts/generate.ts",
    "copy:review": "tsx scripts/check-blog-review.ts",
    "indexnow": "tsx scripts/indexnow.ts --submit"
  },
  "dependencies": {
    "@arablyzer/api-contract": "workspace:*",
    "@arablyzer/browser": "workspace:*",
    "@arablyzer/egress": "workspace:*",
    "@arablyzer/engine": "workspace:*",
    "@arablyzer/fixtures": "workspace:*",
    "@arablyzer/generators": "workspace:*",
    "@arablyzer/guides": "workspace:*",
    "@arablyzer/i18n": "workspace:*",
    "@arablyzer/report-schema": "workspace:*",
    "@arablyzer/rules": "workspace:*",
    "@arablyzer/scoring": "workspace:*",
    "@arablyzer/seo": "workspace:*",
    "@arablyzer/tools": "workspace:*",
    "@astrojs/preact": "6.0.5",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@lucide/astro": "1.49.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.5",
    "lucide-preact": "1.49.0",
    "preact": "10.29.8",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "chrome-launcher": "1.2.2",
    "lighthouse": "13.5.0",
    "playwright-core": "1.63.0",
    "typescript": "~6.0.3"
  }
}
