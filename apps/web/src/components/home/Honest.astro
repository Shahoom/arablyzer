---
import { codeParts, HOME } from '@arablyzer/i18n'
import type { Lang } from '@arablyzer/seo/site'
import Code from '@lucide/astro/icons/code'
import Ruler from '@lucide/astro/icons/ruler'
import ShieldCheck from '@lucide/astro/icons/shield-check'
import Bidi from '../Bidi.astro'
import Crosshairs from '../Crosshairs.astro'
import SectionHead from '../SectionHead.astro'
import { REPOSITORY } from '../../lib/site'
import { SHOWCASE, terminalLines } from '../../lib/showcase'

interface Props {
  lang: Lang
  number: number
}
const { lang, number } = Astro.props
const t = HOME[lang].honest
const icons = [Code, Ruler, ShieldCheck]
const lines = terminalLines(lang)
// The CLI's own marks: ✗ with a severity word opens a finding, • one of its messages.
const ARABIC = /\p{Script=Arabic}/u
const kind = (line: string) =>
  line.startsWith('✗')
    ? 'rule'
    : line.trimStart().startsWith('•')
      ? 'message'
      : line.startsWith(' ')
        ? 'where'
        : 'plain'
---

<section class="grid items-start gap-10 border-y border-ink bg-white px-5 py-10 md:px-16 md:py-[88px] lg:grid-cols-12 lg:gap-x-12">
  <div class="flex flex-col gap-[30px] lg:col-span-5">
    <SectionHead number={number} label={t.kicker} id="honest-title" title={t.title} size="md" />
    <dl class="m-0 flex flex-col border-t border-ink">
      {t.points.map((point, index) => {
        const Icon = icons[index] ?? Code
        return (
          <div class="grid grid-cols-[44px_minmax(0,1fr)] gap-4 border-b border-rule py-5">
            <span class="flex size-11 items-center justify-center border-[1.5px] border-ink">
              <Icon size={20} stroke-width={1.8} aria-hidden="true" />
            </span>
            <div class="flex flex-col gap-1">
              <dt class="text-lg font-semibold">{point.title}</dt>
              <dd class="m-0 text-[15px] leading-[1.8] text-ink-2">{point.text}</dd>
            </div>
          </div>
        )
      })}
    </dl>
  </div>
  <figure
    class="relative m-0 flex min-w-0 flex-col bg-panel-grid lg:col-span-7"
    aria-labelledby="terminal-title"
  >
    <Crosshairs corners={['start-start', 'end-end']} />
    <div class="flex items-center justify-between border-b border-panel-line px-4 py-[13px] text-xs text-panel-dim md:px-[22px]">
      <span class="flex items-center gap-2.5">
        <span class="flex gap-[5px]" aria-hidden="true">
          <span class="size-2 border border-panel-tick"></span>
          <span class="size-2 border border-panel-tick"></span>
          <span class="size-2 border border-panel-tick"></span>
        </span>
        <span id="terminal-title">{t.terminal.title}</span>
      </span>
      <a href={REPOSITORY} dir="ltr" class="font-mono text-panel-measure hover:underline">
        GitHub ↗
      </a>
    </div>
    <pre class="m-0 px-4 pt-6 pb-7 text-[13px] leading-[1.95] whitespace-pre-wrap text-panel-soft md:px-[26px] md:text-sm"><span class="block font-sans text-panel-dim" dir={lang === 'ar' ? 'rtl' : 'ltr'}><Bidi text={t.terminal.caption(SHOWCASE.page)} lang={lang} /></span>{lines.map((line) => (
        <span
          dir="auto"
          class:list={[
            'block min-h-[1.95em]',
            ARABIC.test(line) ? 'font-sans' : 'font-mono',
            kind(line) === 'rule' && 'pt-3 font-semibold text-white',
            kind(line) === 'message' && 'ps-5',
            kind(line) === 'where' && 'ps-9 text-panel-dim',
          ]}><Bidi text={line.trimStart()} lang={lang} /></span>
      ))}</pre>
    <figcaption class="border-t border-panel-line px-4 py-4 text-sm leading-[1.8] text-panel-dim md:px-[22px]">
      {codeParts(t.terminal.footer).map((part) =>
        part.code ? (
          <code dir="ltr" class="font-mono text-panel-text">
            {part.text}
          </code>
        ) : (
          part.text
        ),
      )}
    </figcaption>
  </figure>
</section>
