---
import { HOME } from '@arablyzer/i18n'
import { organization, softwareApplication, webSite } from '@arablyzer/seo/json-ld'
import { localePath, pageUrl, PATHS, type Lang } from '@arablyzer/seo/site'
import Page from '../../layouts/Page.astro'
import { feedLinks } from '../../lib/feeds'
import { CLOUDTOPIA, siteOf } from '../../lib/site'
import Bento from './Bento.astro'
import Counts from './Counts.astro'
import Faq from './Faq.astro'
import FinalCta from './FinalCta.astro'
import Hero from './Hero.astro'
import HowItWorks from './HowItWorks.astro'
import Monitoring from './Monitoring.astro'
import Plans from './Plans.astro'
import ToolsMarquee from './ToolsMarquee.astro'

/**
 * The home page: the hero (with the product shot), then the sections under it a section's gap
 * apart (`gap-section`: 40 px on a phone, 56 on a tablet, 72 on a desktop). The marquee and the
 * counts are one strip of proof, so they sit closer to each other than sections do.
 */
interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = HOME[lang]
const site = siteOf(Astro.site)
const url = pageUrl(site, lang, PATHS.home)
// The publisher once (every page of the site points at it by its @id), the site with the search it
// really has (the knowledge hub reads ?q=), and the product: only markup the page can show.
const jsonLd = [
  organization({
    name: 'Arablyzer',
    url: pageUrl(site, 'ar', PATHS.home),
    origin: site.origin,
    logo: `${site.origin}/favicon.svg`,
    description: HOME.en.meta.description,
    parent: { name: 'CloudTopia', url: CLOUDTOPIA },
  }),
  webSite({
    name: 'Arablyzer',
    url,
    origin: site.origin,
    lang,
    description: t.meta.description,
    searchUrl: `${site.origin}${localePath(lang, PATHS.knowledge)}?q={search_term_string}`,
  }),
  softwareApplication({
    name: 'Arablyzer',
    description: t.meta.description,
    url,
    origin: site.origin,
    lang,
  }),
]
---

<Page
  lang={lang}
  path={PATHS.home}
  title={t.meta.title}
  description={t.meta.description}
  jsonLd={jsonLd}
  feeds={feedLinks(site, lang)}
>
  <Hero lang={lang} />
  <div class="flex flex-col gap-section pt-4 pb-section md:pt-6">
    <div class="flex flex-col gap-5 md:gap-6">
      <ToolsMarquee lang={lang} />
      <Counts lang={lang} />
    </div>
    <Bento lang={lang} />
    <HowItWorks lang={lang} />
    <Monitoring lang={lang} />
    <Plans lang={lang} />
    <Faq lang={lang} />
    <FinalCta lang={lang} />
  </div>
</Page>
