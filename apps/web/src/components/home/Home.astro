---
import { HOME } from '@arablyzer/i18n'
import { webApplication } from '@arablyzer/seo/json-ld'
import { pageUrl, PATHS, type Lang } from '@arablyzer/seo/site'
import Page from '../../layouts/Page.astro'
import { CLOUDTOPIA, siteOf } from '../../lib/site'
import Bento from './Bento.astro'
import Counts from './Counts.astro'
import Faq from './Faq.astro'
import FinalCta from './FinalCta.astro'
import Hero from './Hero.astro'
import HowItWorks from './HowItWorks.astro'
import Monitoring from './Monitoring.astro'
import Plans from './Plans.astro'
import ToolsMarquee from './ToolsMarquee.astro'

/**
 * The home page: the hero (with the product shot), then the sections under it a section's gap
 * apart (`gap-section`: 40 px on a phone, 56 on a tablet, 72 on a desktop). The marquee and the
 * counts are one strip of proof, so they sit closer to each other than sections do.
 */
interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = HOME[lang]
const url = pageUrl(siteOf(Astro.site), lang, PATHS.home)
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Arablyzer',
    url,
    inLanguage: lang,
    description: t.meta.description,
    publisher: { '@type': 'Organization', name: 'CloudTopia', url: CLOUDTOPIA },
  },
  webApplication({ name: 'Arablyzer', description: t.meta.description, url, lang }),
]
---

<Page
  lang={lang}
  path={PATHS.home}
  title={t.meta.title}
  description={t.meta.description}
  jsonLd={jsonLd}
>
  <Hero lang={lang} />
  <div class="flex flex-col gap-section pt-4 pb-section md:pt-6">
    <div class="flex flex-col gap-5 md:gap-6">
      <ToolsMarquee lang={lang} />
      <Counts lang={lang} />
    </div>
    <Bento lang={lang} />
    <HowItWorks lang={lang} />
    <Monitoring lang={lang} />
    <Plans lang={lang} />
    <Faq lang={lang} />
    <FinalCta lang={lang} />
  </div>
</Page>
