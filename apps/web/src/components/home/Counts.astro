---
import { HOME } from '@arablyzer/i18n'
import type { Lang } from '@arablyzer/seo/site'
import { homeCounts } from '../../lib/home'
import Bidi from '../Bidi.astro'

/**
 * Five numbers, each counted from its registry when the site is built (lib/home.ts): the tools,
 * the rules a scan runs, the browsers a page opens in, the glossary's terms and the fix guides.
 * The number is in the HTML as it stands; with script and without reduced motion, it counts up
 * once when it comes into view.
 *
 * On a phone (M2.6 R7) it is a compact grid of two columns of 64 px cells, the number beside its
 * noun, the last cell (the longest noun) across both columns; on a tablet three cells over two;
 * from lg the five are one row, each with its number over its noun, at the start of its cell. R8
 * draws them as a ledger and not as five cards: one hairline between cells (the grid's gap shows the
 * band's colour), none round them. The number's box is two digits wide, so counting up does not
 * move its noun.
 */
interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = HOME[lang].counts
const counts = homeCounts()
const stats = [
  { count: counts.tools, label: t.tools(counts.tools) },
  { count: counts.rules, label: t.rules(counts.rules) },
  { count: counts.engines, label: t.browsers(counts.engines) },
  { count: counts.terms, label: t.terms(counts.terms) },
  { count: counts.guides, label: t.guides(counts.guides) },
]
---

<section aria-label={t.label} class="wrap below-fold strip">
  <ul class="m-0 grid list-none grid-cols-2 gap-px border-y border-line bg-line p-0 md:grid-cols-6 lg:grid-cols-5">
    {stats.map((stat, index) => (
      <li
        class:list={[
          'flex min-h-16 items-center justify-center gap-2.5 bg-bg px-card py-3 lg:min-h-0 lg:flex-col lg:items-start lg:gap-1 lg:py-6',
          // Two columns on a phone with the last tile across both, three tiles over two on a
          // tablet, five in a row on a desktop.
          index === stats.length - 1 && 'col-span-2',
          index < 3 ? 'md:col-span-2 lg:col-span-1' : 'md:col-span-3 lg:col-span-1',
        ]}
      >
        <b
          class="gradient-text min-w-[2ch] text-[1.625rem] leading-[1.15] font-semibold tabular-nums lg:min-w-0 lg:text-[2.5rem]"
          data-count={stat.count}
        >
          {stat.count}
        </b>
        <span class="text-meta text-ink-2 lg:text-small">
          <Bidi text={stat.label} lang={lang} />
        </span>
      </li>
    ))}
  </ul>
</section>

<style>
  /* The browser's placeholder until the section is laid out: its measured height on a phone, a
     tablet and a desktop (the real height is remembered once it has been drawn). */
  .strip {
    contain-intrinsic-size: auto 216px;
  }
  @media (min-width: 48rem) {
    .strip {
      contain-intrinsic-size: auto 152px;
    }
  }
  @media (min-width: 64rem) {
    .strip {
      contain-intrinsic-size: auto 116px;
    }
  }
</style>

<script>
  // Counts each number up from 0 once, when it scrolls into view. The number is in the HTML as it
  // stands, so none of this is needed to read it: without script, without IntersectionObserver,
  // or with reduced motion, it just stays.
  const targets = document.querySelectorAll<HTMLElement>('[data-count]')
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  if (targets.length > 0 && !still && 'IntersectionObserver' in window) {
    const count = (target: HTMLElement) => {
      const end = Number(target.dataset.count)
      if (!Number.isFinite(end)) return
      const began = performance.now()
      const step = (now: number) => {
        const done = Math.min(1, (now - began) / 1200)
        target.textContent = String(Math.round(end * (1 - (1 - done) ** 3)))
        if (done < 1) requestAnimationFrame(step)
      }
      target.textContent = '0'
      requestAnimationFrame(step)
    }
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue
          observer.unobserve(entry.target)
          count(entry.target as HTMLElement)
        }
      },
      // A little before it is on the screen, so it is already counting when it comes into view.
      { rootMargin: '0px 0px 80px 0px' },
    )
    for (const target of targets) observer.observe(target)
  }
</script>
