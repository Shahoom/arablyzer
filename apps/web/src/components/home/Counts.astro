---
import { HOME } from '@arablyzer/i18n'
import type { Lang } from '@arablyzer/seo/site'
import { homeCounts } from '../../lib/home'
import Bidi from '../Bidi.astro'

/**
 * Five numbers, each counted from its registry when the site is built (lib/home.ts): the tools,
 * the rules a scan runs, the browsers a page opens in, the glossary's terms and the fix guides.
 * The number is in the HTML as it stands; with script and without reduced motion, it counts up
 * once when it comes into view.
 *
 * On a phone (M2.6 R7) it is a compact grid of two columns of 64 px tiles, the number beside its
 * noun, the last tile (the longest noun) across both columns; from md the five are one row, each
 * with its number over its noun. The number's box is two digits wide, so counting up does not move
 * its noun.
 */
interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = HOME[lang].counts
const counts = homeCounts()
const stats = [
  { count: counts.tools, label: t.tools(counts.tools) },
  { count: counts.rules, label: t.rules(counts.rules) },
  { count: counts.engines, label: t.browsers(counts.engines) },
  { count: counts.terms, label: t.terms(counts.terms) },
  { count: counts.guides, label: t.guides(counts.guides) },
]
---

<section aria-label={t.label} class="wrap below-fold strip">
  <ul class="m-0 grid list-none grid-cols-2 gap-3 p-0 md:grid-cols-5 md:gap-card">
    {stats.map((stat, index) => (
      <li
        class:list={[
          'card flex min-h-16 items-center justify-center gap-2.5 px-3 py-2 md:min-h-0 md:flex-col md:justify-center md:gap-1 md:px-4 md:py-5 md:text-center',
          index === stats.length - 1 && 'col-span-2 md:col-span-1',
        ]}
      >
        <b
          class="gradient-text min-w-[2ch] text-[1.625rem] leading-[1.15] font-semibold tabular-nums md:min-w-0 md:text-[2.5rem]"
          data-count={stat.count}
        >
          {stat.count}
        </b>
        <span class="text-meta text-ink-2 md:text-small">
          <Bidi text={stat.label} lang={lang} />
        </span>
      </li>
    ))}
  </ul>
</section>

<style>
  /* A strip of about 220 px on a phone, 120 on a desktop: the browser's placeholder until it is laid out. */
  .strip {
    contain-intrinsic-size: auto 220px;
  }
  @media (min-width: 48rem) {
    .strip {
      contain-intrinsic-size: auto 120px;
    }
  }
</style>

<script>
  // Counts each number up from 0 once, when it scrolls into view. The number is in the HTML as it
  // stands, so none of this is needed to read it: without script, without IntersectionObserver,
  // or with reduced motion, it just stays.
  const targets = document.querySelectorAll<HTMLElement>('[data-count]')
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  if (targets.length > 0 && !still && 'IntersectionObserver' in window) {
    const count = (target: HTMLElement) => {
      const end = Number(target.dataset.count)
      if (!Number.isFinite(end)) return
      const began = performance.now()
      const step = (now: number) => {
        const done = Math.min(1, (now - began) / 1200)
        target.textContent = String(Math.round(end * (1 - (1 - done) ** 3)))
        if (done < 1) requestAnimationFrame(step)
      }
      target.textContent = '0'
      requestAnimationFrame(step)
    }
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue
          observer.unobserve(entry.target)
          count(entry.target as HTMLElement)
        }
      },
      // A little before it is on the screen, so it is already counting when it comes into view.
      { rootMargin: '0px 0px 80px 0px' },
    )
    for (const target of targets) observer.observe(target)
  }
</script>
