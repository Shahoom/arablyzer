---
import { HOME, TOOLS_UI } from '@arablyzer/i18n'
import { localePath, PATHS, type Lang } from '@arablyzer/seo/site'
import ArrowDown from '@lucide/astro/icons/arrow-down'
import Check from '@lucide/astro/icons/check'
import X from '@lucide/astro/icons/x'
import { lettersApart } from '../../lib/arabic'
import { ENGINE_DOT } from '../../lib/engines'
import { BENTO_TOOLS, gauge, VITALS, type Vital } from '../../lib/home'
import { ENGINE_NAMES, SHOWCASE } from '../../lib/showcase'
import { CATEGORY_STYLE, toolData } from '../../lib/tool-data'
import Bidi from '../Bidi.astro'
import BentoTile from './BentoTile.astro'
import SectionIntro from './SectionIntro.astro'

/**
 * What other tools do not see (M2.6 R2): seven tiles, each a link to the tool that checks it. Only
 * the first shows real data (our test page 04, as three browsers drew its heading); the rest are
 * drawn from examples, and each says so with «مثال». The heading's letters part in the WebKit row
 * by a gap that opens and closes between them, with joiners keeping every letter's shape: the
 * effect is CSS alone, and with reduced motion the gaps stay open. The typed name, the arrow and
 * the gauges are CSS too.
 *
 * On a phone (M2.6 R7) the bento is a short list: the first tile, with its three browsers, as a
 * card, and the six others as rows of an icon, a heading and a chevron, each still the link to its
 * tool. The illustrations made of example data (and the «مثال» that marks them) are for md and up:
 * they decorate a title that already says what the tool checks.
 */
interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = HOME[lang].bento
const s = SHOWCASE

/** A tile's tool: where its tile links, and what a screen reader calls it. */
const tool = (slug: (typeof BENTO_TOOLS)[keyof typeof BENTO_TOOLS]) => {
  const { category, copy } = toolData(slug)
  // The tile wears its tool's category: the colour of its dot and its name, the directory's own.
  return {
    href: localePath(lang, PATHS.tool(slug)),
    title: copy[lang].title,
    category: { name: TOOLS_UI[lang].categories[category].name, dot: CATEGORY_STYLE[category].dot },
  }
}
const links = {
  engines: tool(BENTO_TOOLS.engines),
  forms: tool(BENTO_TOOLS.forms),
  whatsapp: tool(BENTO_TOOLS.whatsapp),
  ai: tool(BENTO_TOOLS.ai),
  speed: tool(BENTO_TOOLS.speed),
  trust: tool(BENTO_TOOLS.trust),
  robots: tool(BENTO_TOOLS.robots),
}

// The engines of the test page, in the order it lists them; a heading drawn apart is the finding.
const rows = s.engines.map((run) => ({
  engine: run.engine,
  name: ENGINE_NAMES[run.engine],
  joined: run.joined,
}))

// The sample number a form rejects: Arabic-Indic digits, in a <samp> so that the page's own text
// does not mix two sets of digits (ar-digits-mixed).
const ARABIC_DIGITS = '٠٥٠١٢٣٤٥٦٧'

const AI = [
  { name: 'OpenAI', allowed: true },
  { name: 'Anthropic', allowed: true },
  { name: 'Perplexity', allowed: false },
] as const
const TRUST = [
  { name: 'HTTPS', ok: true },
  { name: 'HSTS', ok: true },
  { name: 'DMARC', ok: false },
] as const

const VITAL_ORDER: readonly Vital[] = ['lcp', 'inp', 'cls']
const GAUGE_COLOUR = { good: '#10b981', mid: '#f59e0b', poor: '#e11d48' } as const
const gauges = VITAL_ORDER.map((vital) => {
  const { value, unit } = VITALS[vital]
  return {
    vital,
    value,
    unit: unit === null ? '' : t.speed[unit],
    ...gauge(vital),
  }
})

const okChip = 'sev sev-pass'
const badChip = 'sev bg-critical-soft text-critical-ink'
const row = 'text-small flex items-center justify-between gap-3 rounded-xl bg-surface-2 px-3 py-3'
---

<section aria-labelledby="bento-title" class="below-fold strip">
  <div class="wrap">
    <SectionIntro id="bento-title" title={t.title} lead={t.lead} phoneLead={false} />

    <div class="grid gap-3 md:auto-rows-[minmax(250px,auto)] md:grid-cols-2 md:gap-card xl:grid-cols-4">
      <BentoTile
        lang={lang}
        title={t.engines.title}
        href={links.engines.href}
        tool={links.engines.title}
        category={links.engines.category}
        featured
        class="mb-1 md:col-span-2 md:mb-0 xl:row-span-2"
      >
        <p class="text-small m-0 text-ink-2">
          <Bidi text={t.engines.text} lang={lang} />
        </p>
        <div class="my-auto flex flex-col gap-2 md:gap-3 xl:gap-3">
          {rows.map((item) => (
            <div
              class:list={[
                // On a phone the engine and its verdict share a line and the word has the one under
                // it, whole; from sm up the three are one row.
                'grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-3 gap-y-1 rounded-xl border px-3 py-2 sm:grid-cols-[118px_minmax(0,1fr)_auto] sm:px-4 sm:py-4',
                item.joined ? 'border-line bg-white' : 'border-[#fecdd3] bg-[#fff5f6]',
              ]}
            >
              <span
                lang="en"
                dir="ltr"
                class="text-meta order-1 inline-flex items-center gap-2 justify-self-start font-semibold sm:order-none"
              >
                <i
                  aria-hidden="true"
                  class:list={['size-2 shrink-0 rounded-full', ENGINE_DOT[item.engine]]}
                />
                {item.name}
              </span>
              {item.joined ? (
                <p
                  lang="ar"
                  dir="rtl"
                  class="order-3 col-span-2 m-0 text-center text-[1.5rem] leading-normal font-semibold whitespace-nowrap sm:order-none sm:col-span-1 sm:text-[1.875rem] xl:text-[2.25rem]"
                >
                  {s.heading.text}
                </p>
              ) : (
                <p class="order-3 col-span-2 m-0 text-center text-[1.5rem] leading-normal font-semibold whitespace-nowrap sm:order-none sm:col-span-1 sm:text-[1.875rem] xl:text-[2.25rem]">
                  <span lang="ar" dir="rtl" aria-hidden="true">
                    {lettersApart(s.heading.text).map((piece) =>
                      piece === null ? <span class="gap" /> : piece,
                    )}
                  </span>
                  <span lang="ar" dir="rtl" class="sr-only">
                    {s.heading.text}
                  </span>
                </p>
              )}
              {item.joined ? (
                <span class:list={[okChip, 'order-2 sm:order-none']}>
                  <Check size={14} stroke-width={2.4} aria-hidden="true" />
                  {t.engines.joined}
                </span>
              ) : (
                <span class:list={[badChip, 'order-2 sm:order-none']}>
                  <X size={14} stroke-width={2.4} aria-hidden="true" />
                  {t.engines.apart}
                </span>
              )}
            </div>
          ))}
        </div>
      </BentoTile>

      <BentoTile
        lang={lang}
        title={t.forms.title}
        href={links.forms.href}
        tool={links.forms.title}
        category={links.forms.category}
        example={t.example}
        class="md:col-span-2"
      >
        <p class="text-small m-0 text-ink-2">
          <Bidi text={t.forms.text} lang={lang} />
        </p>
        <div class="mt-auto grid gap-3 md:grid-cols-2">
          <div class="flex flex-col gap-2 rounded-xl border border-line bg-[#fcfcfd] px-4 py-3">
            <span class="text-meta text-ink-2">{s.name.label}</span>
            <span class="text-body flex min-h-10 items-center justify-between gap-2 rounded-[10px] border border-field bg-white px-3">
              <span class="typed" lang="ar" dir="rtl">
                <span class="typed-text">{s.name.name}</span>
                <span class="caret" aria-hidden="true"></span>
              </span>
              <span class:list={[okChip, 'typed-ok']}>{t.forms.nameAccepted}</span>
            </span>
          </div>
          <div class="flex flex-col gap-2 rounded-xl border border-line bg-[#fcfcfd] px-4 py-3">
            <span class="text-meta text-ink-2">{t.forms.phone}</span>
            <span class="text-body flex min-h-10 items-center justify-between gap-2 rounded-[10px] border border-field bg-white px-3">
              <samp dir="ltr" class="font-sans">
                {ARABIC_DIGITS}
              </samp>
              <span class={badChip}>{t.forms.digitsRejected}</span>
            </span>
          </div>
        </div>
      </BentoTile>

      <BentoTile
        lang={lang}
        title={t.whatsapp.title}
        href={links.whatsapp.href}
        tool={links.whatsapp.title}
        category={links.whatsapp.category}
        example={t.example}
      >
        <div class="mt-auto flex flex-col items-stretch gap-2">
          <span
            dir="ltr"
            class="text-small rounded-xl bg-surface-2 px-3 py-3 font-mono text-ink-2 line-through"
          >
            wa.me/0501234567
          </span>
          <ArrowDown
            size={20}
            stroke-width={1.8}
            aria-hidden="true"
            class="nudge self-center text-ink-3"
          />
          <span dir="ltr" class="text-small rounded-xl bg-pass-soft px-3 py-3 font-mono text-pass">
            wa.me/966501234567
          </span>
        </div>
      </BentoTile>

      <BentoTile
        lang={lang}
        title={t.ai.title}
        href={links.ai.href}
        tool={links.ai.title}
        category={links.ai.category}
        example={t.example}
      >
        <ul class="m-0 mt-auto flex list-none flex-col gap-2 p-0">
          {AI.map((bot) => (
            <li class={row}>
              <span lang="en" dir="ltr">
                {bot.name}
              </span>
              <span class={bot.allowed ? okChip : badChip}>
                {bot.allowed ? t.ai.allowed : t.ai.blocked}
              </span>
            </li>
          ))}
        </ul>
      </BentoTile>

      <BentoTile
        lang={lang}
        title={t.speed.title}
        href={links.speed.href}
        tool={links.speed.title}
        category={links.speed.category}
        example={t.example}
        class="md:col-span-2"
      >
        <p class="text-small m-0 text-ink-2">
          <Bidi text={t.speed.text} lang={lang} />
        </p>
        <div class="mt-auto grid grid-cols-3 gap-3">
          {gauges.map((item) => (
            <div class="flex flex-col items-center gap-1 rounded-xl bg-surface-2 px-2 pt-3 pb-3">
              <svg viewBox="0 0 120 70" aria-hidden="true" class="block h-[70px] w-[120px]">
                <path
                  d="M10 62 A50 50 0 0 1 110 62"
                  fill="none"
                  stroke="#e3e8ef"
                  stroke-width="10"
                  stroke-linecap="round"
                />
                <path
                  class="gauge-val"
                  d="M10 62 A50 50 0 0 1 110 62"
                  fill="none"
                  stroke={GAUGE_COLOUR[item.tone]}
                  stroke-width="10"
                  stroke-linecap="round"
                  pathLength="100"
                  stroke-dasharray={`${item.fill} 100`}
                />
              </svg>
              <b class="text-[1.25rem] font-semibold tabular-nums">
                {item.value} {item.unit}
              </b>
              <span lang="en" dir="ltr" class="text-meta text-ink-2">
                {item.vital.toUpperCase()}
              </span>
            </div>
          ))}
        </div>
      </BentoTile>

      <BentoTile
        lang={lang}
        title={t.trust.title}
        href={links.trust.href}
        tool={links.trust.title}
        category={links.trust.category}
        example={t.example}
      >
        <ul class="m-0 mt-auto flex list-none flex-col gap-2 p-0">
          {TRUST.map((check) => (
            <li class={row}>
              <span lang="en" dir="ltr">
                {check.name}
              </span>
              <span class={check.ok ? okChip : badChip}>
                {check.ok ? t.trust.ok : t.trust.missing}
              </span>
            </li>
          ))}
        </ul>
      </BentoTile>

      <BentoTile
        lang={lang}
        title={t.robots.title}
        href={links.robots.href}
        tool={links.robots.title}
        category={links.robots.category}
        example={t.example}
      >
        <div class="mt-auto flex flex-col gap-3">
          <pre
            dir="ltr"
            class="m-0 overflow-x-auto rounded-xl bg-ink px-4 py-4 font-mono text-[13px] leading-[1.8] text-panel-soft"
          ><code>User-agent: Googlebot
<span class="hl">Disallow: /</span></code></pre>
          <span class:list={[badChip, 'self-start']}>
            <Bidi text={t.robots.blocks} lang={lang} />
          </span>
        </div>
      </BentoTile>
    </div>
  </div>
</section>

<style>
  /* The browser's placeholder until the section is laid out: its measured height on a phone, a
     tablet and a desktop (the real height is remembered once it has been drawn). */
  .strip {
    contain-intrinsic-size: auto 1000px;
  }
  @media (min-width: 48rem) {
    .strip {
      contain-intrinsic-size: auto 1860px;
    }
  }
  @media (min-width: 80rem) {
    .strip {
      contain-intrinsic-size: auto 1120px;
    }
  }
  /* The gap between the letters of the heading in WebKit's row: it opens and closes. */
  .gap {
    display: inline-block;
    width: 0;
    animation: home-gap 4.5s ease-in-out infinite;
  }
  .nudge {
    animation: home-nudge 1.8s ease-in-out infinite;
  }
  .gauge-val {
    animation: home-gauge 1.4s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  /* The name typed into the field: the text is all there, and a clip reveals it from the start of
     the line, a step for each letter; the caret rides the edge, and «accepted» shows when it is
     done. One cycle, 4.5 s: typing, a pause, then it is wiped for the next. */
  .typed {
    position: relative;
    display: inline-block;
  }
  .typed-text {
    display: inline-block;
    animation: home-reveal 4.5s steps(11, end) infinite;
  }
  .caret {
    position: absolute;
    inset-block: 2px;
    inset-inline-start: calc(100% - 2px);
    width: 2px;
    background: var(--color-indigo, #4f46e5);
    animation:
      home-caret-move 4.5s steps(11, end) infinite,
      home-blink 1s step-end infinite;
  }
  .typed-ok {
    animation: home-accept 4.5s ease-out infinite;
  }

  @keyframes home-gap {
    0%,
    18% {
      width: 0;
    }
    38%,
    78% {
      width: 0.22em;
    }
    96%,
    100% {
      width: 0;
    }
  }
  @keyframes home-nudge {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(4px);
    }
  }
  @keyframes home-gauge {
    from {
      stroke-dasharray: 0 100;
    }
  }
  @keyframes home-reveal {
    0% {
      clip-path: inset(0 0 0 100%);
    }
    36%,
    94% {
      clip-path: inset(0 0 0 0);
    }
    100% {
      clip-path: inset(0 0 0 100%);
    }
  }
  @keyframes home-caret-move {
    0% {
      inset-inline-start: 0;
    }
    36%,
    94% {
      inset-inline-start: calc(100% - 2px);
    }
    100% {
      inset-inline-start: 0;
    }
  }
  @keyframes home-blink {
    50% {
      opacity: 0;
    }
  }
  @keyframes home-accept {
    0%,
    37% {
      opacity: 0;
      transform: scale(0.9);
    }
    42%,
    93% {
      opacity: 1;
      transform: none;
    }
    100% {
      opacity: 0;
      transform: scale(0.9);
    }
  }
  .hl {
    display: inline-block;
    padding-inline: 6px;
    border-radius: 4px;
    background: rgb(244 63 94 / 0.25);
    color: #fda4af;
  }

  @media (prefers-reduced-motion: reduce) {
    .gap,
    .nudge,
    .gauge-val,
    .typed-text,
    .typed-ok {
      animation: none;
    }
    /* A caret that does not blink and rides no edge says nothing, and it sits on the end of the
       name: the text is all there. */
    .caret {
      display: none;
    }
    /* The heading stays drawn apart: it is what the tile is about. */
    .gap {
      width: 0.22em;
    }
  }
</style>
