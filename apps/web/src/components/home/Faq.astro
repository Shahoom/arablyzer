---
import { HOME } from '@arablyzer/i18n'
import type { Lang } from '@arablyzer/seo/site'
import Plus from '@lucide/astro/icons/plus'
import Bidi from '../Bidi.astro'
import SectionIntro from './SectionIntro.astro'

/**
 * The questions, each an accordion (<details>), as the home page has always had them; the answers
 * are in the HTML whether a question is open or not. Each is a card (M2.6 R7) whose summary is the
 * whole of its first row: 56 px on a phone, so that a thumb finds it. The focus ring is the card's
 * (its own radius, drawn outside it: a card that clips its content would cut the ring off).
 */
interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = HOME[lang].faq
---

<section aria-labelledby="faq-title" class="below-fold strip">
  <div class="wrap">
    <SectionIntro kicker={t.kicker} id="faq-title" title={t.title} />
    <div class="mx-auto flex max-w-[800px] flex-col gap-2.5 md:gap-3">
      {t.items.map((item) => (
        <details class="group card has-[summary:focus-visible]:outline-2 has-[summary:focus-visible]:outline-offset-3 has-[summary:focus-visible]:outline-indigo">
          <summary class="text-body flex min-h-14 cursor-pointer list-none items-center justify-between gap-3 px-4 py-2 font-semibold focus-visible:outline-none md:min-h-16 md:px-5">
            <span>
              <Bidi text={item.question} lang={lang} />
            </span>
            <span
              aria-hidden="true"
              class="grid size-8 shrink-0 place-items-center rounded-[10px] bg-surface-2 text-ink-2 transition-[transform,background-color] duration-200 group-open:rotate-45 group-open:bg-indigo-soft group-open:text-indigo-ink"
            >
              <Plus size={16} stroke-width={1.8} />
            </span>
          </summary>
          <p class="text-body m-0 max-w-[70ch] px-4 pb-4 text-ink-2 md:px-5 md:pb-5">
            <Bidi text={item.answer} lang={lang} />
          </p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  /* The browser's placeholder until the section is laid out: its measured height on a phone, a
     tablet and a desktop (the real height is remembered once it has been drawn). */
  .strip {
    contain-intrinsic-size: auto 356px;
  }
  @media (min-width: 48rem) {
    .strip {
      contain-intrinsic-size: auto 402px;
    }
  }
</style>
