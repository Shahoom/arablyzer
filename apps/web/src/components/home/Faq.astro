---
import { HOME } from '@arablyzer/i18n'
import type { Lang } from '@arablyzer/seo/site'
import ChevronDown from '@lucide/astro/icons/chevron-down'
import { PUBLIC_AUTH_GOOGLE_CLIENT_ID } from 'astro:env/client'
import Bidi from '../Bidi.astro'

/**
 * The questions, each an accordion (<details>), as the home page has always had them; the answers
 * are in the HTML whether a question is open or not. R8: from lg the heading stands at the start
 * of the line and the questions beside it, one list with a hairline between rows (not a card for
 * each), each summary the whole of its row, 56 px on a phone so that a thumb finds it. The focus
 * ring is drawn inside the row, since the list clips its rows.
 */
interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = HOME[lang].faq
// The account question is asked only on a site built with accounts.
const items = (PUBLIC_AUTH_GOOGLE_CLIENT_ID ?? '') === '' ? t.items : [...t.items, t.accounts]
---

<section aria-labelledby="faq-title" class="below-fold strip">
  <div class="wrap lg:grid lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] lg:gap-16">
    <h2 id="faq-title" class="heading-2 m-0 mb-5 max-w-[16ch] md:mb-8 lg:mb-0">
      {t.title}
    </h2>
    <div class="kb-list">
      {items.map((item, index) => (
        <details class:list={['group', index > 0 && 'border-t border-line']}>
          <summary class="text-body flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 px-card py-2 font-semibold hover:bg-bg focus-visible:outline-offset-[-3px] md:min-h-16">
            <span>
              <Bidi text={item.question} lang={lang} />
            </span>
            <ChevronDown
              size={18}
              stroke-width={2}
              aria-hidden="true"
              class="shrink-0 text-ink-3 transition-transform duration-200 group-open:rotate-180 group-open:text-brand-ink"
            />
          </summary>
          <p class="text-body m-0 max-w-[70ch] px-card pb-card text-ink-2">
            <Bidi text={item.answer} lang={lang} />
          </p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  /* The browser's placeholder until the section is laid out: its measured height on a phone, a
     tablet and a desktop (the real height is remembered once it has been drawn). */
  .strip {
    contain-intrinsic-size: auto 280px;
  }
  @media (min-width: 48rem) {
    .strip {
      contain-intrinsic-size: auto 322px;
    }
  }
  @media (min-width: 64rem) {
    .strip {
      contain-intrinsic-size: auto 262px;
    }
  }
</style>
