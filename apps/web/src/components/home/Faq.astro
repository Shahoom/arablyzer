---
import { HOME } from '@arablyzer/i18n'
import type { Lang } from '@arablyzer/seo/site'
import Plus from '@lucide/astro/icons/plus'
import Bidi from '../Bidi.astro'
import SectionIntro from './SectionIntro.astro'

/**
 * The questions, each an accordion (<details>), as the home page has always had them; the answers
 * are in the HTML whether a question is open or not.
 */
interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = HOME[lang].faq
---

<section aria-labelledby="faq-title" class="below-fold pt-6 pb-16 md:pb-[88px]">
  <div class="wrap">
    <SectionIntro kicker={t.kicker} id="faq-title" title={t.title} />
    <div class="mx-auto flex max-w-[860px] flex-col gap-3">
      {t.items.map((item) => (
        <details class="group rounded-[18px] border border-line bg-white shadow-[0_1px_2px_rgb(16_24_40/0.04)]">
          <summary class="flex min-h-[68px] cursor-pointer list-none items-center justify-between gap-4 px-5 py-3 text-base font-semibold md:px-[22px] md:text-[17px]">
            <span>
              <Bidi text={item.question} lang={lang} />
            </span>
            <span
              aria-hidden="true"
              class="grid size-8 shrink-0 place-items-center rounded-[10px] bg-surface-2 text-ink-2 transition-[transform,background-color] duration-200 group-open:rotate-45 group-open:bg-indigo-soft group-open:text-indigo-ink"
            >
              <Plus size={16} stroke-width={1.8} />
            </span>
          </summary>
          <p class="m-0 max-w-[70ch] px-5 pb-5 leading-[1.9] text-ink-2 md:px-[22px] md:pb-[22px]">
            <Bidi text={item.answer} lang={lang} />
          </p>
        </details>
      ))}
    </div>
  </div>
</section>
