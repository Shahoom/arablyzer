---
import type { Lang } from '@arablyzer/seo/site'
import ChevronLeft from '@lucide/astro/icons/chevron-left'
import ChevronRight from '@lucide/astro/icons/chevron-right'
import Bidi from '../Bidi.astro'

/**
 * One tile of the bento (R8): its category (a dot in the category's colour and, from md, its name:
 * the colour is the category's everywhere on the site, so the bento is the directory's legend
 * and not a set of icons on gradients), a heading that is the link to the tool's page (stretched
 * over the whole tile, so the tile is one link and nothing is nested), what the tile shows in the
 * slot, and `example` when the tile's data is made up, which it must say. Hovering lifts the
 * tile; the focus ring is drawn around the tile, not around its heading.
 *
 * On a phone (M2.6 R7) a tile is a row of the list: the dot, the heading and a chevron, 68 px
 * tall, and what it shows (an illustration made of example data) is for md and up. The tile that
 * is `featured` keeps its content on a phone too: it is the one that shows real data. The
 * «مثال» mark goes with the illustration it marks.
 */
interface Props {
  lang: Lang
  title: string
  href: string
  /** The tool's name, which a screen reader hears after the heading. */
  tool: string
  /** The tool's category: its name, and the class of its dot (the directory's colours). */
  category: { readonly name: string; readonly dot: string }
  /** The word that marks made-up data («مثال»); left out when the tile shows real data. */
  example?: string | undefined
  /** Whether a phone shows the tile's content under its heading. */
  featured?: boolean
  class?: string | undefined
}
const {
  lang,
  title,
  href,
  tool,
  category,
  example,
  featured = false,
  class: className,
} = Astro.props
const Chevron = lang === 'ar' ? ChevronLeft : ChevronRight
---

<article
  class:list={[
    'card card-lift relative grid grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-x-3 gap-y-3 overflow-hidden p-card has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-offset-3 has-[a:focus-visible]:outline-indigo md:flex md:flex-col md:items-stretch md:gap-3',
    className,
  ]}
>
  {example !== undefined && (
    <span class="absolute end-4 top-4 hidden h-[22px] items-center rounded-full border border-dashed border-field px-2 text-xs text-ink-2 md:inline-flex">
      {example}
    </span>
  )}
  <span class="flex items-center gap-2 text-meta text-ink-2 md:order-first">
    <i aria-hidden="true" class:list={['size-2 shrink-0 rounded-full', category.dot]}></i>
    <span class="hidden md:inline">{category.name}</span>
  </span>
  <h3 class="heading-3 m-0">
    <a
      href={href}
      class="text-ink after:absolute after:inset-0 hover:text-ink focus-visible:outline-none"
    >
      <Bidi text={title} lang={lang} />
      <span class="sr-only"> — {tool}</span>
    </a>
  </h3>
  <Chevron size={18} stroke-width={2} aria-hidden="true" class="text-ink-3 md:hidden" />
  <div
    class:list={[
      'min-w-0 flex-col gap-3 md:flex md:flex-1',
      featured ? 'col-span-3 flex' : 'hidden',
    ]}
  >
    <slot />
  </div>
</article>
