---
import { HOME, SCAN_FORM } from '@arablyzer/i18n'
import type { Lang } from '@arablyzer/seo/site'
import Crosshairs from '../Crosshairs.astro'
import ScanForm from '../../islands/ScanForm'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = HOME[lang].cta
---

<section
  aria-labelledby="cta-title"
  class="below-fold relative mx-5 mt-10 mb-10 grid items-center gap-6 bg-panel-grid p-6 text-white md:mx-16 md:mb-[88px] md:p-14 lg:grid-cols-12 lg:gap-x-12"
>
  <Crosshairs />
  <div class="flex flex-col gap-2.5 lg:col-span-5">
    <h2 id="cta-title" class="m-0 text-[26px] leading-[1.2] font-bold md:text-[44px]">
      {t.title}
    </h2>
    <p class="m-0 text-base text-panel-dim md:text-[17px]">{t.text}</p>
  </div>
  <div class="lg:col-span-7">
    <ScanForm client:visible lang={lang} inputId="cta-url" tone="panel" />
    <noscript>
      <p class="text-sm text-panel-signal">{SCAN_FORM[lang].noscript}</p>
    </noscript>
  </div>
</section>
