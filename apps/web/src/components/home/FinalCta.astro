---
import { HOME } from '@arablyzer/i18n'
import type { Lang } from '@arablyzer/seo/site'
import { scanFormHref } from '../../lib/site'

/**
 * The closing call to action: a band in the brand's gradient with a field of dots, and a button
 * that goes back up to the scan box (there is one form on the page, and it is that one). Its
 * heading is the scale's `heading-2` like every other section's (M2.6 R7), in white.
 */
interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = HOME[lang].cta
---

<section aria-labelledby="cta-title" class="wrap below-fold strip">
  <div class="final relative isolate flex flex-col items-center gap-3 overflow-hidden rounded-[24px] bg-[#00727c] bg-(image:--gradient-band) px-5 py-9 text-center text-white md:gap-4 md:rounded-[32px] md:px-8 md:py-14">
    <h2 id="cta-title" class="heading-2 m-0">
      {t.title}
    </h2>
    <p class="text-body m-0 text-white/90">{t.text}</p>
    <a href={scanFormHref(lang)} class="btn-light btn-lg mt-1">
      {t.button}
    </a>
  </div>
</section>

<style>
  /* The browser's placeholder until the section is laid out: its measured height on a phone, a
     tablet and a desktop (the real height is remembered once it has been drawn). */
  .strip {
    contain-intrinsic-size: auto 206px;
  }
  @media (min-width: 48rem) {
    .strip {
      contain-intrinsic-size: auto 256px;
    }
  }
  /* A field of dots behind the words, faded out toward the edges. */
  .final::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(rgb(255 255 255 / 0.18) 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: radial-gradient(ellipse 60% 70% at 50% 50%, #000, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 60% 70% at 50% 50%, #000, transparent 75%);
  }
</style>
