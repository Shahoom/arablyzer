---
import { HOME } from '@arablyzer/i18n'
import type { Lang } from '@arablyzer/seo/site'
import { scanFormHref } from '../../lib/site'

/**
 * The closing call to action: a band in the brand's gradient with a field of dots, and a button
 * that goes back up to the scan box (there is one form on the page, and it is that one).
 */
interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = HOME[lang].cta
---

<section aria-labelledby="cta-title" class="wrap below-fold pb-6">
  <div class="final relative isolate flex flex-col items-center gap-[18px] overflow-hidden rounded-[32px] bg-[#00727c] bg-(image:--gradient-band) px-6 py-16 text-center text-white md:py-[72px]">
    <h2 id="cta-title" class="m-0 text-[30px] leading-[1.3] font-semibold md:text-[44px]">
      {t.title}
    </h2>
    <p class="m-0 text-lg text-white/90">{t.text}</p>
    <a href={scanFormHref(lang)} class="btn-light btn-lg">
      {t.button}
    </a>
  </div>
</section>

<style>
  /* A field of dots behind the words, faded out toward the edges. */
  .final::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(rgb(255 255 255 / 0.18) 1px, transparent 1px);
    background-size: 22px 22px;
    mask-image: radial-gradient(ellipse 60% 70% at 50% 50%, #000, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 60% 70% at 50% 50%, #000, transparent 75%);
  }
</style>
