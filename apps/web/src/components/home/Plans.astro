---
import { HOME } from '@arablyzer/i18n'
import type { Lang } from '@arablyzer/seo/site'
import Check from '@lucide/astro/icons/check'
import { homeCounts } from '../../lib/home'
import { scanFormHref } from '../../lib/site'
import SectionIntro from './SectionIntro.astro'

/**
 * The plans (R8): the free one, which can be used today, as the card; the two paid ones, which are
 * announced and have no price, as two plain entries beside it on the ground, one under the other.
 * Three cards of the same size said they were three of the same thing; they are not. The free
 * plan has a solid brand edge (a gradient edge is the home box's ring, and the buttons'). Every
 * line is from the registries and the FAQ: monitoring many sites every day, crawling whole sites,
 * and no price anywhere, since the owner has not set one (M2.6 plan §4).
 */
interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = HOME[lang].plans
const counts = homeCounts()
const point = 'flex items-start gap-3'
const tick = 'mt-[5px] shrink-0 text-brand'
const later = [t.monitoring, t.crawl]
---

<section id="plans" aria-labelledby="plans-title" class="below-fold strip">
  <div class="wrap">
    <SectionIntro id="plans-title" title={t.title} lead={t.lead} phoneLead={false} />
    <div class="grid items-start gap-6 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)] lg:gap-12">
      <article class="card flex flex-col gap-3 border-2 border-brand p-card md:gap-4">
        <div class="flex items-center justify-between gap-2">
          <h3 class="heading-3 m-0">{t.free.name}</h3>
          <span class="sev sev-pass">{t.free.tag}</span>
        </div>
        <p class="text-body m-0 text-ink-2">{t.free.text}</p>
        <ul class="text-small m-0 flex list-none flex-col gap-2 p-0 text-ink-2">
          {[t.free.allTools(counts.tools), ...t.free.points].map((item) => (
            <li class={point}>
              <Check size={16} stroke-width={2} aria-hidden="true" class={tick} />
              {item}
            </li>
          ))}
        </ul>
        <a href={scanFormHref(lang)} class="btn-grad btn-lg mt-1 w-full">
          {t.free.cta}
        </a>
      </article>

      <div class="flex flex-col divide-y divide-line">
        {later.map((plan) => (
          <article class="flex flex-col gap-3 py-5 first:pt-0 last:pb-0 lg:first:pt-1">
            <div class="flex items-center justify-between gap-2">
              <h3 class="heading-3 m-0">{plan.name}</h3>
              <span class="sev bg-indigo-soft text-indigo-ink">{t.soon}</span>
            </div>
            <p class="text-body m-0 hidden text-ink-2 md:block">{plan.text}</p>
            <ul class="text-small m-0 flex list-none flex-col gap-2 p-0 text-ink-2">
              {[...plan.points, t.includesFree].map((item) => (
                <li class={point}>
                  <Check size={16} stroke-width={2} aria-hidden="true" class={tick} />
                  {item}
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
    <p class="text-small m-0 mt-6 text-ink-2 md:mt-8">{t.note}</p>
  </div>
</section>

<style>
  /* The browser's placeholder until the section is laid out: its measured height on a phone, a
     tablet and a desktop (the real height is remembered once it has been drawn). */
  .strip {
    contain-intrinsic-size: auto 735px;
  }
  @media (min-width: 48rem) {
    .strip {
      contain-intrinsic-size: auto 916px;
    }
  }
  @media (min-width: 64rem) {
    .strip {
      contain-intrinsic-size: auto 481px;
    }
  }
</style>
