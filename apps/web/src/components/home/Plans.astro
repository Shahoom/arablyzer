---
import { HOME } from '@arablyzer/i18n'
import type { Lang } from '@arablyzer/seo/site'
import Check from '@lucide/astro/icons/check'
import { homeCounts } from '../../lib/home'
import { scanFormHref } from '../../lib/site'
import SectionIntro from './SectionIntro.astro'

/**
 * The plans: the free one, with what is true today, and the paid ones, marked «قريباً» with what
 * the FAQ already says they are for (monitoring many sites every day, crawling whole sites). There
 * is no price anywhere: the owner has not set one (M2.6 plan §4). The free plan is the one with the
 * gradient edge, because it is the one that can be used.
 */
interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = HOME[lang].plans
const counts = homeCounts()
const card = 'flex flex-col gap-[18px] rounded-2xl border border-line bg-white p-7 shadow'
---

<section id="plans" aria-labelledby="plans-title" class="below-fold pt-6 pb-16 md:pb-[88px]">
  <div class="wrap">
    <SectionIntro kicker={t.kicker} id="plans-title" title={t.title} lead={t.lead} />
    <div class="grid items-stretch gap-4 lg:grid-cols-3">
      <article class:list={[card, 'free']}>
        <div class="flex items-center justify-between gap-2">
          <h3 class="m-0 text-lg font-semibold">{t.free.name}</h3>
          <span class="sev sev-pass">{t.free.tag}</span>
        </div>
        <p class="m-0 text-base leading-[1.7] text-ink-2">{t.free.text}</p>
        <ul class="m-0 flex list-none flex-col gap-2.5 p-0 text-[15px] text-ink-2">
          {[t.free.allTools(counts.tools), ...t.free.points].map((point) => (
            <li class="flex items-start gap-2.5">
              <Check
                size={16}
                stroke-width={2}
                aria-hidden="true"
                class="mt-1 shrink-0 text-brand"
              />
              {point}
            </li>
          ))}
        </ul>
        <a href={scanFormHref(lang)} class="btn-grad btn-lg mt-auto w-full">
          {t.free.cta}
        </a>
      </article>

      <article class={card}>
        <div class="flex items-center justify-between gap-2">
          <h3 class="m-0 text-lg font-semibold">{t.monitoring.name}</h3>
          <span class="sev bg-indigo-soft text-indigo-ink">{t.soon}</span>
        </div>
        <p class="m-0 text-base leading-[1.7] text-ink-2">{t.monitoring.text}</p>
        <ul class="m-0 flex list-none flex-col gap-2.5 p-0 text-[15px] text-ink-2">
          {[...t.monitoring.points, t.includesFree].map((point) => (
            <li class="flex items-start gap-2.5">
              <Check
                size={16}
                stroke-width={2}
                aria-hidden="true"
                class="mt-1 shrink-0 text-brand"
              />
              {point}
            </li>
          ))}
        </ul>
        <p class="m-0 mt-auto rounded-[14px] border border-dashed border-line-2 py-3 text-center text-[15px] font-semibold text-ink-2">
          {t.soon}
        </p>
      </article>

      <article class={card}>
        <div class="flex items-center justify-between gap-2">
          <h3 class="m-0 text-lg font-semibold">{t.crawl.name}</h3>
          <span class="sev bg-indigo-soft text-indigo-ink">{t.soon}</span>
        </div>
        <p class="m-0 text-base leading-[1.7] text-ink-2">{t.crawl.text}</p>
        <ul class="m-0 flex list-none flex-col gap-2.5 p-0 text-[15px] text-ink-2">
          {[...t.crawl.points, t.includesFree].map((point) => (
            <li class="flex items-start gap-2.5">
              <Check
                size={16}
                stroke-width={2}
                aria-hidden="true"
                class="mt-1 shrink-0 text-brand"
              />
              {point}
            </li>
          ))}
        </ul>
        <p class="m-0 mt-auto rounded-[14px] border border-dashed border-line-2 py-3 text-center text-[15px] font-semibold text-ink-2">
          {t.soon}
        </p>
      </article>
    </div>
    <p class="m-0 mt-5 text-center text-sm text-ink-2">{t.note}</p>
  </div>
</section>

<style>
  /* The free plan's edge: a gradient border drawn with two backgrounds, a white padding box over
     the gradient's border box. */
  .free {
    border: 2px solid transparent;
    background:
      linear-gradient(#fff, #fff) padding-box,
      linear-gradient(135deg, #007d88, #6366f1, #a855f7) border-box;
    box-shadow: 0 30px 60px -30px rgb(79 70 229 / 0.5);
  }
</style>
