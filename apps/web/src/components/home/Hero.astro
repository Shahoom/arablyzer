---
import { HOME, SCAN_FORM } from '@arablyzer/i18n'
import { localePath, PATHS, type Lang } from '@arablyzer/seo/site'
import Check from '@lucide/astro/icons/check'
import ChevronLeft from '@lucide/astro/icons/chevron-left'
import ChevronRight from '@lucide/astro/icons/chevron-right'
import Sparkles from '@lucide/astro/icons/sparkles'
import ScanForm from '../../islands/ScanForm'
import { HERO_TOOL_SLUGS, homeCounts } from '../../lib/home'
import { CATEGORY_STYLE, toolData } from '../../lib/tool-data'
import Aurora from '../Aurora.astro'
import Showcase from './Showcase.astro'

/**
 * The first screen (M2.6 R2): the aurora, a pill with the tool count, the heading with its gradient
 * phrase, the lead, the scan box (the ScanForm island inside the turning ring), the tools that
 * link to their pages, the trust line, and under them the product shot. The aurora fills the
 * section and the section clips it, so the page never scrolls sideways for the blobs.
 */
interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = HOME[lang].hero
const counts = homeCounts()
const Chevron = lang === 'ar' ? ChevronLeft : ChevronRight
const chips = HERO_TOOL_SLUGS.map((slug) => ({
  slug,
  href: localePath(lang, PATHS.tool(slug)),
  label: t.tools.names[slug],
  dot: CATEGORY_STYLE[toolData(slug).category].dot,
}))
---

<section aria-labelledby="home-title" class="relative overflow-hidden pt-12 pb-6 md:pt-16">
  <Aurora />
  <div class="wrap relative z-10 flex flex-col items-center gap-5 text-center md:gap-[22px]">
    <a
      href={localePath(lang, PATHS.tools)}
      class="inline-flex h-[38px] items-center gap-2.5 rounded-full border border-white/95 bg-white/70 ps-1.5 pe-3.5 text-sm text-ink-2 shadow backdrop-blur-[8px] hover:text-ink"
    >
      <b class="inline-flex h-[26px] items-center gap-1.5 rounded-full bg-[#00727c] bg-(image:--gradient-btn) px-2.5 text-xs font-semibold text-white">
        <Sparkles size={14} stroke-width={2} aria-hidden="true" />
        {t.pill.count(counts.tools)}
      </b>
      {t.pill.text}
    </a>
    <h1
      id="home-title"
      class:list={[
        'm-0 max-w-[1000px] leading-[1.22] font-semibold text-balance',
        lang === 'ar'
          ? 'text-[40px] md:text-[56px] lg:text-[68px]'
          : 'text-[34px] md:text-[46px] lg:text-[58px]',
      ]}
    >
      {t.title} <span class="gradient-text">{t.titleMark}</span>
    </h1>
    <p class="m-0 max-w-[740px] text-[17px] leading-[1.85] text-ink-2 md:text-[19px]">{t.lead}</p>

    <div id="scan" class="relative mt-2 w-full max-w-[800px]">
      <div aria-hidden="true" class="scan-glow"></div>
      <div class="scan-ring">
        <div class="rounded-[24px] bg-white p-4 pb-3.5 text-start">
          {/* When the browser is idle, or after half a second at most, as the tool pages' form. */}
          <ScanForm
            client:idle={{ timeout: 500 }}
            lang={lang}
            inputId="home-url"
            scope={{ label: t.scope.label, detail: t.scope.rules(counts.rules) }}
            enginesLabel={t.engines}
          />
          <noscript>
            <p class="mt-2 mb-0 text-sm text-serious">{SCAN_FORM[lang].noscript}</p>
          </noscript>
        </div>
      </div>
    </div>

    <ul
      aria-label={t.tools.label}
      class="m-0 flex max-w-[820px] list-none flex-wrap justify-center gap-2.5 p-0"
    >
      {chips.map((chip) => (
        <li>
          <a href={chip.href} class="chip">
            <span aria-hidden="true" class:list={['size-2 rounded-full', chip.dot]} />
            {chip.label}
          </a>
        </li>
      ))}
      <li>
        <a href={localePath(lang, PATHS.tools)} class="chip">
          {t.tools.all}
          <Chevron size={16} stroke-width={2} aria-hidden="true" />
        </a>
      </li>
    </ul>

    <ul class="m-0 flex list-none flex-wrap justify-center gap-x-[22px] gap-y-2.5 p-0 text-sm text-ink-2">
      {t.promises.map((promise) => (
        <li class="inline-flex items-center gap-1.5">
          <Check size={16} stroke-width={2.2} aria-hidden="true" class="shrink-0 text-brand" />
          {promise}
        </li>
      ))}
    </ul>

    <Showcase lang={lang} />
  </div>
</section>
