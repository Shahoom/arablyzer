---
import { HOME, SCAN_FORM } from '@arablyzer/i18n'
import { localePath, PATHS, type Lang } from '@arablyzer/seo/site'
import Check from '@lucide/astro/icons/check'
import ChevronLeft from '@lucide/astro/icons/chevron-left'
import ChevronRight from '@lucide/astro/icons/chevron-right'
import Sparkles from '@lucide/astro/icons/sparkles'
import ScanForm from '../../islands/ScanForm'
import { HERO_TOOL_SLUGS, homeCounts } from '../../lib/home'
import { CATEGORY_STYLE, toolData } from '../../lib/tool-data'
import Aurora from '../Aurora.astro'
import Showcase from './Showcase.astro'

/**
 * The first screen (M2.6 R2, scaled by R7): the aurora, a compact badge with the tool count, the
 * heading with its one gradient phrase (32 px on a phone, 44 on a tablet, 60 on a desktop), a lead
 * of one or two lines, the scan box (the ScanForm island inside the turning ring: the only place
 * the ring and its glow live), the tools that link to their pages (one row that scrolls sideways
 * on a phone), the trust line, and under them the product shot. The aurora fills the section and
 * the section clips it, so the page never scrolls sideways for the blobs.
 */
interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = HOME[lang].hero
const counts = homeCounts()
const Chevron = lang === 'ar' ? ChevronLeft : ChevronRight
const chips = HERO_TOOL_SLUGS.map((slug) => ({
  slug,
  href: localePath(lang, PATHS.tool(slug)),
  label: t.tools.names[slug],
  dot: CATEGORY_STYLE[toolData(slug).category].dot,
}))
---

<section
  aria-labelledby="home-title"
  class="relative overflow-hidden pt-5 pb-5 md:pt-10 md:pb-8 lg:pt-14"
>
  <div class="aurora-fade absolute inset-0 opacity-70 md:opacity-100">
    <Aurora />
  </div>
  <div class="wrap relative z-10 flex flex-col items-center gap-4 text-center md:gap-5">
    <a
      href={localePath(lang, PATHS.tools)}
      class="relative inline-flex h-8 items-center gap-2 rounded-full border border-white/95 bg-white/70 ps-1 pe-3 text-meta text-ink-2 shadow backdrop-blur-[8px] after:absolute after:inset-x-0 after:-inset-y-2 hover:text-ink md:h-[34px]"
    >
      <b class="inline-flex h-6 items-center gap-1.5 rounded-full bg-[#00727c] bg-(image:--gradient-btn) px-2.5 text-meta font-semibold text-white md:h-[26px]">
        <Sparkles size={14} stroke-width={2} aria-hidden="true" />
        {t.pill.count(counts.tools)}
      </b>
      {t.pill.text}
    </a>
    <h1
      id="home-title"
      class:list={[
        'm-0 max-w-[1000px] text-[2rem] font-semibold text-balance md:text-[2.75rem] lg:text-[3.75rem]',
        lang === 'ar'
          ? 'leading-[1.3] md:leading-[1.25] lg:leading-[1.2]'
          : 'leading-[1.2] md:leading-[1.15] lg:leading-[1.1]',
      ]}
    >
      {t.title} <span class="gradient-text">{t.titleMark}</span>
    </h1>
    <p class="text-body m-0 max-w-[720px] text-ink lg:text-[1.125rem]">{t.lead}</p>

    <div id="scan" class="relative mt-1 w-full max-w-[800px] md:mt-2">
      <div aria-hidden="true" class="scan-glow"></div>
      <div class="scan-ring">
        <div class="rounded-[24px] bg-white p-3.5 pb-3 text-start md:p-4 md:pb-3.5">
          {/* When the browser is idle, or after half a second at most, as the tool pages' form. */}
          <ScanForm
            client:idle={{ timeout: 500 }}
            lang={lang}
            inputId="home-url"
            scope={{ label: t.scope.label, detail: t.scope.rules(counts.rules) }}
            enginesLabel={t.engines}
          />
          <noscript>
            <p class="mt-2 mb-0 text-sm text-serious">{SCAN_FORM[lang].noscript}</p>
          </noscript>
        </div>
      </div>
    </div>

    <ul
      aria-label={t.tools.label}
      class="scroll-row self-stretch md:grid md:w-full md:max-w-[720px] md:grid-cols-3 md:self-center lg:max-w-[900px] xl:flex xl:max-w-[1100px] xl:justify-center"
    >
      {chips.map((chip) => (
        <li>
          <a href={chip.href} class="chip md:w-full md:justify-center xl:w-auto">
            <span aria-hidden="true" class:list={['size-2 rounded-full', chip.dot]} />
            {chip.label}
          </a>
        </li>
      ))}
      <li>
        <a href={localePath(lang, PATHS.tools)} class="chip md:w-full md:justify-center xl:w-auto">
          {t.tools.all}
          <Chevron size={16} stroke-width={2} aria-hidden="true" />
        </a>
      </li>
    </ul>

    <ul class="m-0 flex list-none flex-wrap justify-center gap-x-5 gap-y-1 p-0 text-meta text-ink-2 md:text-small">
      {t.promises.map((promise) => (
        <li class="inline-flex items-center gap-1.5">
          <Check size={16} stroke-width={2.2} aria-hidden="true" class="shrink-0 text-brand" />
          {promise}
        </li>
      ))}
    </ul>

    <Showcase lang={lang} />
  </div>
</section>

<style>
  /* The aurora fades out over the last 140 px of the section, so that its clipped foot is not a
     line across the page under the product shot. */
  .aurora-fade {
    mask-image: linear-gradient(to bottom, #000 calc(100% - 140px), transparent);
    -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - 140px), transparent);
  }
</style>
