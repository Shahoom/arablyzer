---
import { TOOLS_UI } from '@arablyzer/i18n'
import { localePath, PATHS, type Lang } from '@arablyzer/seo/site'
import ArrowLeft from '@lucide/astro/icons/arrow-left'
import ArrowRight from '@lucide/astro/icons/arrow-right'
import { CATEGORY_STYLE, TOOLS_DATA } from '../../lib/tool-data'
import SectionHead from '../SectionHead.astro'

interface Props {
  lang: Lang
  number: number
}
const { lang, number } = Astro.props
const t = TOOLS_UI[lang]
/** The tools the design puts first, those of Arablyzer's own Arabic layer; then the others. */
const FIRST = ['rtl-check', 'arabic-font-check', 'whatsapp-link-check', 'price-format-check']
const featured = [
  ...FIRST.flatMap((slug) => TOOLS_DATA.tools.filter((tool) => tool.slug === slug)),
  ...TOOLS_DATA.tools.filter((tool) => !FIRST.includes(tool.slug)),
].slice(0, 6)
const Forward = lang === 'ar' ? ArrowLeft : ArrowRight
---

<section
  aria-labelledby="tools-title"
  class="below-fold flex flex-col gap-8 px-5 py-10 md:gap-10 md:px-16 md:py-[88px]"
>
  <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
    <SectionHead number={number} label={t.home.kicker} id="tools-title" title={t.home.title} />
    <a
      href={localePath(lang, PATHS.tools)}
      class="flex shrink-0 items-center gap-2 self-start text-base font-semibold underline-offset-4 hover:text-brand-ink hover:underline md:self-auto"
    >
      {t.home.all}
      <Forward size={18} stroke-width={2} aria-hidden="true" />
    </a>
  </div>
  <ul class="m-0 grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3">
    {featured.map((tool) => (
      <li>
        <a
          href={localePath(lang, PATHS.tool(tool.slug))}
          class="group flex h-full flex-col gap-3 border border-rule-strong bg-white p-[22px] hover:border-ink hover:text-ink"
        >
          <span class="flex items-center gap-2.5">
            <span
              aria-hidden="true"
              class:list={['size-2 shrink-0', CATEGORY_STYLE[tool.category].dot]}
            />
            <code dir="ltr" class="font-mono text-[13px] text-ink-3">
              {tool.slug}
            </code>
          </span>
          <span class="text-xl leading-snug font-semibold">{tool.copy[lang].title}</span>
          <span class="text-[15px] leading-[1.7] text-ink-2">{tool.copy[lang].summary}</span>
          <span class="mt-auto flex items-center justify-between gap-3 border-t border-rule-soft pt-3 text-sm">
            <span class="text-ink-3">{t.home.reads[tool.tag]}</span>
            <span class="flex items-center gap-1.5 font-semibold group-hover:text-brand-ink">
              {t.home.open}
              <Forward size={16} stroke-width={2} aria-hidden="true" />
            </span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>
