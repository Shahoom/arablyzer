---
import { HOME } from '@arablyzer/i18n'
import type { Lang } from '@arablyzer/seo/site'
import Bidi from '../Bidi.astro'
import SectionIntro from './SectionIntro.astro'

/**
 * Three numbered steps, which are a real sequence (an ordered list). A band of light runs along the
 * line that joins them in the way the text is read, from the start of the line to its end, with
 * the reading beam's keyframes (M2.6 R1); with reduced motion there is no band.
 */
interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = HOME[lang].how
---

<section aria-labelledby="how-title" class="below-fold pt-6 pb-16 md:pb-[88px]">
  <div class="wrap">
    <SectionIntro kicker={t.kicker} id="how-title" title={t.title} />
    <div class="relative">
      <div
        aria-hidden="true"
        class="track absolute top-[34px] inset-x-[16%] hidden h-0.5 overflow-hidden rounded-sm bg-line md:block"
      ></div>
      <ol class="m-0 grid list-none gap-10 p-0 md:grid-cols-3 md:gap-5" role="list">
        {t.steps.map((step, index) => (
          <li class="relative z-10 flex flex-col items-center gap-3 px-3 text-center">
            <span
              aria-hidden="true"
              class="grid size-[68px] place-items-center rounded-[22px] bg-[#00727c] bg-(image:--gradient-btn) text-[26px] font-semibold text-white shadow-[0_16px_30px_-14px_rgb(79_70_229/0.6)]"
            >
              {index + 1}
            </span>
            <h3 class="m-0 mt-1.5 text-xl font-semibold">{step.title}</h3>
            <p class="m-0 max-w-[34ch] text-[15px] leading-[1.8] text-ink-2">
              <Bidi text={step.text} lang={lang} />
            </p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .track::after {
    content: '';
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    width: 30%;
    background: linear-gradient(
      var(--grad-dir, to left),
      transparent,
      var(--color-indigo, #4f46e5),
      var(--color-brand, #007d88),
      transparent
    );
    animation: reading-beam 3.2s ease-in-out infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .track::after {
      animation: none;
      display: none;
    }
  }
</style>
