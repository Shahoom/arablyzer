---
import { HOME } from '@arablyzer/i18n'
import type { Lang } from '@arablyzer/seo/site'
import Check from '@lucide/astro/icons/check'
import X from '@lucide/astro/icons/x'
import Crosshairs from '../Crosshairs.astro'
import SeverityPill from '../SeverityPill.astro'
import { drawnWithLetterSpacing } from '../../lib/arabic'
import { ENGINE_NAMES, SHOWCASE } from '../../lib/showcase'
import ScoreScale from './ScoreScale.astro'

/** The instrument panel beside the heading: golden site 04 as the three engines drew it. */
interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = HOME[lang].figure
const s = SHOWCASE
const upper = (names: readonly string[]) => names.map((name) => name.toUpperCase()).join(' · ')
const joinedBy = upper(s.engines.filter((run) => run.joined).map((run) => run.name))
const drawnBy = upper(s.spacing.drawnBy.map((engine) => ENGINE_NAMES[engine]))
const overflowSeverity = s.overflow.finding.severity
---

<figure aria-label={t.label} class="panel-dark relative m-0 flex flex-col text-panel-text">
  <Crosshairs />
  <div
    aria-hidden="true"
    class="absolute -start-12 -top-[78px] z-10 hidden w-[236px] -rotate-2 flex-col gap-2 border-[1.5px] border-ink bg-white px-4 py-3.5 text-ink shadow-[-6px_6px_0_rgb(20_23_28/0.12),0_18px_30px_rgb(20_23_28/0.12)] xl:flex"
  >
    <span class="flex items-center gap-2">
      <span dir="ltr" class="font-mono text-[11px] text-ink-3">
        F-01
      </span>
      <SeverityPill severity={overflowSeverity} lang={lang} />
    </span>
    <span class="text-[15px] leading-normal font-semibold">{s.overflow.title[lang]}</span>
    <span class="flex items-center gap-1.5">
      <svg width="46" height="10" viewBox="0 0 46 10" fill="none">
        <path d="M1 5h44M1 1v8M45 1v8" class="stroke-measure" stroke-width="1.2"></path>
      </svg>
      <span dir="ltr" class="font-mono text-xs text-measure">
        {s.overflow.overflow}px
      </span>
    </span>
  </div>
  <div class="flex flex-wrap items-center justify-between gap-2 border-b border-panel-line px-4 py-3 text-[11px] text-panel-dim md:px-5 md:text-xs">
    <span class="flex items-center gap-2">
      <span aria-hidden="true" class="size-2 bg-panel-signal"></span>
      {t.source}
    </span>
    <span dir="ltr" class="font-mono">
      {s.page} · {s.heading.selector}
    </span>
  </div>
  <div class="flex flex-col gap-1.5 px-4 pt-5 pb-4 md:px-5 md:pt-[26px] md:pb-[22px]">
    <div class="flex items-center justify-between gap-4 border-b border-dashed border-panel-line pb-3 md:pb-4">
      <span
        lang="ar"
        class="text-[32px] leading-[1.3] font-semibold text-white md:text-[44px] xl:text-[54px]"
      >
        {s.heading.text}
      </span>
      <span dir="ltr" class="font-mono text-[9px] tracking-[0.06em] text-panel-pass md:text-[11px]">
        {joinedBy}
      </span>
    </div>
    <div class="flex items-center justify-between gap-4 pt-2 md:pt-2.5">
      <span
        lang="ar"
        aria-hidden="true"
        class="text-[32px] leading-[1.3] font-semibold text-panel-signal md:text-[44px] xl:text-[54px]"
      >
        {drawnWithLetterSpacing(s.heading.text)}
      </span>
      <span class="flex flex-col items-end gap-1.5">
        <span
          dir="ltr"
          class="font-mono text-[9px] tracking-[0.06em] text-panel-signal md:text-[11px]"
        >
          {drawnBy}
        </span>
        <span class="flex items-center gap-1.5">
          <svg width="34" height="12" viewBox="0 0 34 12" fill="none" aria-hidden="true">
            <path d="M1 6h32M1 1v10M33 1v10" class="stroke-panel-measure" stroke-width="1.2"></path>
          </svg>
          <span dir="ltr" class="font-mono text-[10px] text-panel-measure md:text-xs">
            {s.spacing.px}px
          </span>
        </span>
      </span>
    </div>
  </div>
  <ul class="grid grid-cols-3 border-t border-panel-line">
    {s.engines.map((run) => (
      <li class="flex flex-col gap-1.5 border-e border-panel-line px-3 py-3 last:border-e-0 md:px-5 md:py-3.5">
        <span
          dir="ltr"
          class="self-start font-mono text-[10px] tracking-[0.06em] text-panel-dim md:text-[11px]"
        >
          {run.name.toUpperCase()} {run.version}
        </span>
        <span
          class:list={[
            'flex items-center gap-1.5 text-xs md:text-sm',
            run.joined ? 'text-panel-pass' : 'text-panel-signal',
          ]}
        >
          {run.joined ? (
            <Check size={14} stroke-width={2.6} aria-hidden="true" class="shrink-0" />
          ) : (
            <X size={14} stroke-width={2.6} aria-hidden="true" class="shrink-0" />
          )}
          {run.joined ? t.joined : t.broken}
        </span>
      </li>
    ))}
  </ul>
  <div class="grid grid-cols-[auto_minmax(0,1fr)] items-end gap-x-4 border-t border-panel-line p-4 md:gap-x-7 md:p-5">
    <div class="flex flex-col gap-1.5">
      <span class="text-xs text-panel-dim">{t.score}</span>
      <span dir="ltr" class="font-mono text-5xl leading-[0.85] text-white md:text-[64px]">
        {s.score}
        <span class="text-[13px] text-panel-dim md:text-base">/100</span>
      </span>
    </div>
    <div class="flex flex-col gap-2.5">
      <ScoreScale score={s.score} label={t.scale(s.score)} rtl={lang === 'ar'} />
      <span class="text-[11px] text-panel-dim md:text-[13px]">{t.tally(s.failed, s.passed)}</span>
    </div>
  </div>
</figure>
