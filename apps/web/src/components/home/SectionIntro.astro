---
/**
 * The head of a section of the home page, centred: a kicker pill, the heading, and a lead under
 * it when there is one. The heading is semibold, one of the two weights a page loads (M2.6 R1).
 */
interface Props {
  kicker: string
  id: string
  title: string
  lead?: string | undefined
}
const { kicker, id, title, lead } = Astro.props
---

<div class="mx-auto mb-10 flex max-w-[760px] flex-col items-center gap-3 text-center md:mb-12">
  <span class="kick">{kicker}</span>
  <h2 id={id} class="m-0 text-[30px] leading-[1.3] font-semibold text-balance md:text-[44px]">
    {title}
  </h2>
  {lead !== undefined && <p class="m-0 text-base leading-[1.85] text-ink-2 md:text-lg">{lead}</p>}
</div>
