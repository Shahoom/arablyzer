---
/** Registration marks at the corners of an instrument panel, drawn in ink on the paper. */
interface Props {
  corners?: readonly ('start-start' | 'start-end' | 'end-start' | 'end-end')[]
}
const { corners = ['start-start', 'start-end', 'end-start', 'end-end'] } = Astro.props
const position = {
  'start-start': '-top-[9px] -start-[9px]',
  'start-end': '-top-[9px] -end-[9px]',
  'end-start': '-bottom-[9px] -start-[9px]',
  'end-end': '-bottom-[9px] -end-[9px]',
} as const
---

{corners.map((corner) => (
  <svg
    aria-hidden="true"
    width="18"
    height="18"
    viewBox="0 0 18 18"
    class:list={['pointer-events-none absolute text-ink', position[corner]]}
  >
    <path d="M9 0v18M0 9h18" stroke="currentColor" stroke-width="1.2" />
  </svg>
))}
