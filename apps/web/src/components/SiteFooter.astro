---
import { USER_AGENT } from '@arablyzer/engine/identity'
import { SITE } from '@arablyzer/i18n'
import { RULESET_VERSION } from '@arablyzer/rules/version'
import { localePath, PATHS, type Lang } from '@arablyzer/seo/site'
import { CLOUDTOPIA, methodologyHref, NAV, otherLang, REPOSITORY, scanFormHref } from '../lib/site'
import { toolData } from '../lib/tool-data'
import Bidi from './Bidi.astro'
import Logo from './Logo.astro'

interface Props {
  lang: Lang
  path: string
  /** On a report page, the other language's link gets the report's ID (Page.astro). */
  keepId?: boolean
}
const { lang, path, keepId = false } = Astro.props
const t = SITE[lang]
const other = otherLang(lang)
// The bot's product token, as sites see it in their logs: "ArablyzerBot/1.0".
const bot = USER_AGENT.split(' ')[0]

// The tools the footer names, by slug and in the tool's own title. toolData throws for a slug
// that is gone, so a renamed tool breaks the build instead of leaving a dead link here.
const POPULAR = [
  'rtl-check',
  'arabic-shaping-check',
  'whatsapp-link-generator',
  'robots-check',
] as const
const popular = POPULAR.map((slug) => ({
  href: localePath(lang, PATHS.tool(slug)),
  label: toolData(slug).copy[lang].title,
}))

// The columns, from pages that exist: the tools index, the sections the header lists (NAV, less
// the tools), the glossary and the methodology, the bot's page, the code, and the other language.
const columns = [
  {
    id: 'footer-product',
    title: t.footer.product,
    links: [
      { href: scanFormHref(lang), label: t.footer.scan },
      { href: localePath(lang, PATHS.tools), label: t.nav.tools },
    ],
  },
  { id: 'footer-tools', title: t.footer.popularTools, links: popular },
  {
    id: 'footer-knowledge',
    title: t.footer.knowledge,
    links: [
      ...NAV.filter((item) => item.key !== 'tools').map((item) => ({
        href: localePath(lang, item.path),
        label: t.nav[item.key],
      })),
      { href: localePath(lang, PATHS.glossary), label: t.footer.glossary },
      { href: methodologyHref(lang), label: t.footer.methodology },
    ],
  },
  {
    id: 'footer-about',
    title: t.footer.aboutHeading,
    links: [
      { href: localePath(lang, PATHS.bot), label: t.footer.bot },
      { href: REPOSITORY, label: t.footer.github },
    ],
  },
]
const link = 'text-ink-2 underline-offset-4 hover:text-ink hover:underline'
---

<footer class="below-fold border-t border-line [contain-intrinsic-size:auto_520px]">
  <div class="wrap pt-12 pb-8 md:pt-16 md:pb-10">
    <div class="grid gap-10 lg:grid-cols-[1.4fr_4fr] lg:gap-8">
      <div class="flex flex-col gap-3.5">
        <a
          href={localePath(lang, PATHS.home)}
          aria-label={t.homeLink}
          class="inline-flex items-center gap-2.5 self-start text-ink hover:text-ink"
        >
          <Logo size={28} />
          <span lang="en" dir="ltr" class="text-lg font-bold">
            Arablyzer
          </span>
        </a>
        <p class="m-0 max-w-[34ch] text-sm leading-[1.8] text-ink-2">{t.footer.about}</p>
      </div>
      <nav aria-label={t.footer.navLabel} class="grid grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-4">
        {columns.map((column) => (
          <div class="flex min-w-0 flex-col gap-3.5">
            <h2 class="m-0 text-sm font-bold">
              <Bidi text={column.title} lang={lang} />
            </h2>
            <ul class="m-0 flex list-none flex-col gap-2.5 p-0 text-sm">
              {column.links.map((item) => (
                <li>
                  <a href={item.href} class={link}>
                    <Bidi text={item.label} lang={lang} />
                  </a>
                </li>
              ))}
              {column.id === 'footer-about' && (
                <li>
                  <a
                    href={localePath(other, path)}
                    data-keep-id={keepId ? '' : undefined}
                    lang={other}
                    hreflang={other}
                    class={link}
                  >
                    {t.otherLang.label}
                  </a>
                </li>
              )}
            </ul>
          </div>
        ))}
      </nav>
    </div>
    <div class="mt-10 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-t border-line pt-6 text-[13px] text-ink-3">
      <span>
        {t.footer.designed} {t.footer.reportsPrivate}
      </span>
      <span>
        {t.footer.license} · {t.footer.builtBy}{' '}
        <a href={CLOUDTOPIA} class="underline underline-offset-4 hover:text-ink">
          {t.footer.cloudtopia}
        </a>
      </span>
      <span dir="ltr" lang="en" class="font-mono text-xs">
        {bot} · rules {RULESET_VERSION}
      </span>
    </div>
  </div>
</footer>
