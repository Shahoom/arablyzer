---
import { VERSUS_SLUGS, VERSUS_UI } from '@arablyzer/i18n'
import { formatDate } from '@arablyzer/seo/dates'
import { breadcrumbList, itemList } from '@arablyzer/seo/json-ld'
import { localePath, pageUrl, PATHS, type Lang } from '@arablyzer/seo/site'
import { STRINGS } from '@arablyzer/seo/strings'
import Page from '../../layouts/Page.astro'
import { HEAD } from '../../lib/heads'
import { siteOf } from '../../lib/site'
import Bidi from '../Bidi.astro'
import PageHead from '../PageHead.astro'

// The comparisons' index (M6): one row for each tool Arablyzer is set beside, with the line that
// tool calls itself. The rows are the pages' own, so the index cannot drift from them.

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = VERSUS_UI[lang]
const site = siteOf(Astro.site)
const url = pageUrl(site, lang, PATHS.comparisons)
const jsonLd = [
  breadcrumbList([
    { name: STRINGS[lang].home, url: pageUrl(site, lang, PATHS.home) },
    { name: t.hub.title, url },
  ]),
  itemList(
    VERSUS_SLUGS.map((slug) => ({
      name: t.hub.row(t.pages[slug].name),
      url: pageUrl(site, lang, PATHS.versus(slug)),
    })),
  ),
]
---

<Page
  lang={lang}
  path={PATHS.comparisons}
  title={t.meta.title}
  description={t.meta.description}
  jsonLd={jsonLd}
>
  <PageHead
    lang={lang}
    breadcrumb={{ label: t.hub.breadcrumb, current: t.hub.title }}
    title={t.hub.title}
  >
    <Bidi slot="lead" text={t.hub.lead} lang={lang} />
  </PageHead>
  <div class:list={['wrap', HEAD.bodyTop, 'pb-section']}>
    <ul class="m-0 grid list-none gap-3 p-0 md:grid-cols-2 md:gap-card">
      {VERSUS_SLUGS.map((slug) => (
        <li class="flex">
          <a
            href={localePath(lang, PATHS.versus(slug))}
            class="card card-lift group flex w-full flex-col gap-3 p-card text-ink hover:text-ink"
          >
            <span class="flex items-baseline justify-between gap-3">
              <span class="heading-3 min-w-0 group-hover:text-brand-ink">
                <Bidi text={t.hub.row(t.pages[slug].name)} lang={lang} />
              </span>
              <span
                aria-hidden="true"
                class="chev-end text-ink-3 group-hover:text-brand-ink"
              ></span>
            </span>
            <span class="text-small text-ink-2">
              <Bidi text={t.pages[slug].tagline} lang={lang} />
            </span>
            <span class="meta-row mt-auto text-meta text-ink-2">
              <span>
                <Bidi text={t.page.checkedOn(t.pages[slug].name)} lang={lang} />
                <time datetime={t.pages[slug].checked}>
                  {formatDate(t.pages[slug].checked, lang)}
                </time>
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Page>
