---
/**
 * The mark: a rounded square in the brand's gradient, with three white lines aligned to the right
 * and each shorter than the one above it, like the lines of Arabic text. It is drawn the same in
 * a left-to-right page: a mark is not mirrored. The square is a box with a CSS gradient (`logo-mark`),
 * not an SVG with its own gradient, so two marks on a page share no element id.
 */
interface Props {
  size?: 24 | 28 | 32 | 40
  /** More classes for the box: a larger size from a breakpoint (`lg:size-8`), say. */
  class?: string
}
const { size = 32, class: className } = Astro.props
// Whole class names, for Tailwind to find.
const SIDE = { 24: 'size-6', 28: 'size-7', 32: 'size-8', 40: 'size-10' } as const
---

<span aria-hidden="true" class:list={['logo-mark text-white', SIDE[size], className]}>
  <svg viewBox="0 0 32 32" fill="none" class="block size-full">
    <path
      d="M24 10.5H8.5M24 16H12.5M24 21.5H16.5"
      stroke="currentColor"
      stroke-width="2.4"
      stroke-linecap="round"
    ></path>
  </svg>
</span>
