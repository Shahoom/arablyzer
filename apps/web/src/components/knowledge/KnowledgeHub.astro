---
import { GUIDES_UI, KNOWLEDGE_UI, RULES_UI, TOOLS_UI } from '@arablyzer/i18n'
import { breadcrumbList, itemList } from '@arablyzer/seo/json-ld'
import { localePath, pageUrl, PATHS, type Lang } from '@arablyzer/seo/site'
import { STRINGS } from '@arablyzer/seo/strings'
import BookOpen from '@lucide/astro/icons/book-open'
import LifeBuoy from '@lucide/astro/icons/life-buoy'
import ListChecks from '@lucide/astro/icons/list-checks'
import Wrench from '@lucide/astro/icons/wrench'
import KnowledgeSearch from '../../islands/KnowledgeSearch'
import Page from '../../layouts/Page.astro'
import { knowledgeIndex } from '../../lib/knowledge'
import { KNOWLEDGE_TYPES, TYPE_TILE } from '../../lib/knowledge-search'
import { siteOf } from '../../lib/site'
import Aurora from '../Aurora.astro'
import Bidi from '../Bidi.astro'
import Breadcrumb from '../Breadcrumb.astro'

// The knowledge hub (M2.6 R5): one search over the tools, the rules, the fix guides and the
// glossary. Every page is a link in the HTML (the island renders the groups at build time, and
// narrows them in the browser), and the tiles at the foot lead to the four directories.

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = KNOWLEDGE_UI[lang]
const site = siteOf(Astro.site)
const url = pageUrl(site, lang, PATHS.knowledge)
const { items, tones, totals } = knowledgeIndex(lang)
// Each kind's directory, and its name there: the trail of tiles and the page's item list.
const directories = {
  tool: localePath(lang, PATHS.tools),
  rule: localePath(lang, PATHS.rules),
  fix: localePath(lang, PATHS.fix),
  term: localePath(lang, PATHS.glossary),
}
const names = {
  tool: TOOLS_UI[lang].directory.title,
  rule: RULES_UI[lang].library.title,
  fix: GUIDES_UI[lang].fix.title,
  term: GUIDES_UI[lang].glossary.title,
}
const jsonLd = [
  breadcrumbList([
    { name: STRINGS[lang].home, url: pageUrl(site, lang, PATHS.home) },
    { name: t.title, url },
  ]),
  // The four directories: each page listed here is in the groups below, one link at a time.
  itemList(
    KNOWLEDGE_TYPES.map((type) => ({
      name: names[type],
      url: `${site.origin}${directories[type]}`,
    })),
  ),
]
const ICON = { tool: Wrench, rule: ListChecks, fix: LifeBuoy, term: BookOpen } as const
---

<Page
  lang={lang}
  path={PATHS.knowledge}
  title={t.meta.title}
  description={t.meta.description}
  jsonLd={jsonLd}
>
  <section class="relative isolate pt-8 pb-16 md:pt-12 md:pb-24">
    {/* The aurora of the home page's hero, over the head and the search only, fading out below. */}
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[640px] [mask-image:linear-gradient(to_bottom,#000_55%,transparent)] md:h-[720px]"
    >
      <Aurora />
    </div>
    <div class="wrap flex flex-col gap-10 md:gap-12">
      <div class="flex max-w-[780px] flex-col gap-4 md:gap-5">
        <Breadcrumb lang={lang} label={t.breadcrumb} current={t.title} />
        <h1 class="gradient-text m-0 text-[44px] leading-[1.2] font-semibold md:text-[68px]">
          {t.title}
        </h1>
        {/* Ink, not ink-2: the aurora's blobs sit right behind the lead on a phone (4.1:1 measured). */}
        <p class="m-0 max-w-[62ch] text-lg leading-[1.85] text-balance text-ink md:text-xl">
          <Bidi text={t.lead} lang={lang} />
        </p>
      </div>

      <KnowledgeSearch
        client:load
        lang={lang}
        items={items}
        tones={tones}
        directories={directories}
      />

      <section aria-labelledby="browse-title" class="flex flex-col gap-5">
        <h2 id="browse-title" class="m-0 text-xl font-semibold md:text-2xl">
          {t.browse.label}
        </h2>
        <ul class="m-0 grid list-none grid-cols-2 gap-3 p-0 md:grid-cols-4 md:gap-4">
          {KNOWLEDGE_TYPES.map((type) => {
            const Icon = ICON[type]
            return (
              <li>
                <a
                  href={directories[type]}
                  class="card card-lift group flex h-full flex-col gap-3 p-5 text-ink hover:text-ink md:p-6"
                >
                  <span
                    aria-hidden="true"
                    class:list={['grid size-11 place-items-center rounded-2xl', TYPE_TILE[type]]}
                  >
                    <Icon size={22} stroke-width={2} />
                  </span>
                  <span
                    dir="ltr"
                    class="gradient-text self-start text-[40px] leading-none font-semibold tabular-nums md:text-[48px]"
                  >
                    {totals[type]}
                  </span>
                  <span class="text-sm leading-[1.7] text-ink-2 md:text-[15px]">
                    <Bidi text={t.browse.tiles[type](totals[type])} lang={lang} />
                  </span>
                </a>
              </li>
            )
          })}
        </ul>
      </section>
    </div>
  </section>
</Page>
