---
import { RULES_UI, TOOLS_UI } from '@arablyzer/i18n'
import { breadcrumbList, techArticle } from '@arablyzer/seo/json-ld'
import { localePath, pageUrl, PATHS, type Lang } from '@arablyzer/seo/site'
import { STRINGS } from '@arablyzer/seo/strings'
import Check from '@lucide/astro/icons/check'
import X from '@lucide/astro/icons/x'
import Page from '../../layouts/Page.astro'
import { HEAD } from '../../lib/heads'
import { LIBRARY_DATA, ruleData } from '../../lib/rule-data'
import { methodologyHref, scanFormHref, siteOf } from '../../lib/site'
import { toolData } from '../../lib/tool-data'
import Bidi from '../Bidi.astro'
import Breadcrumb from '../Breadcrumb.astro'
import DocHeading from '../DocHeading.astro'
import SeverityPill from '../SeverityPill.astro'

interface Props {
  lang: Lang
  id: string
}
const { lang, id } = Astro.props
const rule = ruleData(id)
const copy = rule.copy[lang]
const t = RULES_UI[lang]
const site = siteOf(Astro.site)
const path = PATHS.rule(id)
const url = pageUrl(site, lang, path)
const libraryPath = localePath(lang, PATHS.rules)
const category = TOOLS_UI[lang].categories[rule.category].name
const tools = rule.tools.map((slug) => ({
  href: localePath(lang, PATHS.tool(slug)),
  title: toolData(slug).copy[lang].title,
}))
const near = rule.near.map((other) => ({
  id: other,
  href: localePath(lang, PATHS.rule(other)),
  title: ruleData(other).copy[lang].title,
}))
const jsonLd = [
  techArticle({
    headline: copy.title,
    description: copy.description,
    url,
    lang,
    version: rule.version,
  }),
  breadcrumbList([
    { name: STRINGS[lang].home, url: pageUrl(site, lang, PATHS.home) },
    { name: t.library.title, url: pageUrl(site, lang, PATHS.rules) },
    { name: copy.title, url },
  ]),
]
const headings = LIBRARY_DATA.headings[lang]
// The sections in the order of BUILD-PLAN §6.2, numbered as they are shown: a rule with no code
// to show has no example, and the numbers do not skip it.
const order = ['why', ...(rule.example === null ? [] : ['example']), 'fix', 'detect', 'references']
const numberOf = (section: string) => order.indexOf(section) + 1
const prose = 'prose-fix prose-tool doc-links text-base leading-[1.85] text-ink-2 md:text-[17px]'
const chip =
  'inline-flex h-7 items-center rounded-full border border-line bg-white/80 px-3 text-[13px] text-ink-2'
const boxTitle = 'm-0 mb-1 text-sm font-semibold text-ink-2'
const link =
  'group flex items-center justify-between gap-3 rounded-xl px-3 py-2.5 text-[15px] leading-[1.6] text-ink hover:bg-surface-2 hover:text-ink'
---

<Page
  lang={lang}
  path={path}
  title={`${copy.title} — Arablyzer`}
  description={copy.description}
  jsonLd={jsonLd}
>
  <section class="relative isolate border-b border-line">
    <div aria-hidden="true" class="page-wash"></div>
    <div class:list={['wrap flex flex-col gap-5 md:gap-6', HEAD.padding]}>
      <Breadcrumb
        lang={lang}
        label={t.page.breadcrumb}
        steps={[
          { name: t.library.title, href: libraryPath },
          { name: category, href: `${libraryPath}#cat-${rule.category}` },
        ]}
        current={copy.title}
      />
      <h1 class={HEAD.page}>
        <Bidi text={copy.title} lang={lang} />
      </h1>
      <ul class="m-0 flex list-none flex-wrap items-center gap-2 p-0">
        <li>
          <code
            dir="ltr"
            class="inline-flex h-7 items-center rounded-lg bg-navy px-2.5 font-mono text-[13px] text-panel-text"
          >
            {rule.id}
          </code>
        </li>
        <li>
          <SeverityPill severity={rule.severity} lang={lang} />
        </li>
        <li class={chip}>{category}</li>
        <li class={chip}>
          {t.page.version}{' '}
          <span dir="ltr" class="ms-1.5 font-mono">
            {rule.version}
          </span>
        </li>
        <li class={chip}>{t.page.reads[rule.reads]}</li>
        {rule.manual && <li class={chip}>{t.page.manual}</li>}
        {rule.wcag.map((criterion) => (
          <li class={chip} dir="ltr">
            WCAG<span class="ms-1.5 font-mono">{criterion}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <div
    class:list={[
      'wrap grid gap-10 pb-16 md:pb-24 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] lg:items-start lg:gap-x-14',
      HEAD.bodyTop,
    ]}
  >
    <div class="flex min-w-0 flex-col gap-12 md:gap-14">
      <section id="why" aria-labelledby="why-title" class="flex scroll-mt-6 flex-col gap-4">
        <DocHeading id="why-title" number={numberOf('why')} title={headings.why} />
        <div class={prose} set:html={copy.why} />
      </section>

      {rule.example !== null && (
        <section
          id="example"
          aria-labelledby="example-title"
          class="flex scroll-mt-6 flex-col gap-4"
        >
          <DocHeading id="example-title" number={numberOf('example')} title={t.page.example} />
          <div class="grid gap-4 md:grid-cols-2">
            {(['wrong', 'right'] as const).map((kind) => (
              <figure class="card m-0 flex min-w-0 flex-col overflow-hidden">
                <figcaption class="flex items-center border-b border-line px-4 py-3">
                  <span class:list={['sev', kind === 'wrong' ? 'sev-serious' : 'sev-pass']}>
                    {kind === 'wrong' ? (
                      <X size={14} stroke-width={2.6} aria-hidden="true" />
                    ) : (
                      <Check size={14} stroke-width={2.6} aria-hidden="true" />
                    )}
                    {t.page[kind]}
                  </span>
                </figcaption>
                {/* Wrapped, not scrolled: the examples are short, and often a sentence long. */}
                <pre
                  dir="ltr"
                  class="m-0 grow bg-surface-2 px-4 py-[18px] text-start font-mono text-[13px] leading-[1.7] whitespace-pre-wrap [overflow-wrap:anywhere] md:text-sm"
                  set:html={rule.example?.[kind]}
                />
              </figure>
            ))}
          </div>
        </section>
      )}

      <section id="fix" aria-labelledby="fix-title" class="flex scroll-mt-6 flex-col gap-4">
        <DocHeading id="fix-title" number={numberOf('fix')} title={headings.fix} />
        <div class={prose} set:html={copy.fix} />
      </section>

      <section id="detect" aria-labelledby="detect-title" class="flex scroll-mt-6 flex-col gap-4">
        <DocHeading id="detect-title" number={numberOf('detect')} title={headings.detect} />
        <div class:list={['rule-detect', prose]} set:html={copy.detect} />
      </section>

      <section
        id="references"
        aria-labelledby="references-title"
        class="flex scroll-mt-6 flex-col gap-4"
      >
        <DocHeading
          id="references-title"
          number={numberOf('references')}
          title={headings.references}
        />
        <div class="rule-references prose-fix text-base leading-[1.8]" set:html={copy.references} />
      </section>
    </div>

    <aside class="flex min-w-0 flex-col gap-4 lg:sticky lg:top-24">
      <section aria-labelledby="weight-title" class="card flex flex-col gap-2.5 p-5">
        <h2 id="weight-title" class={boxTitle}>
          {t.page.weight.title}
        </h2>
        <span
          dir="ltr"
          class="gradient-text self-start text-[56px] leading-none font-semibold tabular-nums"
        >
          {rule.weight}
        </span>
        <p class="m-0 text-sm leading-[1.8] text-ink-2">
          {rule.manual ? t.page.weight.manual : t.page.weight.scale(LIBRARY_DATA.weights)}
        </p>
        <a
          href={methodologyHref(lang)}
          class="self-start text-sm font-semibold text-brand-ink underline underline-offset-4 hover:text-ink"
        >
          {t.page.weight.methodology}
        </a>
      </section>

      <nav aria-labelledby="in-tools-title" class="card flex flex-col gap-0.5 p-3">
        <h2 id="in-tools-title" class:list={[boxTitle, 'px-3 pt-1 pb-1']}>
          {t.page.inTools}
        </h2>
        {[...tools, { href: scanFormHref(lang), title: t.page.fullScan }].map((item) => (
          <a href={item.href} class={link}>
            <span class="min-w-0">
              <Bidi text={item.title} lang={lang} />
            </span>
            <span aria-hidden="true" class="chev-end text-ink-3 group-hover:text-brand-ink" />
          </a>
        ))}
      </nav>

      {near.length > 0 && (
        <nav aria-labelledby="near-title" class="card flex flex-col gap-0.5 p-3">
          <h2 id="near-title" class:list={[boxTitle, 'px-3 pt-1 pb-1']}>
            {t.page.near}
          </h2>
          {near.map((other) => (
            <a href={other.href} class={link}>
              <span class="flex min-w-0 flex-col gap-0.5">
                <span class="font-semibold">
                  <Bidi text={other.title} lang={lang} />
                </span>
                <span dir="ltr" class="self-start font-mono text-xs text-ink-2">
                  {other.id}
                </span>
              </span>
              <span aria-hidden="true" class="chev-end text-ink-3 group-hover:text-brand-ink" />
            </a>
          ))}
        </nav>
      )}
    </aside>
  </div>
</Page>

<style>
  /* How we detect: numbered steps, in the gradient of the home page's steps. */
  .rule-detect > :global(ol) {
    list-style: none;
    counter-reset: step;
    padding: 0;
    gap: 1.25rem;
  }
  .rule-detect > :global(ol > li) {
    counter-increment: step;
    position: relative;
    padding-inline-start: 56px;
    min-height: 38px;
  }
  .rule-detect > :global(ol > li)::before {
    content: counter(step);
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 12px;
    background-color: #00727c;
    background-image: var(--gradient-btn);
    color: var(--color-white);
    font-weight: 600;
    font-size: 16px;
    font-variant-numeric: tabular-nums;
    box-shadow: var(--shadow-btn);
  }
  .rule-references :global(ul) {
    list-style: none;
    padding: 0;
    gap: 0.75rem;
  }
  .rule-references :global(a) {
    color: var(--color-brand-ink);
  }
</style>
