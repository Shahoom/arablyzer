---
import { RULES_UI, TOOLS_UI } from '@arablyzer/i18n'
import { breadcrumbList, techArticle } from '@arablyzer/seo/json-ld'
import { localePath, pageUrl, PATHS, type Lang } from '@arablyzer/seo/site'
import { STRINGS } from '@arablyzer/seo/strings'
import Check from '@lucide/astro/icons/check'
import X from '@lucide/astro/icons/x'
import Page from '../../layouts/Page.astro'
import { GUIDES_DATA } from '../../lib/guide-data'
import { HEAD } from '../../lib/heads'
import { LIBRARY_DATA, ruleData } from '../../lib/rule-data'
import { methodologyHref, scanFormHref, siteOf } from '../../lib/site'
import { toolData } from '../../lib/tool-data'
import Bidi from '../Bidi.astro'
import Breadcrumb from '../Breadcrumb.astro'
import DocHeading from '../DocHeading.astro'
import Related from '../guides/Related.astro'
import PageColumns from '../PageColumns.astro'
import Contents from '../pages/Contents.astro'
import SeverityPill from '../SeverityPill.astro'

// A rule's page (BUILD-PLAN §6.2, M2.4; on two columns in M2.6 R7): the head, then the sections in
// the main column, and in the sticky aside its weight in the score, its contents and the pages it
// points to: the tools that run it, rules near it, the fix guides and terms that name it.

interface Props {
  lang: Lang
  id: string
}
const { lang, id } = Astro.props
const rule = ruleData(id)
const copy = rule.copy[lang]
const t = RULES_UI[lang]
const site = siteOf(Astro.site)
const path = PATHS.rule(id)
const url = pageUrl(site, lang, path)
const libraryPath = localePath(lang, PATHS.rules)
const category = TOOLS_UI[lang].categories[rule.category].name
const tools = [
  ...rule.tools.map((slug) => ({
    href: localePath(lang, PATHS.tool(slug)),
    title: toolData(slug).copy[lang].title,
  })),
  { href: scanFormHref(lang), title: t.page.fullScan },
]
const near = rule.near.map((other) => ({
  href: localePath(lang, PATHS.rule(other)),
  title: ruleData(other).copy[lang].title,
}))
// The guides and the terms that name this rule, which point back to it from their own pages.
const guides = GUIDES_DATA.fix
  .filter((guide) => guide.rules.includes(id))
  .map((guide) => ({
    href: localePath(lang, PATHS.fixGuide(guide.slug)),
    title: guide.message[lang],
  }))
const terms = GUIDES_DATA.glossary
  .filter((term) => term.rules.includes(id))
  .map((term) => ({
    href: localePath(lang, PATHS.term(term.slug)),
    title: term.copy[lang].title,
  }))
const jsonLd = [
  techArticle({
    headline: copy.title,
    description: copy.description,
    url,
    lang,
    version: rule.version,
  }),
  breadcrumbList([
    { name: STRINGS[lang].home, url: pageUrl(site, lang, PATHS.home) },
    { name: t.library.title, url: pageUrl(site, lang, PATHS.rules) },
    { name: copy.title, url },
  ]),
]
const headings = LIBRARY_DATA.headings[lang]
// The sections in the order of BUILD-PLAN §6.2: a rule with no code to show has no example.
const sections = [
  { id: 'why', title: headings.why },
  ...(rule.example === null ? [] : [{ id: 'example', title: t.page.example }]),
  { id: 'fix', title: headings.fix },
  { id: 'detect', title: headings.detect },
  { id: 'references', title: headings.references },
]
const prose = 'prose-fix prose-tool doc-links text-body text-ink-2'
// What the rule is, in one quiet line: its version, what it reads, whether a person must review it,
// and the WCAG criteria it serves. (Its category is the trail's last step.)
const facts = [
  { text: `${t.page.version} `, ltr: rule.version },
  { text: t.page.reads[rule.reads] },
  ...(rule.manual ? [{ text: t.page.manual }] : []),
  ...rule.wcag.map((criterion) => ({ text: 'WCAG ', ltr: criterion })),
]
---

<Page
  lang={lang}
  path={path}
  title={`${copy.title} — Arablyzer`}
  description={copy.description}
  jsonLd={jsonLd}
>
  <section class="relative isolate border-b border-line">
    <div aria-hidden="true" class="page-wash"></div>
    <div class:list={['wrap flex flex-col gap-4 lg:gap-5', HEAD.padding]}>
      <Breadcrumb
        lang={lang}
        label={t.page.breadcrumb}
        steps={[
          { name: t.library.title, href: libraryPath },
          { name: category, href: `${libraryPath}#cat-${rule.category}` },
        ]}
        current={copy.title}
      />
      <h1 class={HEAD.page}>
        <Bidi text={copy.title} lang={lang} />
      </h1>
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
        <code
          dir="ltr"
          class="inline-flex h-7 items-center rounded-md bg-navy px-2.5 font-mono text-meta text-panel-text"
        >
          {rule.id}
        </code>
        <SeverityPill severity={rule.severity} lang={lang} />
        <ul class="m-0 flex list-none flex-wrap items-center gap-x-2 gap-y-1 p-0 text-meta text-ink-2 lg:text-small [&>li+li]:before:me-2 [&>li+li]:before:content-['·']">
          {facts.map((fact) => (
            <li>
              {fact.text}
              {fact.ltr !== undefined && <span dir="ltr">{fact.ltr}</span>}
            </li>
          ))}
        </ul>
      </div>
      <Contents variant="inline" label={t.page.contents} sections={sections} />
    </div>
  </section>

  <PageColumns class:list={[HEAD.bodyTop, 'pb-section']}>
    <div slot="aside" class="flex flex-col gap-3">
      <Contents label={t.page.contents} sections={sections} />
      <section aria-labelledby="weight-title" class="kb-box flex flex-col gap-1.5 px-4 py-3">
        <h2
          id="weight-title"
          class="m-0 flex items-center justify-between gap-3 text-small font-semibold text-ink"
        >
          {t.page.weight.title}
          <span dir="ltr" class="heading-2 tabular-nums">
            {rule.weight}
          </span>
        </h2>
        <p class="m-0 text-meta text-ink-2">
          {rule.manual ? t.page.weight.manual : t.page.weight.scale(LIBRARY_DATA.weights)}
        </p>
        <a
          href={methodologyHref(lang)}
          class="self-start text-small font-semibold text-brand-ink underline underline-offset-4 hover:text-ink"
        >
          {t.page.weight.methodology}
        </a>
      </section>
      <Related
        lang={lang}
        groups={[
          { id: 'in-tools-title', title: t.page.inTools, links: tools },
          { id: 'near-title', title: t.page.near, links: near },
          { id: 'guides-title', title: t.page.guides, links: guides },
          { id: 'terms-title', title: t.page.terms, links: terms },
        ]}
      />
    </div>

    <div class="flex flex-col gap-section">
      <section id="why" aria-labelledby="why-title" class="flex scroll-mt-6 flex-col gap-4">
        <DocHeading id="why-title" title={headings.why} />
        <div class={prose} set:html={copy.why} />
      </section>

      {rule.example !== null && (
        <section
          id="example"
          aria-labelledby="example-title"
          class="flex scroll-mt-6 flex-col gap-4"
        >
          <DocHeading id="example-title" title={t.page.example} />
          <div class="grid gap-3 md:grid-cols-2 md:gap-4">
            {(['wrong', 'right'] as const).map((kind) => (
              <figure class="card m-0 flex min-w-0 flex-col overflow-hidden">
                <figcaption class="flex items-center border-b border-line px-3 py-2">
                  <span class:list={['sev', kind === 'wrong' ? 'sev-serious' : 'sev-pass']}>
                    {kind === 'wrong' ? (
                      <X size={14} stroke-width={2.6} aria-hidden="true" />
                    ) : (
                      <Check size={14} stroke-width={2.6} aria-hidden="true" />
                    )}
                    {t.page[kind]}
                  </span>
                </figcaption>
                {/* Wrapped, not scrolled: the examples are short, and often a sentence long. */}
                <pre
                  dir="ltr"
                  class="m-0 grow bg-surface-2 px-4 py-3 text-start font-mono text-meta whitespace-pre-wrap [overflow-wrap:anywhere] md:text-small"
                  set:html={rule.example?.[kind]}
                />
              </figure>
            ))}
          </div>
        </section>
      )}

      <section id="fix" aria-labelledby="fix-title" class="flex scroll-mt-6 flex-col gap-4">
        <DocHeading id="fix-title" title={headings.fix} />
        <div class={prose} set:html={copy.fix} />
      </section>

      <section id="detect" aria-labelledby="detect-title" class="flex scroll-mt-6 flex-col gap-4">
        <DocHeading id="detect-title" title={headings.detect} />
        <div class:list={['rule-detect', prose]} set:html={copy.detect} />
      </section>

      <section
        id="references"
        aria-labelledby="references-title"
        class="flex scroll-mt-6 flex-col gap-4"
      >
        <DocHeading id="references-title" title={headings.references} />
        <div class="rule-references prose-fix text-body" set:html={copy.references} />
      </section>
    </div>
  </PageColumns>
</Page>

<style>
  /* How we detect: numbered steps, each number a quiet circle in the brand's tint. */
  .rule-detect > :global(ol) {
    list-style: none;
    counter-reset: step;
    padding: 0;
    gap: 1rem;
  }
  .rule-detect > :global(ol > li) {
    counter-increment: step;
    position: relative;
    padding-inline-start: 44px;
    min-height: 32px;
  }
  .rule-detect > :global(ol > li)::before {
    content: counter(step);
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    background-color: var(--color-indigo-soft);
    color: var(--color-indigo-ink);
    font-weight: 600;
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }
  .rule-references :global(ul) {
    list-style: none;
    padding: 0;
    gap: 0.75rem;
  }
  .rule-references :global(a) {
    color: var(--color-brand-ink);
  }
</style>
