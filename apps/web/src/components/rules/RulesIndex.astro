---
import { KNOWLEDGE_UI, RULES_UI, TOOLS_UI } from '@arablyzer/i18n'
import { breadcrumbList, itemList } from '@arablyzer/seo/json-ld'
import { localePath, pageUrl, PATHS, type Lang } from '@arablyzer/seo/site'
import { STRINGS } from '@arablyzer/seo/strings'
import ChevronLeft from '@lucide/astro/icons/chevron-left'
import ChevronRight from '@lucide/astro/icons/chevron-right'
import Search from '@lucide/astro/icons/search'
import Page from '../../layouts/Page.astro'
import { HEAD } from '../../lib/heads'
import { searchable } from '../../lib/search'
import { rulesByCategory } from '../../lib/rule-data'
import { siteOf } from '../../lib/site'
import { ARABIC_LAYER, CATEGORY_STYLE } from '../../lib/tool-data'
import Bidi from '../Bidi.astro'
import KnowledgeNav from '../knowledge/KnowledgeNav.astro'
import PageHead from '../PageHead.astro'
import SeverityPill from '../SeverityPill.astro'

// The rule library (BUILD-PLAN §6.2, M2.4; compact rows on two columns in M2.6 R7): every rule in a
// list for its category, a search in the head that narrows them, and in the aside the categories
// as a list (a row of chips under the head on a phone) and the knowledge section's other pages.

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = RULES_UI[lang]
const categories = TOOLS_UI[lang].categories
const site = siteOf(Astro.site)
const url = pageUrl(site, lang, PATHS.rules)
const groups = rulesByCategory()
const count = groups.reduce((sum, group) => sum + group.rules.length, 0)
// What the search says it shows, for each number of rules it can: the script has no plural rules.
const shown = Array.from({ length: count + 1 }, (_, n) => t.library.count(n))
const Next = lang === 'ar' ? ChevronLeft : ChevronRight
// The Arabic layer's categories come first, then the rest: a hairline between the two in the list.
const firstOther = groups.findIndex((group) => !ARABIC_LAYER.has(group.category))
const jsonLd = [
  breadcrumbList([
    { name: STRINGS[lang].home, url: pageUrl(site, lang, PATHS.home) },
    { name: t.library.title, url },
  ]),
  itemList(
    groups
      .flatMap((group) => group.rules)
      .map((rule) => ({
        name: rule.copy[lang].title,
        url: pageUrl(site, lang, PATHS.rule(rule.id)),
      })),
  ),
]
---

<Page
  lang={lang}
  path={PATHS.rules}
  title={t.library.meta.title}
  description={t.library.meta.description}
  jsonLd={jsonLd}
>
  <PageHead
    lang={lang}
    breadcrumb={{ label: t.page.breadcrumb, current: t.library.title }}
    title={t.library.title}
  >
    <Bidi slot="lead" text={t.library.intro} lang={lang} />
    <div slot="end" class="flex w-full shrink-0 flex-col gap-3 lg:w-[420px]">
      <div role="search" class="search-field">
        <Search size={20} stroke-width={2} aria-hidden="true" class="shrink-0 text-ink-3" />
        <label for="rules-search" class="sr-only">
          {t.library.search}
        </label>
        <input
          id="rules-search"
          type="search"
          autocomplete="off"
          placeholder={t.library.searchPlaceholder}
          class="h-full min-w-0 grow border-0 bg-transparent text-body text-ink outline-none placeholder:text-ink-3 [&::-webkit-search-cancel-button]:hidden"
        />
      </div>
      <p class="m-0 flex flex-wrap items-center justify-between gap-x-4 text-small text-ink-2">
        <span id="rules-count" aria-live="polite" data-shown={JSON.stringify(shown)}>
          {t.library.count(count)}
        </span>
        <a
          href={localePath(lang, PATHS.knowledge)}
          class="inline-flex min-h-11 items-center gap-1 font-semibold text-brand-ink underline-offset-4 hover:text-ink hover:underline lg:min-h-6"
        >
          {KNOWLEDGE_UI[lang].searchAll}
          <Next size={16} stroke-width={2} aria-hidden="true" />
        </a>
      </p>
    </div>
  </PageHead>

  {/*
    The aside is before the list in the HTML and drawn beside it from lg (PageColumns' own order is
    the other way): the categories are links to jump with, and a keyboard should reach them before
    the sixty rules they jump over. Below lg it is not drawn: the chips above the list do its work,
    and the footer has the section's other pages.
  */}
  <div class:list={['wrap page-columns', HEAD.bodyTop, 'pb-section']}>
    <div class="page-aside page-aside-sticky hidden flex-col gap-3 lg:flex">
      <nav aria-labelledby="categories-title" class="kb-box flex flex-col gap-0.5 p-3">
        <h2 id="categories-title" class="m-0 px-3 pt-1 pb-1.5 text-meta font-semibold text-ink-2">
          {t.library.categories}
        </h2>
        {groups.map((group, index) => (
          <>
            {index === firstOther && index > 0 && (
              <span aria-hidden="true" class="mx-3 my-1 h-px bg-line" />
            )}
            <a href={`#cat-${group.category}`} class="kb-link text-ink-2 hover:text-ink">
              <span class="flex items-center gap-2.5">
                <span
                  aria-hidden="true"
                  class:list={['size-2 shrink-0 rounded-full', CATEGORY_STYLE[group.category].dot]}
                />
                {categories[group.category].name}
              </span>
              <span dir="ltr" class="tabular-nums">
                {group.rules.length}
              </span>
            </a>
          </>
        ))}
      </nav>
      <KnowledgeNav lang={lang} current="rule" />
    </div>

    <div id="rules-list" class="page-main flex flex-col gap-8 lg:gap-10">
      {/* Below lg the categories are a row of chips that jump to them: sixty rules need one. */}
      <nav aria-label={t.library.categories} class="scroll-row lg:hidden">
        {groups.map((group) => (
          <a href={`#cat-${group.category}`} class="chip whitespace-nowrap">
            <span
              aria-hidden="true"
              class:list={['size-2 shrink-0 rounded-full', CATEGORY_STYLE[group.category].dot]}
            />
            {categories[group.category].name}
            <span dir="ltr" class="tabular-nums">
              {group.rules.length}
            </span>
          </a>
        ))}
      </nav>

      {groups.map((group) => (
        <section
          id={`cat-${group.category}`}
          aria-labelledby={`cat-${group.category}-title`}
          data-category
          class="flex scroll-mt-6 flex-col gap-3"
        >
          <div class="flex flex-col gap-1">
            <h2
              id={`cat-${group.category}-title`}
              class="heading-2 m-0 flex items-baseline gap-2.5"
            >
              {categories[group.category].name}
              <span dir="ltr" class="text-small font-normal text-ink-2 tabular-nums">
                {group.rules.length}
              </span>
            </h2>
            <p class="m-0 max-w-[70ch] text-small text-ink-2">{categories[group.category].blurb}</p>
          </div>
          <div class="kb-list">
            <ul class="m-0 list-none p-0">
              {group.rules.map((rule) => (
                <li
                  data-rule
                  data-search={searchable(
                    [rule.id, rule.copy.ar.title, rule.copy.en.title].join(' '),
                  )}
                >
                  <a href={localePath(lang, PATHS.rule(rule.id))} class="kb-row group">
                    <span
                      aria-hidden="true"
                      class:list={['kb-dot', CATEGORY_STYLE[group.category].dot]}
                    />
                    <span class="flex min-w-0 flex-1 flex-col gap-0.5 md:flex-row md:items-baseline md:justify-between md:gap-4">
                      <span class="min-w-0 text-body font-semibold group-hover:text-brand-ink">
                        <Bidi text={rule.copy[lang].title} lang={lang} />
                      </span>
                      <span
                        dir="ltr"
                        class="self-start font-mono text-meta text-ink-2 md:shrink-0 md:self-auto"
                      >
                        {rule.id}
                      </span>
                    </span>
                    <span class="mt-0.5 shrink-0 md:mt-0 md:self-center">
                      <SeverityPill severity={rule.severity} lang={lang} />
                    </span>
                    <span
                      aria-hidden="true"
                      class="chev-end hidden shrink-0 self-center text-ink-3 group-hover:text-brand-ink sm:block"
                    />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      ))}
      <p
        id="rules-none"
        hidden
        class="m-0 rounded-card border border-dashed border-line-2 bg-white/70 p-card text-small text-ink-2"
      >
        {t.library.none}
      </p>
    </div>
  </div>
</Page>

<script>
  import { matchesAll, searchWords } from '../../lib/search'

  // The library's search: rules whose name or id holds every word typed, read as people type
  // Arabic (lib/search.ts), and the sections they are in; the page works without it, every rule
  // listed.
  const input = document.querySelector<HTMLInputElement>('#rules-search')
  const count = document.querySelector<HTMLElement>('#rules-count')
  const none = document.querySelector<HTMLElement>('#rules-none')
  const sections = [...document.querySelectorAll<HTMLElement>('[data-category]')]
  const all = count?.textContent ?? ''
  // What to say for each number of rules shown, in the page's language (RULES_UI).
  const said = JSON.parse(count?.dataset.shown ?? '[]') as string[]
  input?.addEventListener('input', () => {
    const words = searchWords(input.value)
    let shown = 0
    for (const section of sections) {
      let inSection = 0
      for (const card of section.querySelectorAll<HTMLElement>('[data-rule]')) {
        const match = matchesAll(card.dataset.search ?? '', words)
        card.hidden = !match
        if (match) inSection++
      }
      section.hidden = inSection === 0
      shown += inSection
    }
    if (none !== null) none.hidden = shown > 0
    if (count !== null) count.textContent = words.length === 0 ? all : (said[shown] ?? all)
  })
</script>
