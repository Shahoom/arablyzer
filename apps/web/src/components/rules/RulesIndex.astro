---
import { KNOWLEDGE_UI, RULES_UI, TOOLS_UI } from '@arablyzer/i18n'
import { breadcrumbList, itemList } from '@arablyzer/seo/json-ld'
import { localePath, pageUrl, PATHS, type Lang } from '@arablyzer/seo/site'
import { STRINGS } from '@arablyzer/seo/strings'
import ChevronLeft from '@lucide/astro/icons/chevron-left'
import ChevronRight from '@lucide/astro/icons/chevron-right'
import Search from '@lucide/astro/icons/search'
import Page from '../../layouts/Page.astro'
import { searchable } from '../../lib/search'
import { rulesByCategory } from '../../lib/rule-data'
import { siteOf } from '../../lib/site'
import { ARABIC_LAYER, CATEGORY_STYLE, categoryNumber } from '../../lib/tool-data'
import Bidi from '../Bidi.astro'
import PageHead from '../PageHead.astro'
import SeverityPill from '../SeverityPill.astro'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = RULES_UI[lang]
const categories = TOOLS_UI[lang].categories
const site = siteOf(Astro.site)
const url = pageUrl(site, lang, PATHS.rules)
const groups = rulesByCategory()
const count = groups.reduce((sum, group) => sum + group.rules.length, 0)
// What the search says it shows, for each number of rules it can: the script has no plural rules.
const shown = Array.from({ length: count + 1 }, (_, n) => t.library.count(n))
const Next = lang === 'ar' ? ChevronLeft : ChevronRight
const jsonLd = [
  breadcrumbList([
    { name: STRINGS[lang].home, url: pageUrl(site, lang, PATHS.home) },
    { name: t.library.title, url },
  ]),
  itemList(
    groups
      .flatMap((group) => group.rules)
      .map((rule) => ({
        name: rule.copy[lang].title,
        url: pageUrl(site, lang, PATHS.rule(rule.id)),
      })),
  ),
]
---

<Page
  lang={lang}
  path={PATHS.rules}
  title={t.library.meta.title}
  description={t.library.meta.description}
  jsonLd={jsonLd}
>
  <PageHead
    lang={lang}
    breadcrumb={{ label: t.page.breadcrumb, current: t.library.title }}
    title={t.library.title}
  >
    <Bidi slot="lead" text={t.library.intro} lang={lang} />
    <div slot="end" class="flex w-full shrink-0 flex-col gap-3 lg:w-[480px]">
      <div
        role="search"
        class="flex h-14 items-center gap-3 rounded-2xl border border-field bg-white px-4 shadow focus-within:border-indigo focus-within:ring-4 focus-within:ring-indigo/15"
      >
        <Search size={20} stroke-width={2} aria-hidden="true" class="shrink-0 text-ink-3" />
        <label for="rules-search" class="sr-only">
          {t.library.search}
        </label>
        <input
          id="rules-search"
          type="search"
          autocomplete="off"
          placeholder={t.library.searchPlaceholder}
          class="h-full min-w-0 grow border-0 bg-transparent text-base text-ink outline-none placeholder:text-ink-3 md:text-[17px] [&::-webkit-search-cancel-button]:hidden"
        />
      </div>
      <p class="m-0 flex flex-wrap items-center justify-between gap-x-4 gap-y-1 text-sm text-ink-2">
        <span id="rules-count" aria-live="polite" data-shown={JSON.stringify(shown)}>
          {t.library.count(count)}
        </span>
        <a
          href={localePath(lang, PATHS.knowledge)}
          class="inline-flex h-9 items-center gap-1.5 font-semibold text-brand-ink underline-offset-4 hover:text-ink hover:underline"
        >
          {KNOWLEDGE_UI[lang].searchAll}
          <Next size={16} stroke-width={2} aria-hidden="true" />
        </a>
      </p>
    </div>
  </PageHead>

  <div class="wrap grid gap-10 pt-8 pb-16 md:pt-10 md:pb-24 lg:grid-cols-[272px_minmax(0,1fr)] lg:gap-x-12">
    <nav
      aria-labelledby="categories-title"
      class="card hidden flex-col gap-0.5 self-start p-3 text-[15px] lg:sticky lg:top-24 lg:flex"
    >
      <h2 id="categories-title" class="m-0 px-3 pt-1 pb-2 text-[13px] font-semibold text-ink-2">
        {t.library.categories}
      </h2>
      {groups.map((group, index) => (
        <>
          {index > 0 &&
            ARABIC_LAYER.has(groups[index - 1]?.category ?? group.category) &&
            !ARABIC_LAYER.has(group.category) && (
              <span aria-hidden="true" class="mx-3 my-2 h-px bg-line" />
            )}
          <a
            href={`#cat-${group.category}`}
            class="flex items-center justify-between gap-2.5 rounded-xl px-3 py-2.5 text-ink-2 hover:bg-surface-2 hover:text-ink"
          >
            <span class="flex items-center gap-2.5">
              <span
                aria-hidden="true"
                class:list={['size-2 shrink-0 rounded-full', CATEGORY_STYLE[group.category].dot]}
              />
              {categories[group.category].name}
            </span>
            <span dir="ltr" class="font-mono text-xs text-ink-3 tabular-nums">
              {group.rules.length}
            </span>
          </a>
        </>
      ))}
    </nav>

    <div id="rules-list" class="flex min-w-0 flex-col gap-12 md:gap-14">
      {groups.map((group) => (
        <section
          id={`cat-${group.category}`}
          aria-labelledby={`cat-${group.category}-title`}
          data-category
          class="flex scroll-mt-6 flex-col gap-5"
        >
          <div class="flex flex-col gap-2">
            <div class="flex flex-wrap items-center gap-3">
              <span
                dir="ltr"
                class:list={[
                  'grid h-7 min-w-9 place-items-center rounded-full px-2 font-mono text-[13px] font-semibold tabular-nums',
                  CATEGORY_STYLE[group.category].chip,
                ]}
              >
                {categoryNumber(group.category)}
              </span>
              <h2
                id={`cat-${group.category}-title`}
                class="m-0 text-2xl leading-snug font-semibold md:text-[28px]"
              >
                {categories[group.category].name}
              </h2>
            </div>
            <p class="m-0 max-w-[70ch] text-[15px] leading-[1.7] text-ink-2 md:text-base">
              {categories[group.category].blurb}
            </p>
          </div>
          <ul class="m-0 grid list-none gap-4 p-0 sm:grid-cols-2 xl:grid-cols-3">
            {group.rules.map((rule) => (
              <li
                data-rule
                data-search={searchable(
                  [rule.id, rule.copy.ar.title, rule.copy.en.title].join(' '),
                )}
              >
                <a
                  href={localePath(lang, PATHS.rule(rule.id))}
                  class="card card-lift group flex h-full flex-col gap-3 p-5 text-ink hover:text-ink"
                >
                  <span class="flex items-start justify-between gap-3 text-[17px] leading-snug font-semibold">
                    <span class="min-w-0 group-hover:text-brand-ink">
                      <Bidi text={rule.copy[lang].title} lang={lang} />
                    </span>
                    <span
                      aria-hidden="true"
                      class="chev-end mt-2 text-ink-3 group-hover:text-brand-ink"
                    ></span>
                  </span>
                  <span class="mt-auto flex flex-wrap items-center justify-between gap-2">
                    <span
                      dir="ltr"
                      class="inline-flex h-[26px] items-center rounded-full bg-surface-2 px-2.5 font-mono text-xs text-ink-2"
                    >
                      {rule.id}
                    </span>
                    <SeverityPill severity={rule.severity} lang={lang} />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
      <p
        id="rules-none"
        hidden
        class="m-0 rounded-2xl border border-dashed border-line-2 bg-white/70 p-6 text-base text-ink-2"
      >
        {t.library.none}
      </p>
    </div>
  </div>
</Page>

<script>
  import { matchesAll, searchWords } from '../../lib/search'

  // The library's search: rules whose name or id holds every word typed, read as people type
  // Arabic (lib/search.ts), and the sections they are in; the page works without it, every rule
  // listed.
  const input = document.querySelector<HTMLInputElement>('#rules-search')
  const count = document.querySelector<HTMLElement>('#rules-count')
  const none = document.querySelector<HTMLElement>('#rules-none')
  const sections = [...document.querySelectorAll<HTMLElement>('[data-category]')]
  const all = count?.textContent ?? ''
  // What to say for each number of rules shown, in the page's language (RULES_UI).
  const said = JSON.parse(count?.dataset.shown ?? '[]') as string[]
  input?.addEventListener('input', () => {
    const words = searchWords(input.value)
    let shown = 0
    for (const section of sections) {
      let inSection = 0
      for (const card of section.querySelectorAll<HTMLElement>('[data-rule]')) {
        const match = matchesAll(card.dataset.search ?? '', words)
        card.hidden = !match
        if (match) inSection++
      }
      section.hidden = inSection === 0
      shown += inSection
    }
    if (none !== null) none.hidden = shown > 0
    if (count !== null) count.textContent = words.length === 0 ? all : (said[shown] ?? all)
  })
</script>
