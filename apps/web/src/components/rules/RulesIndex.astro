---
import { RULES_UI, TOOLS_UI } from '@arablyzer/i18n'
import { breadcrumbList, itemList } from '@arablyzer/seo/json-ld'
import { localePath, pageUrl, PATHS, type Lang } from '@arablyzer/seo/site'
import { STRINGS } from '@arablyzer/seo/strings'
import ChevronLeft from '@lucide/astro/icons/chevron-left'
import ChevronRight from '@lucide/astro/icons/chevron-right'
import Search from '@lucide/astro/icons/search'
import Page from '../../layouts/Page.astro'
import { rulesByCategory } from '../../lib/rule-data'
import { siteOf } from '../../lib/site'
import { ARABIC_LAYER, CATEGORY_STYLE, categoryNumber } from '../../lib/tool-data'
import Bidi from '../Bidi.astro'
import SeverityPill from '../SeverityPill.astro'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = RULES_UI[lang]
const categories = TOOLS_UI[lang].categories
const site = siteOf(Astro.site)
const url = pageUrl(site, lang, PATHS.rules)
const groups = rulesByCategory()
const count = groups.reduce((sum, group) => sum + group.rules.length, 0)
const Next = lang === 'ar' ? ChevronLeft : ChevronRight
const jsonLd = [
  breadcrumbList([
    { name: STRINGS[lang].home, url: pageUrl(site, lang, PATHS.home) },
    { name: t.library.title, url },
  ]),
  itemList(
    groups
      .flatMap((group) => group.rules)
      .map((rule) => ({
        name: rule.copy[lang].title,
        url: pageUrl(site, lang, PATHS.rule(rule.id)),
      })),
  ),
]
---

<Page
  lang={lang}
  path={PATHS.rules}
  title={t.library.meta.title}
  description={t.library.meta.description}
  jsonLd={jsonLd}
>
  <section class="flex flex-col gap-5 border-b border-rule px-5 pt-8 pb-8 md:gap-[22px] md:px-16 md:pt-12 md:pb-10">
    <nav aria-label={t.page.breadcrumb} class="text-sm text-ink-3">
      <ol class="m-0 flex list-none flex-wrap items-center gap-2 p-0">
        <li class="flex items-center gap-2">
          <a href={localePath(lang, PATHS.home)} class="text-ink-3 hover:text-brand-ink">
            {STRINGS[lang].home}
          </a>
          <Next size={14} stroke-width={2} aria-hidden="true" class="text-ink-4" />
        </li>
        <li aria-current="page">{t.library.title}</li>
      </ol>
    </nav>
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between lg:gap-12">
      <div class="flex max-w-[760px] flex-col gap-3.5">
        <h1 class="m-0 text-[36px] leading-[1.15] font-semibold md:text-[56px]">
          {t.library.title}
        </h1>
        <p class="m-0 text-base leading-[1.75] text-ink-2 md:text-[19px] md:leading-[1.8]">
          {t.library.intro}
        </p>
      </div>
      <div
        role="search"
        class="flex h-14 w-full shrink-0 items-center gap-3 border-[1.5px] border-ink bg-white px-[18px] lg:w-[480px]"
      >
        <Search size={20} stroke-width={2} aria-hidden="true" class="shrink-0 text-ink-3" />
        <label for="rules-search" class="sr-only">
          {t.library.search}
        </label>
        <input
          id="rules-search"
          type="search"
          autocomplete="off"
          placeholder={t.library.searchPlaceholder}
          class="h-full min-w-0 grow border-0 bg-transparent text-base text-ink outline-none placeholder:text-ink-3 md:text-[17px]"
        />
      </div>
    </div>
    <p class="m-0 text-sm text-ink-3" id="rules-count" aria-live="polite">
      {t.library.count(count)}
    </p>
  </section>

  <div class="grid gap-10 px-5 pt-8 pb-16 md:px-16 md:pt-10 md:pb-20 lg:grid-cols-[272px_minmax(0,1fr)] lg:gap-x-14">
    <nav
      aria-labelledby="categories-title"
      class="hidden flex-col gap-0.5 self-start text-[15px] lg:sticky lg:top-6 lg:flex"
    >
      <h2 id="categories-title" class="m-0 pb-3 text-[13px] font-semibold text-ink-3">
        {t.library.categories}
      </h2>
      {groups.map((group, index) => (
        <>
          {index > 0 &&
            ARABIC_LAYER.has(groups[index - 1]?.category ?? group.category) &&
            !ARABIC_LAYER.has(group.category) && (
              <span aria-hidden="true" class="my-2.5 h-px bg-rule" />
            )}
          <a
            href={`#cat-${group.category}`}
            class="flex items-center justify-between gap-2.5 px-3 py-[9px] hover:text-brand-ink"
          >
            <span class="flex items-center gap-2.5">
              <span
                aria-hidden="true"
                class:list={['size-2 shrink-0', CATEGORY_STYLE[group.category].dot]}
              />
              {categories[group.category].name}
            </span>
            <span dir="ltr" class="font-mono text-xs text-ink-3">
              {group.rules.length}
            </span>
          </a>
        </>
      ))}
    </nav>

    <div id="rules-list" class="flex min-w-0 flex-col gap-12 md:gap-14">
      {groups.map((group) => (
        <section
          id={`cat-${group.category}`}
          aria-labelledby={`cat-${group.category}-title`}
          data-category
          class="flex scroll-mt-6 flex-col gap-5"
        >
          <div
            class:list={[
              'flex flex-col gap-2 border-b-2 pb-4',
              CATEGORY_STYLE[group.category].line,
            ]}
          >
            <div class="flex items-baseline gap-3.5">
              <span
                dir="ltr"
                class:list={[
                  'px-2 py-0.5 font-mono text-[13px] font-semibold',
                  CATEGORY_STYLE[group.category].chip,
                ]}
              >
                {categoryNumber(group.category)}
              </span>
              <h2
                id={`cat-${group.category}-title`}
                class="m-0 text-2xl font-semibold md:text-[28px]"
              >
                {categories[group.category].name}
              </h2>
            </div>
            <p class="m-0 text-[15px] leading-[1.7] text-ink-2 md:text-base">
              {categories[group.category].blurb}
            </p>
          </div>
          <ul class="m-0 grid list-none gap-4 p-0 sm:grid-cols-2 xl:grid-cols-3">
            {group.rules.map((rule) => (
              <li
                data-rule
                data-search={[rule.id, rule.copy.ar.title, rule.copy.en.title]
                  .join(' ')
                  .toLowerCase()}
              >
                <a
                  href={localePath(lang, PATHS.rule(rule.id))}
                  class="group flex h-full flex-col gap-3 border border-rule-strong bg-white p-[22px] hover:border-ink hover:text-ink"
                >
                  <span class="flex items-start justify-between gap-3 text-lg leading-snug font-semibold">
                    <Bidi text={rule.copy[lang].title} lang={lang} />
                    <Next
                      size={18}
                      stroke-width={2}
                      aria-hidden="true"
                      class="mt-1 shrink-0 text-ink-3 group-hover:text-brand-ink"
                    />
                  </span>
                  <span class="mt-auto flex flex-wrap items-center justify-between gap-2">
                    <span dir="ltr" class="font-mono text-xs text-ink-3">
                      {rule.id}
                    </span>
                    <SeverityPill severity={rule.severity} lang={lang} />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
      <p
        id="rules-none"
        hidden
        class="m-0 border border-dashed border-tick p-6 text-base text-ink-2"
      >
        {t.library.none}
      </p>
    </div>
  </div>
</Page>

<script>
  // The library's search: rules whose name or id holds every word typed, and the sections they
  // are in; the page works without it, every rule listed.
  const input = document.querySelector<HTMLInputElement>('#rules-search')
  const count = document.querySelector<HTMLElement>('#rules-count')
  const none = document.querySelector<HTMLElement>('#rules-none')
  const sections = [...document.querySelectorAll<HTMLElement>('[data-category]')]
  const all = count?.textContent ?? ''
  input?.addEventListener('input', () => {
    const words = input.value
      .toLowerCase()
      .split(/\s+/)
      .filter((word) => word !== '')
    let shown = 0
    for (const section of sections) {
      let inSection = 0
      for (const card of section.querySelectorAll<HTMLElement>('[data-rule]')) {
        const text = card.dataset.search ?? ''
        const match = words.every((word) => text.includes(word))
        card.hidden = !match
        if (match) inSection++
      }
      section.hidden = inSection === 0
      shown += inSection
    }
    if (none !== null) none.hidden = shown > 0
    if (count !== null) count.textContent = words.length === 0 ? all : `${String(shown)} / ${all}`
  })
</script>
