---
/**
 * A section's number and label in a kicker pill ("03 · الطبقة العربية"), over its heading. With no
 * label the pill holds the number alone.
 */
interface Props {
  number: number
  label?: string | undefined
  id: string
  title: string
  size?: 'lg' | 'md'
}
const { number, label, id, title, size = 'lg' } = Astro.props
const numbered = String(number).padStart(2, '0')
---

<div class="flex flex-col gap-3.5">
  <span class="inline-flex h-[30px] items-center gap-2 self-start rounded-full bg-indigo-soft ps-1.5 pe-3 text-[13px] leading-none font-semibold text-indigo-ink">
    <span
      dir="ltr"
      class="grid h-[22px] min-w-[22px] place-items-center rounded-full bg-indigo px-1.5 text-[11px] leading-none font-bold text-white tabular-nums"
    >
      {numbered}
    </span>
    {label !== undefined && <span>{label}</span>}
  </span>
  <h2
    id={id}
    class:list={[
      'm-0 leading-[1.25] font-semibold text-balance',
      size === 'lg' ? 'text-[30px] md:text-[44px]' : 'text-[28px] md:text-[40px]',
    ]}
  >
    {title}
  </h2>
</div>
