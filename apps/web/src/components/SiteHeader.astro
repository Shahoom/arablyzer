---
import { SITE } from '@arablyzer/i18n'
import { localePath, PATHS, type Lang } from '@arablyzer/seo/site'
import { NAV, otherLang, scanFormHref } from '../lib/site'
import Forward from './Forward.astro'
import Logo from './Logo.astro'

interface Props {
  lang: Lang
  /** The page's path, as PATHS gives it, for the link to the same page in the other language. */
  path: string
  /** On a report page, the other language's link gets the report's ID (Page.astro). */
  keepId?: boolean
}
const { lang, path, keepId = false } = Astro.props
const t = SITE[lang]
const other = otherLang(lang)
const o = SITE[lang].otherLang
// The site's sections, each marked when the page is its own (the current page) or under it, as
// a tool's page is (the current section): both are underlined. Beside the logo on a desktop;
// below it on a smaller screen, on a row of their own that scrolls sideways if they outgrow it.
const sections = NAV.map((item) => {
  const href = localePath(lang, item.path)
  const page = localePath(lang, path) === href
  const here = page || localePath(lang, path).startsWith(`${href}/`)
  const current: 'page' | 'true' | undefined = page ? 'page' : here ? 'true' : undefined
  return { href, label: t.nav[item.key], current }
})
const underline = 'font-semibold shadow-[inset_0_-2px_0_var(--color-signal)]'
---

<header class="border-b border-ink bg-paper">
  <div class="flex h-[60px] items-center justify-between gap-4 px-5 md:h-[76px] md:px-16">
    <div class="flex items-center gap-12">
      <a
        href={localePath(lang, PATHS.home)}
        aria-label={t.homeLink}
        class="flex items-center gap-3 text-ink hover:text-ink"
      >
        <Logo size={28} />
        <span class="flex flex-col gap-px">
          <span dir="ltr" class="font-mono text-[17px] leading-[1.15] font-semibold md:text-xl">
            Arablyzer
          </span>
          <span class="hidden text-xs leading-[1.3] text-ink-3 md:block">{t.tagline}</span>
        </span>
      </a>
      {sections.length > 0 && (
        <nav aria-label={t.navLabel} class="hidden items-center gap-8 text-[15px] lg:flex">
          {sections.map((section) => (
            <a
              href={section.href}
              aria-current={section.current}
              class:list={['py-1.5 hover:text-signal', section.current !== undefined && underline]}
            >
              {section.label}
            </a>
          ))}
        </nav>
      )}
    </div>
    <div class="flex items-center gap-3.5">
      <a
        href={localePath(other, path)}
        data-keep-id={keepId ? '' : undefined}
        lang={other}
        hreflang={other}
        aria-label={o.label}
        class:list={[
          'border border-rule-strong px-2.5 py-1.5 text-[13px] hover:border-ink hover:text-signal',
          // IBM Plex Mono has no Arabic letters: the Arabic label is set in the Arabic face.
          other === 'en' ? 'font-mono' : 'font-sans',
        ]}
      >
        {o.short}
      </a>
      <a
        href={scanFormHref(lang)}
        class="hidden h-11 items-center gap-2 bg-ink px-5 text-[15px] font-semibold text-white hover:bg-signal sm:flex"
      >
        {t.scanCta}
        <Forward lang={lang} size={16} />
      </a>
    </div>
  </div>
  {sections.length > 0 && (
    <nav
      aria-label={t.navLabel}
      class="flex h-11 items-stretch gap-7 overflow-x-auto border-t border-rule px-5 text-[15px] whitespace-nowrap md:px-16 lg:hidden"
    >
      {sections.map((section) => (
        <a
          href={section.href}
          aria-current={section.current}
          class:list={[
            'flex items-center hover:text-signal',
            section.current !== undefined && underline,
          ]}
        >
          {section.label}
        </a>
      ))}
    </nav>
  )}
</header>
