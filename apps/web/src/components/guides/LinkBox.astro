---
import type { Lang } from '@arablyzer/seo/site'
import ChevronLeft from '@lucide/astro/icons/chevron-left'
import ChevronRight from '@lucide/astro/icons/chevron-right'
import Bidi from '../Bidi.astro'

/** A box of links beside a document: its tools, rules, guides or terms, as the tool page's are. */
interface Props {
  lang: Lang
  id: string
  title: string
  links: readonly { readonly href: string; readonly title: string; readonly code?: string }[]
}
const { lang, id, title, links } = Astro.props
const Next = lang === 'ar' ? ChevronLeft : ChevronRight
---

{links.length > 0 && (
  <nav aria-labelledby={id} class="flex flex-col gap-1 border border-rule-strong bg-white p-[22px]">
    <h2 id={id} class="m-0 mb-2 text-sm font-semibold text-ink-3">
      {title}
    </h2>
    {links.map((link, index) => (
      <a
        href={link.href}
        class:list={[
          'flex items-center justify-between gap-3 py-2.5 hover:text-brand-ink',
          index < links.length - 1 && 'border-b border-rule-soft',
        ]}
      >
        <span class="flex flex-col gap-0.5">
          <span class="text-[15px] leading-[1.6]">
            <Bidi text={link.title} lang={lang} />
          </span>
          {link.code !== undefined && (
            <span dir="ltr" class="self-start font-mono text-xs text-ink-3">
              {link.code}
            </span>
          )}
        </span>
        <Next size={16} stroke-width={2} aria-hidden="true" class="shrink-0" />
      </a>
    ))}
  </nav>
)}
