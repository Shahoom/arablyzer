---
import { GUIDES_UI } from '@arablyzer/i18n'
import { breadcrumbList, techArticle } from '@arablyzer/seo/json-ld'
import { localePath, pageUrl, PATHS, type Lang } from '@arablyzer/seo/site'
import { STRINGS } from '@arablyzer/seo/strings'
import { HEAD } from '../../lib/heads'
import { fixGuideData } from '../../lib/guide-data'
import { ruleData } from '../../lib/rule-data'
import { siteOf } from '../../lib/site'
import { toolData } from '../../lib/tool-data'
import Bidi from '../Bidi.astro'
import DocPage from '../pages/DocPage.astro'
import DocBody from './DocBody.astro'
import LinkBox from './LinkBox.astro'

// A /fix guide (BUILD-PLAN §6.3, M2.4d): the message as the report shows it, what it means,
// why it shows, how to fix it and check the fix, and the Arablyzer tools and rules that check it.

interface Props {
  lang: Lang
  slug: string
}
const { lang, slug } = Astro.props
const guide = fixGuideData(slug)
const copy = guide.copy[lang]
const t = GUIDES_UI[lang].fix
const site = siteOf(Astro.site)
const path = PATHS.fixGuide(slug)
const url = pageUrl(site, lang, path)
const other = lang === 'ar' ? 'en' : 'ar'
const jsonLd = [
  techArticle({ headline: copy.title, description: copy.description, url, lang }),
  breadcrumbList([
    { name: STRINGS[lang].home, url: pageUrl(site, lang, PATHS.home) },
    { name: t.title, url: pageUrl(site, lang, PATHS.fix) },
    { name: guide.message[lang], url },
  ]),
]
const tools = guide.tools.map((tool) => ({
  href: localePath(lang, PATHS.tool(tool)),
  title: toolData(tool).copy[lang].title,
}))
const rules = guide.rules.map((rule) => ({
  href: localePath(lang, PATHS.rule(rule)),
  title: ruleData(rule).copy[lang].title,
  code: rule,
}))
const related = guide.related.map((other) => ({
  href: localePath(lang, PATHS.fixGuide(other)),
  title: fixGuideData(other).message[lang],
}))
---

<DocPage
  lang={lang}
  path={path}
  title={`${copy.title} — Arablyzer`}
  description={copy.description}
  jsonLd={jsonLd}
  crumb={guide.message[lang]}
  breadcrumbLabel={t.breadcrumb}
  parent={{ name: t.title, href: localePath(lang, PATHS.fix) }}
>
  <Fragment slot="head">
    <span class="kick self-start">
      <Bidi text={t.source} lang={lang} />
    </span>
    <h1 class={HEAD.page}>
      <Bidi text={copy.title} lang={lang} />
    </h1>
    <p class={HEAD.lead}>
      <Bidi text={copy.description} lang={lang} />
    </p>
    <p class="m-0 flex flex-wrap items-baseline gap-x-2 text-sm text-ink-2">
      {t.otherMessage}:
      <span lang={other} dir={other === 'ar' ? 'rtl' : 'ltr'} class="font-semibold text-ink">
        {guide.message[other]}
      </span>
    </p>
  </Fragment>
  <div slot="aside" class="flex flex-col gap-4">
    <LinkBox lang={lang} id="tools-title" title={t.tools} links={tools} />
    <LinkBox lang={lang} id="rules-title" title={t.rules} links={rules} />
    <LinkBox lang={lang} id="related-title" title={t.related} links={related} />
    <p class="m-0 px-1 text-sm text-ink-2">
      {t.updated}{' '}
      <time datetime={guide.updated} dir="ltr" class="font-mono">
        {guide.updated}
      </time>
    </p>
  </div>
  <DocBody copy={copy} faqKey="faq" />
</DocPage>
