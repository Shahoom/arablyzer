---
import type { DocCopyData } from '../../lib/guide-data'
import DocHeading from '../DocHeading.astro'

/**
 * A guide's or a term's sections, as their copy orders them: each a <section> with its numbered
 * heading, and the questions, each an <h3> with its answer showing (the audit reads them, as do
 * answer engines).
 */
interface Props {
  copy: DocCopyData
  /** The section of questions, rendered from `copy.faq`. */
  faqKey?: string
}
const { copy, faqKey } = Astro.props
const prose = 'prose-fix prose-tool doc-links text-base leading-[1.85] text-ink-2 md:text-[17px]'
---

{copy.sections.map((section, index) => (
  <section
    id={section.key}
    aria-labelledby={`${section.key}-title`}
    class="flex scroll-mt-6 flex-col gap-4"
  >
    <DocHeading id={`${section.key}-title`} number={index + 1} title={section.title} />
    {section.key === faqKey ? (
      <div class="flex flex-col gap-3">
        {copy.faq.map((entry) => (
          <div class="card flex flex-col gap-3 p-5 md:p-6">
            <h3 class="m-0 text-lg leading-snug font-semibold" set:html={entry.question} />
            <div class={prose} set:html={entry.answer} />
          </div>
        ))}
      </div>
    ) : (
      <div class={prose} set:html={section.html} />
    )}
  </section>
))}
