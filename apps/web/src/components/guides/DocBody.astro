---
import type { DocCopyData } from '../../lib/guide-data'

/**
 * A guide's or a term's sections, as their copy orders them: each a <section> with its heading,
 * and the questions, each an <h3> with its answer showing (the audit reads them, as do answer
 * engines).
 */
interface Props {
  copy: DocCopyData
  /** The section of questions, rendered from `copy.faq`. */
  faqKey?: string
}
const { copy, faqKey } = Astro.props
const heading = 'm-0 text-[26px] leading-[1.25] font-semibold md:text-[30px]'
const prose = 'prose-fix prose-tool text-base leading-[1.85] text-ink-2 md:text-[17px]'
---

{copy.sections.map((section) => (
  <section
    id={section.key}
    aria-labelledby={`${section.key}-title`}
    class="flex scroll-mt-6 flex-col gap-4"
  >
    <h2 id={`${section.key}-title`} class={heading}>
      {section.title}
    </h2>
    {section.key === faqKey ? (
      <div class="flex flex-col">
        {copy.faq.map((entry, index) => (
          <div
            class:list={[
              'flex flex-col gap-3 py-[18px]',
              index === 0 ? 'border-t border-ink' : 'border-t border-rule',
              index === copy.faq.length - 1 && 'border-b border-rule',
            ]}
          >
            <h3 class="m-0 text-lg leading-snug font-semibold" set:html={entry.question} />
            <div class={prose} set:html={entry.answer} />
          </div>
        ))}
      </div>
    ) : (
      <div class={prose} set:html={section.html} />
    )}
  </section>
))}
