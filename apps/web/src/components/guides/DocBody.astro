---
import type { DocCopyData } from '../../lib/guide-data'
import DocHeading from '../DocHeading.astro'

/**
 * A guide's or a term's sections, as their copy orders them: each a <section> with its heading,
 * and the questions, each an <h3> with its answer showing (the audit reads them, as do answer
 * engines). The questions are a plain list with a hairline between them, not a card for each
 * (M2.6 R7): the section is the box, and the page has enough of them.
 */
interface Props {
  copy: DocCopyData
  /** The section of questions, rendered from `copy.faq`. */
  faqKey?: string
}
const { copy, faqKey } = Astro.props
const prose = 'prose-fix prose-tool doc-links text-body text-ink-2'
---

{copy.sections.map((section) => (
  <section
    id={section.key}
    aria-labelledby={`${section.key}-title`}
    class="flex scroll-mt-6 flex-col gap-4"
  >
    <DocHeading id={`${section.key}-title`} title={section.title} />
    {section.key === faqKey ? (
      <div class="flex flex-col divide-y divide-line">
        {copy.faq.map((entry) => (
          <div class="flex flex-col gap-2 py-5 first:pt-0 last:pb-0">
            <h3 class="heading-3 m-0" set:html={entry.question} />
            <div class={prose} set:html={entry.answer} />
          </div>
        ))}
      </div>
    ) : (
      <div class={prose} set:html={section.html} />
    )}
  </section>
))}
