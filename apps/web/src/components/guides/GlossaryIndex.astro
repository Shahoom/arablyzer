---
import { GUIDES_UI } from '@arablyzer/i18n'
import { breadcrumbList, itemList } from '@arablyzer/seo/json-ld'
import { localePath, pageUrl, PATHS, type Lang } from '@arablyzer/seo/site'
import { STRINGS } from '@arablyzer/seo/strings'
import ChevronLeft from '@lucide/astro/icons/chevron-left'
import ChevronRight from '@lucide/astro/icons/chevron-right'
import Page from '../../layouts/Page.astro'
import { GUIDES_DATA } from '../../lib/guide-data'
import { siteOf } from '../../lib/site'
import Bidi from '../Bidi.astro'

// The glossary's index (M2.4d): every term, in the order of its name in the page's language,
// each with its English term and its one-line definition.

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = GUIDES_UI[lang].glossary
const site = siteOf(Astro.site)
const url = pageUrl(site, lang, PATHS.glossary)
const Next = lang === 'ar' ? ChevronLeft : ChevronRight
const terms = [...GUIDES_DATA.glossary].sort((a, b) =>
  a.copy[lang].title.localeCompare(b.copy[lang].title, lang),
)
const jsonLd = [
  breadcrumbList([
    { name: STRINGS[lang].home, url: pageUrl(site, lang, PATHS.home) },
    { name: t.title, url },
  ]),
  itemList(
    terms.map((term) => ({
      name: term.copy[lang].title,
      url: pageUrl(site, lang, PATHS.term(term.slug)),
    })),
  ),
]
---

<Page
  lang={lang}
  path={PATHS.glossary}
  title={t.meta.title}
  description={t.meta.description}
  jsonLd={jsonLd}
>
  <section class="flex flex-col gap-5 border-b border-rule px-5 pt-8 pb-8 md:gap-[22px] md:px-16 md:pt-12 md:pb-10">
    <nav aria-label={t.breadcrumb} class="text-sm text-ink-3">
      <ol class="m-0 flex list-none flex-wrap items-center gap-2 p-0">
        <li class="flex items-center gap-2">
          <a href={localePath(lang, PATHS.home)} class="text-ink-3 hover:text-brand-ink">
            {STRINGS[lang].home}
          </a>
          <Next size={14} stroke-width={2} aria-hidden="true" class="text-ink-4" />
        </li>
        <li aria-current="page">{t.title}</li>
      </ol>
    </nav>
    <div class="flex max-w-[760px] flex-col gap-3.5">
      <h1 class="m-0 text-[36px] leading-[1.15] font-semibold md:text-[56px]">{t.title}</h1>
      <p class="m-0 text-base leading-[1.75] text-ink-2 md:text-[19px] md:leading-[1.8]">
        <Bidi text={t.intro} lang={lang} />
      </p>
    </div>
  </section>

  <ul class="m-0 grid list-none gap-4 px-5 pt-8 pb-16 sm:grid-cols-2 md:px-16 md:pt-10 md:pb-20 xl:grid-cols-3">
    {terms.map((term) => (
      <li>
        <a
          href={localePath(lang, PATHS.term(term.slug))}
          class="group flex h-full flex-col gap-2.5 border border-rule-strong bg-white p-[22px] hover:border-ink hover:text-ink"
        >
          <span class="flex items-start justify-between gap-3 text-lg leading-snug font-semibold">
            <Bidi text={term.copy[lang].title} lang={lang} />
            <Next
              size={18}
              stroke-width={2}
              aria-hidden="true"
              class="mt-1 shrink-0 text-ink-3 group-hover:text-brand-ink"
            />
          </span>
          <span class="text-[15px] leading-[1.7] text-ink-2">
            <Bidi text={term.copy[lang].description} lang={lang} />
          </span>
          {lang === 'ar' && (
            <span lang="en" dir="ltr" class="mt-auto self-start font-mono text-xs text-ink-3">
              {term.term}
            </span>
          )}
        </a>
      </li>
    ))}
  </ul>
</Page>
