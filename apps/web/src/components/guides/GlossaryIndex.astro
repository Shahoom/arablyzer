---
import { GUIDES_UI, KNOWLEDGE_UI } from '@arablyzer/i18n'
import { breadcrumbList, itemList } from '@arablyzer/seo/json-ld'
import { localePath, pageUrl, PATHS, type Lang } from '@arablyzer/seo/site'
import { STRINGS } from '@arablyzer/seo/strings'
import ChevronLeft from '@lucide/astro/icons/chevron-left'
import ChevronRight from '@lucide/astro/icons/chevron-right'
import Page from '../../layouts/Page.astro'
import { GUIDES_DATA } from '../../lib/guide-data'
import { siteOf } from '../../lib/site'
import Bidi from '../Bidi.astro'
import PageHead from '../PageHead.astro'

// The glossary's index (M2.4d): every term, in the order of its name in the page's language,
// each with its English term and its one-line definition.

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = GUIDES_UI[lang].glossary
const site = siteOf(Astro.site)
const url = pageUrl(site, lang, PATHS.glossary)
const Next = lang === 'ar' ? ChevronLeft : ChevronRight
const terms = [...GUIDES_DATA.glossary].sort((a, b) =>
  a.copy[lang].title.localeCompare(b.copy[lang].title, lang),
)
const jsonLd = [
  breadcrumbList([
    { name: STRINGS[lang].home, url: pageUrl(site, lang, PATHS.home) },
    { name: t.title, url },
  ]),
  itemList(
    terms.map((term) => ({
      name: term.copy[lang].title,
      url: pageUrl(site, lang, PATHS.term(term.slug)),
    })),
  ),
]
---

<Page
  lang={lang}
  path={PATHS.glossary}
  title={t.meta.title}
  description={t.meta.description}
  jsonLd={jsonLd}
  latinPreload
>
  <PageHead lang={lang} breadcrumb={{ label: t.breadcrumb, current: t.title }} title={t.title}>
    <Bidi slot="lead" text={t.intro} lang={lang} />
    <a
      slot="end"
      href={localePath(lang, PATHS.knowledge)}
      class="inline-flex h-10 shrink-0 items-center gap-1.5 text-sm font-semibold text-brand-ink underline-offset-4 hover:text-ink hover:underline"
    >
      {KNOWLEDGE_UI[lang].searchAll}
      <Next size={16} stroke-width={2} aria-hidden="true" />
    </a>
  </PageHead>

  <ul class="wrap grid list-none gap-4 pt-8 pb-16 sm:grid-cols-2 md:pt-10 md:pb-24 xl:grid-cols-3">
    {terms.map((term) => (
      <li>
        <a
          href={localePath(lang, PATHS.term(term.slug))}
          class="card card-lift group flex h-full flex-col gap-2.5 p-5 text-ink hover:text-ink"
        >
          <span class="flex items-start justify-between gap-3 text-[17px] leading-snug font-semibold">
            <span class="min-w-0 group-hover:text-brand-ink">
              <Bidi text={term.copy[lang].title} lang={lang} />
            </span>
            <span aria-hidden="true" class="chev-end mt-2 text-ink-3 group-hover:text-brand-ink" />
          </span>
          <span class="text-[15px] leading-[1.7] text-ink-2">
            <Bidi text={term.copy[lang].description} lang={lang} />
          </span>
          {lang === 'ar' && (
            <span
              lang="en"
              dir="ltr"
              class="mt-auto inline-flex h-[26px] items-center self-start rounded-full bg-surface-2 px-2.5 font-mono text-xs text-ink-2"
            >
              {term.term}
            </span>
          )}
        </a>
      </li>
    ))}
  </ul>
</Page>
