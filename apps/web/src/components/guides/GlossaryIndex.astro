---
import { GUIDES_UI, KNOWLEDGE_UI } from '@arablyzer/i18n'
import { breadcrumbList, itemList } from '@arablyzer/seo/json-ld'
import { localePath, pageUrl, PATHS, type Lang } from '@arablyzer/seo/site'
import { STRINGS } from '@arablyzer/seo/strings'
import ChevronLeft from '@lucide/astro/icons/chevron-left'
import ChevronRight from '@lucide/astro/icons/chevron-right'
import Page from '../../layouts/Page.astro'
import { GUIDES_DATA } from '../../lib/guide-data'
import { HEAD } from '../../lib/heads'
import { siteOf } from '../../lib/site'
import Bidi from '../Bidi.astro'
import KnowledgeNav from '../knowledge/KnowledgeNav.astro'
import PageHead from '../PageHead.astro'

// The glossary's index (M2.4d; compact rows on two columns in M2.6 R7): every term, in the order
// of its name in the page's language, each with its English term and its one-line definition.

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = GUIDES_UI[lang].glossary
const site = siteOf(Astro.site)
const url = pageUrl(site, lang, PATHS.glossary)
const Next = lang === 'ar' ? ChevronLeft : ChevronRight
const terms = [...GUIDES_DATA.glossary].sort((a, b) =>
  a.copy[lang].title.localeCompare(b.copy[lang].title, lang),
)
const jsonLd = [
  breadcrumbList([
    { name: STRINGS[lang].home, url: pageUrl(site, lang, PATHS.home) },
    { name: t.title, url },
  ]),
  itemList(
    terms.map((term) => ({
      name: term.copy[lang].title,
      url: pageUrl(site, lang, PATHS.term(term.slug)),
    })),
  ),
]
---

<Page
  lang={lang}
  path={PATHS.glossary}
  title={t.meta.title}
  description={t.meta.description}
  jsonLd={jsonLd}
>
  <PageHead lang={lang} breadcrumb={{ label: t.breadcrumb, current: t.title }} title={t.title}>
    <Bidi slot="lead" text={t.intro} lang={lang} />
    <a
      slot="end"
      href={localePath(lang, PATHS.knowledge)}
      class="inline-flex min-h-11 shrink-0 items-center gap-1 text-small font-semibold text-brand-ink underline-offset-4 hover:text-ink hover:underline"
    >
      {KNOWLEDGE_UI[lang].searchAll}
      <Next size={16} stroke-width={2} aria-hidden="true" />
    </a>
  </PageHead>

  {/* The aside is before the list in the HTML and drawn beside it from lg; below lg it is not drawn. */}
  <div class:list={['wrap page-columns', HEAD.bodyTop, 'pb-section']}>
    <div class="page-aside page-aside-sticky hidden lg:block">
      <KnowledgeNav lang={lang} current="term" />
    </div>

    <ul class="page-main kb-list m-0 list-none p-0">
      {terms.map((term) => (
        <li>
          <a href={localePath(lang, PATHS.term(term.slug))} class="kb-row group">
            <span class="flex min-w-0 flex-1 flex-col gap-1">
              <span class="flex items-baseline justify-between gap-3">
                <span class="min-w-0 text-body font-semibold group-hover:text-brand-ink">
                  <Bidi text={term.copy[lang].title} lang={lang} />
                </span>
                {lang === 'ar' && (
                  <span lang="en" dir="ltr" class="hidden shrink-0 text-meta text-ink-2 md:block">
                    {term.term}
                  </span>
                )}
              </span>
              <span class="line-clamp-2 text-small text-ink-2 max-md:line-clamp-1">
                <Bidi text={term.copy[lang].description} lang={lang} />
              </span>
            </span>
            <span
              aria-hidden="true"
              class="chev-end hidden shrink-0 self-center text-ink-3 group-hover:text-brand-ink sm:block"
            />
          </a>
        </li>
      ))}
    </ul>
  </div>
</Page>
