---
import { GUIDES_UI, KNOWLEDGE_UI } from '@arablyzer/i18n'
import { breadcrumbList, itemList } from '@arablyzer/seo/json-ld'
import { localePath, pageUrl, PATHS, type Lang } from '@arablyzer/seo/site'
import { STRINGS } from '@arablyzer/seo/strings'
import ChevronLeft from '@lucide/astro/icons/chevron-left'
import ChevronRight from '@lucide/astro/icons/chevron-right'
import Page from '../../layouts/Page.astro'
import { GUIDE_STATUS_DOT, GUIDES_DATA } from '../../lib/guide-data'
import { siteOf } from '../../lib/site'
import Bidi from '../Bidi.astro'
import PageHead from '../PageHead.astro'

// The /fix guides' index (M2.4d): the Page indexing report's messages, in the report's order,
// each with the message in the other language, since a site's Search Console may be in either.

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = GUIDES_UI[lang].fix
const site = siteOf(Astro.site)
const url = pageUrl(site, lang, PATHS.fix)
const other = lang === 'ar' ? 'en' : 'ar'
const Next = lang === 'ar' ? ChevronLeft : ChevronRight
const groups = (['not-indexed', 'warning'] as const)
  .map((status) => ({ status, guides: GUIDES_DATA.fix.filter((guide) => guide.status === status) }))
  .filter((group) => group.guides.length > 0)
const jsonLd = [
  breadcrumbList([
    { name: STRINGS[lang].home, url: pageUrl(site, lang, PATHS.home) },
    { name: t.title, url },
  ]),
  itemList(
    GUIDES_DATA.fix.map((guide) => ({
      name: guide.message[lang],
      url: pageUrl(site, lang, PATHS.fixGuide(guide.slug)),
    })),
  ),
]
---

<Page
  lang={lang}
  path={PATHS.fix}
  title={t.meta.title}
  description={t.meta.description}
  jsonLd={jsonLd}
  latinPreload
>
  <PageHead lang={lang} breadcrumb={{ label: t.breadcrumb, current: t.title }} title={t.title}>
    <span slot="kicker" class="kick self-start">
      <Bidi text={t.source} lang={lang} />
    </span>
    <Bidi slot="lead" text={t.intro} lang={lang} />
    <a
      slot="end"
      href={localePath(lang, PATHS.knowledge)}
      class="inline-flex h-10 shrink-0 items-center gap-1.5 text-sm font-semibold text-brand-ink underline-offset-4 hover:text-ink hover:underline"
    >
      {KNOWLEDGE_UI[lang].searchAll}
      <Next size={16} stroke-width={2} aria-hidden="true" />
    </a>
  </PageHead>

  <div class="wrap flex flex-col gap-12 pt-8 pb-16 md:pt-10 md:pb-24">
    {groups.map((group) => (
      <section aria-labelledby={`group-${group.status}`} class="flex flex-col gap-5">
        <h2
          id={`group-${group.status}`}
          class="m-0 flex items-center gap-3 text-2xl leading-snug font-semibold md:text-[28px]"
        >
          <span
            aria-hidden="true"
            class:list={['size-2.5 shrink-0 rounded-full', GUIDE_STATUS_DOT[group.status]]}
          />
          {t.groups[group.status]}
          <span
            dir="ltr"
            class="rounded-full bg-surface-2 px-2.5 py-0.5 text-sm font-normal text-ink-2 tabular-nums"
          >
            {group.guides.length}
          </span>
        </h2>
        <ul class="m-0 grid list-none gap-4 p-0 sm:grid-cols-2 xl:grid-cols-3">
          {group.guides.map((guide) => (
            <li>
              <a
                href={localePath(lang, PATHS.fixGuide(guide.slug))}
                class="card card-lift group flex h-full flex-col gap-3 p-5 text-ink hover:text-ink"
              >
                <span class="flex items-start justify-between gap-3 text-[17px] leading-snug font-semibold">
                  <span class="min-w-0 group-hover:text-brand-ink">
                    <Bidi text={guide.message[lang]} lang={lang} />
                  </span>
                  <span
                    aria-hidden="true"
                    class="chev-end mt-2 text-ink-3 group-hover:text-brand-ink"
                  />
                </span>
                <span
                  lang={other}
                  dir={other === 'ar' ? 'rtl' : 'ltr'}
                  class:list={[
                    'mt-auto text-sm text-ink-2',
                    other === 'en' && 'self-start font-mono',
                  ]}
                >
                  {guide.message[other]}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Page>
