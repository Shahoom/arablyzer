---
import { GUIDES_UI, KNOWLEDGE_UI } from '@arablyzer/i18n'
import { breadcrumbList, itemList } from '@arablyzer/seo/json-ld'
import { localePath, pageUrl, PATHS, type Lang } from '@arablyzer/seo/site'
import { STRINGS } from '@arablyzer/seo/strings'
import ChevronLeft from '@lucide/astro/icons/chevron-left'
import ChevronRight from '@lucide/astro/icons/chevron-right'
import Page from '../../layouts/Page.astro'
import { GUIDE_STATUS_DOT, GUIDES_DATA } from '../../lib/guide-data'
import { HEAD } from '../../lib/heads'
import { siteOf } from '../../lib/site'
import Bidi from '../Bidi.astro'
import KnowledgeNav from '../knowledge/KnowledgeNav.astro'
import PageHead from '../PageHead.astro'

// The /fix guides' index (M2.4d; compact rows on two columns in M2.6 R7): the Page indexing
// report's messages, in the report's order, each with the message in the other language, since a
// site's Search Console may be in either. Two groups, as Search Console splits them.

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = GUIDES_UI[lang].fix
const site = siteOf(Astro.site)
const url = pageUrl(site, lang, PATHS.fix)
const other = lang === 'ar' ? 'en' : 'ar'
const Next = lang === 'ar' ? ChevronLeft : ChevronRight
const groups = (['not-indexed', 'warning'] as const)
  .map((status) => ({ status, guides: GUIDES_DATA.fix.filter((guide) => guide.status === status) }))
  .filter((group) => group.guides.length > 0)
const jsonLd = [
  breadcrumbList([
    { name: STRINGS[lang].home, url: pageUrl(site, lang, PATHS.home) },
    { name: t.title, url },
  ]),
  itemList(
    GUIDES_DATA.fix.map((guide) => ({
      name: guide.message[lang],
      url: pageUrl(site, lang, PATHS.fixGuide(guide.slug)),
    })),
  ),
]
---

<Page
  lang={lang}
  path={PATHS.fix}
  title={t.meta.title}
  description={t.meta.description}
  jsonLd={jsonLd}
>
  <PageHead lang={lang} breadcrumb={{ label: t.breadcrumb, current: t.title }} title={t.title}>
    <span slot="kicker" class="topic self-start">
      <span aria-hidden="true" class="size-2 rounded-full bg-cat-index"></span>
      <Bidi text={t.source} lang={lang} />
    </span>
    <Bidi slot="lead" text={t.intro} lang={lang} />
    <a
      slot="end"
      href={localePath(lang, PATHS.knowledge)}
      class="inline-flex min-h-11 shrink-0 items-center gap-1 text-small font-semibold text-brand-ink underline-offset-4 hover:text-ink hover:underline"
    >
      {KNOWLEDGE_UI[lang].searchAll}
      <Next size={16} stroke-width={2} aria-hidden="true" />
    </a>
  </PageHead>

  {/* The aside is before the list in the HTML and drawn beside it from lg; below lg it is not drawn. */}
  <div class:list={['wrap page-columns', HEAD.bodyTop, 'pb-section']}>
    <div class="page-aside page-aside-sticky hidden flex-col gap-3 lg:flex">
      {/* Two groups are two things to jump between; one is the page. */}
      {groups.length > 1 && (
        <nav aria-labelledby="groups-title" class="kb-box flex flex-col gap-1 p-3">
          <h2 id="groups-title" class="m-0 px-3 pt-1 pb-2 text-meta font-semibold text-ink-2">
            {t.contents}
          </h2>
          {groups.map((group) => (
            <a href={`#group-${group.status}`} class="kb-link text-ink-2 hover:text-ink">
              <span class="flex items-center gap-3">
                <span
                  aria-hidden="true"
                  class:list={['size-2 shrink-0 rounded-full', GUIDE_STATUS_DOT[group.status]]}
                />
                {t.groups[group.status]}
              </span>
              <span dir="ltr" class="tabular-nums">
                {group.guides.length}
              </span>
            </a>
          ))}
        </nav>
      )}
      <KnowledgeNav lang={lang} current="fix" />
    </div>

    <div class="page-main flex flex-col gap-8 lg:gap-10">
      {groups.map((group) => (
        <section
          id={`group-${group.status}`}
          aria-labelledby={`group-${group.status}-title`}
          class="flex scroll-mt-6 flex-col gap-3"
        >
          <h2 id={`group-${group.status}-title`} class="heading-2 m-0 flex items-baseline gap-3">
            {t.groups[group.status]}
            <span dir="ltr" class="text-small font-normal text-ink-2 tabular-nums">
              {group.guides.length}
            </span>
          </h2>
          <ul class="kb-list m-0 list-none p-0">
            {group.guides.map((guide) => (
              <li>
                <a href={localePath(lang, PATHS.fixGuide(guide.slug))} class="kb-row group">
                  <span
                    aria-hidden="true"
                    class:list={['kb-dot', GUIDE_STATUS_DOT[group.status]]}
                  />
                  <span class="flex min-w-0 flex-1 flex-col gap-1">
                    <span class="min-w-0 text-body font-semibold group-hover:text-brand-ink">
                      <Bidi text={guide.message[lang]} lang={lang} />
                    </span>
                    <span
                      lang={other}
                      dir={other === 'ar' ? 'rtl' : 'ltr'}
                      class="self-start text-meta text-ink-2"
                    >
                      {guide.message[other]}
                    </span>
                  </span>
                  <span
                    aria-hidden="true"
                    class="chev-end hidden shrink-0 self-center text-ink-3 group-hover:text-brand-ink sm:block"
                  />
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</Page>
