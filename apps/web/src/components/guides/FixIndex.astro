---
import { GUIDES_UI } from '@arablyzer/i18n'
import { breadcrumbList, itemList } from '@arablyzer/seo/json-ld'
import { localePath, pageUrl, PATHS, type Lang } from '@arablyzer/seo/site'
import { STRINGS } from '@arablyzer/seo/strings'
import ChevronLeft from '@lucide/astro/icons/chevron-left'
import ChevronRight from '@lucide/astro/icons/chevron-right'
import Page from '../../layouts/Page.astro'
import { GUIDES_DATA } from '../../lib/guide-data'
import { siteOf } from '../../lib/site'
import Bidi from '../Bidi.astro'

// The /fix guides' index (M2.4d): the Page indexing report's messages, in the report's order,
// each with the message in the other language, since a site's Search Console may be in either.

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = GUIDES_UI[lang].fix
const site = siteOf(Astro.site)
const url = pageUrl(site, lang, PATHS.fix)
const other = lang === 'ar' ? 'en' : 'ar'
const Next = lang === 'ar' ? ChevronLeft : ChevronRight
const groups = (['not-indexed', 'warning'] as const)
  .map((status) => ({ status, guides: GUIDES_DATA.fix.filter((guide) => guide.status === status) }))
  .filter((group) => group.guides.length > 0)
const jsonLd = [
  breadcrumbList([
    { name: STRINGS[lang].home, url: pageUrl(site, lang, PATHS.home) },
    { name: t.title, url },
  ]),
  itemList(
    GUIDES_DATA.fix.map((guide) => ({
      name: guide.message[lang],
      url: pageUrl(site, lang, PATHS.fixGuide(guide.slug)),
    })),
  ),
]
---

<Page
  lang={lang}
  path={PATHS.fix}
  title={t.meta.title}
  description={t.meta.description}
  jsonLd={jsonLd}
>
  <section class="flex flex-col gap-5 border-b border-rule px-5 pt-8 pb-8 md:gap-[22px] md:px-16 md:pt-12 md:pb-10">
    <nav aria-label={t.breadcrumb} class="text-sm text-ink-3">
      <ol class="m-0 flex list-none flex-wrap items-center gap-2 p-0">
        <li class="flex items-center gap-2">
          <a href={localePath(lang, PATHS.home)} class="text-ink-3 hover:text-brand-ink">
            {STRINGS[lang].home}
          </a>
          <Next size={14} stroke-width={2} aria-hidden="true" class="text-ink-4" />
        </li>
        <li aria-current="page">{t.title}</li>
      </ol>
    </nav>
    <div class="flex max-w-[760px] flex-col gap-3.5">
      <span class="self-start border border-brand-ink px-2.5 py-0.5 text-sm font-semibold text-brand-ink">
        <Bidi text={t.source} lang={lang} />
      </span>
      <h1 class="m-0 text-[36px] leading-[1.15] font-semibold md:text-[56px]">{t.title}</h1>
      <p class="m-0 text-base leading-[1.75] text-ink-2 md:text-[19px] md:leading-[1.8]">
        <Bidi text={t.intro} lang={lang} />
      </p>
    </div>
  </section>

  <div class="flex flex-col gap-12 px-5 pt-8 pb-16 md:px-16 md:pt-10 md:pb-20">
    {groups.map((group) => (
      <section aria-labelledby={`group-${group.status}`} class="flex flex-col gap-5">
        <h2
          id={`group-${group.status}`}
          class="m-0 border-b-2 border-ink pb-4 text-2xl font-semibold md:text-[28px]"
        >
          {t.groups[group.status]}
        </h2>
        <ul class="m-0 grid list-none gap-4 p-0 sm:grid-cols-2 xl:grid-cols-3">
          {group.guides.map((guide) => (
            <li>
              <a
                href={localePath(lang, PATHS.fixGuide(guide.slug))}
                class="group flex h-full flex-col gap-3 border border-rule-strong bg-white p-[22px] hover:border-ink hover:text-ink"
              >
                <span class="flex items-start justify-between gap-3 text-lg leading-snug font-semibold">
                  <span class="min-w-0">
                    <Bidi text={guide.message[lang]} lang={lang} />
                  </span>
                  <Next
                    size={18}
                    stroke-width={2}
                    aria-hidden="true"
                    class="mt-1 shrink-0 text-ink-3 group-hover:text-brand-ink"
                  />
                </span>
                <span
                  lang={other}
                  dir={other === 'ar' ? 'rtl' : 'ltr'}
                  class:list={[
                    'mt-auto text-sm text-ink-3',
                    other === 'en' && 'self-start font-mono',
                  ]}
                >
                  {guide.message[other]}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Page>
