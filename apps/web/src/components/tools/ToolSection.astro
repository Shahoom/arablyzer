---
/**
 * One section of a tool page: its heading (`heading-2`: 22 px on a phone, 28 from lg, no icon in a
 * coloured square before it) and the section's content under it. The tool page template
 * (BUILD-PLAN §6.1) is a run of `<section id>`s, each labelled by its own heading: the audit reads
 * them by their ids.
 */
interface Props {
  id: string
  title: string
}
const { id, title } = Astro.props
---

<section id={id} aria-labelledby={`${id}-title`} class="flex flex-col gap-4 lg:gap-5">
  <h2 id={`${id}-title`} class="heading-2">
    {title}
  </h2>
  <slot />
</section>
