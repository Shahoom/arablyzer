---
/**
 * One section of a tool page: an icon on its tint beside the heading, and the section's content
 * under them. The tool page template (BUILD-PLAN §6.1) is a run of `<section id>`s, each labelled
 * by its own heading: the audit reads them by their ids.
 */
interface Props {
  id: string
  title: string
}
const { id, title } = Astro.props
---

<section id={id} aria-labelledby={`${id}-title`} class="flex flex-col gap-5">
  <div class="flex items-center gap-3.5">
    <span
      aria-hidden="true"
      class="grid size-11 shrink-0 place-items-center rounded-[14px] bg-indigo-soft text-indigo-ink"
    >
      <slot name="icon" />
    </span>
    <h2
      id={`${id}-title`}
      class="m-0 text-[26px] leading-[1.3] font-semibold text-balance md:text-[32px]"
    >
      {title}
    </h2>
  </div>
  <slot />
</section>
