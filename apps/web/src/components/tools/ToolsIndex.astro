---
import { KNOWLEDGE_UI, TOOLS_UI } from '@arablyzer/i18n'
import { breadcrumbList } from '@arablyzer/seo/json-ld'
import { localePath, pageUrl, PATHS, type Lang } from '@arablyzer/seo/site'
import { STRINGS } from '@arablyzer/seo/strings'
import ChevronLeft from '@lucide/astro/icons/chevron-left'
import ChevronRight from '@lucide/astro/icons/chevron-right'
import Search from '@lucide/astro/icons/search'
import Page from '../../layouts/Page.astro'
import { HEAD } from '../../lib/heads'
import { searchable } from '../../lib/search'
import { siteOf } from '../../lib/site'
import { ARABIC_LAYER, CATEGORY_STYLE, toolsByCategory } from '../../lib/tool-data'
import Bidi from '../Bidi.astro'
import PageColumns from '../PageColumns.astro'
import PageHead from '../PageHead.astro'
import ToolCard from './ToolCard.astro'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = TOOLS_UI[lang]
const site = siteOf(Astro.site)
const url = pageUrl(site, lang, PATHS.tools)
const groups = toolsByCategory()
// The Arabic layer first, in the filter as in the list.
const general = groups.filter((group) => !ARABIC_LAYER.has(group.category))
const arabic = groups.filter((group) => ARABIC_LAYER.has(group.category))
const count = groups.reduce((sum, group) => sum + group.tools.length, 0)
// What the search says it shows, for each number of tools it can: the script has no plural rules.
const shown = Array.from({ length: count + 1 }, (_, n) => t.directory.shown(n, count))
const Next = lang === 'ar' ? ChevronLeft : ChevronRight
const jsonLd = [
  breadcrumbList([
    { name: STRINGS[lang].home, url: pageUrl(site, lang, PATHS.home) },
    { name: t.directory.title, url },
  ]),
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: t.directory.title,
    numberOfItems: count,
    itemListElement: groups
      .flatMap((group) => group.tools)
      .map((tool, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: tool.copy[lang].title,
        url: pageUrl(site, lang, PATHS.tool(tool.slug)),
      })),
  },
]
// A category's button in the vertical list of a wide screen: a row that is pressed or not. Forced
// colours drop the tint, so a pressed row is told by an edge, as a pressed chip is.
const row =
  'flex h-9 w-full cursor-pointer items-center gap-3 rounded-lg px-3 text-start text-small text-ink-2 hover:bg-surface-2 hover:text-ink aria-pressed:bg-indigo-soft aria-pressed:text-indigo-ink forced-colors:aria-pressed:border-2 forced-colors:aria-pressed:border-[Highlight]'
---

<Page
  lang={lang}
  path={PATHS.tools}
  title={t.directory.meta.title}
  description={t.directory.meta.description}
  jsonLd={jsonLd}
>
  <PageHead
    lang={lang}
    breadcrumb={{ label: t.page.breadcrumb, current: t.directory.title }}
    title={t.directory.title}
  >
    <Bidi slot="lead" text={t.directory.intro} lang={lang} />
    <div slot="end" class="flex w-full shrink-0 flex-col gap-2 lg:w-[480px]">
      <div
        role="search"
        class="flex h-12 items-center gap-3 rounded-xl border border-field bg-white px-4 focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-indigo"
      >
        <Search size={20} stroke-width={2} aria-hidden="true" class="shrink-0 text-ink-3" />
        <label for="tools-search" class="sr-only">
          {t.directory.search}
        </label>
        <input
          id="tools-search"
          type="search"
          autocomplete="off"
          placeholder={t.directory.searchPlaceholder}
          class="h-full min-w-0 grow border-0 bg-transparent text-body text-ellipsis text-ink outline-none placeholder:text-ink-3 [&::-webkit-search-cancel-button]:hidden"
        />
      </div>
      <p class="m-0 flex flex-wrap items-center justify-between gap-x-4 text-small text-ink-2">
        <span id="tools-count" aria-live="polite" data-shown={JSON.stringify(shown)}>
          {t.directory.count(count)}
        </span>
        <a
          href={localePath(lang, PATHS.knowledge)}
          class="inline-flex min-h-11 items-center gap-2 font-semibold text-brand-ink underline-offset-4 hover:text-ink hover:underline"
        >
          {KNOWLEDGE_UI[lang].searchAll}
          <Next size={16} stroke-width={2} aria-hidden="true" />
        </a>
      </p>
    </div>
  </PageHead>

  {/* The categories come before the list on a phone and stick beside it on a wide screen. The same
      buttons are drawn twice, each for its screen (the other is hidden): below lg a row of chips that
      scrolls sideways, from lg a vertical list with the Arabic layer named. */}
  <PageColumns asideFirst asideAs="div" class:list={[HEAD.bodyTop, 'pb-section']}>
    <Fragment slot="aside">
      <div role="group" aria-labelledby="categories-title" class="flex flex-col gap-3">
        <h2
          id="categories-title"
          class="sr-only lg:not-sr-only lg:m-0 lg:px-3 lg:text-meta lg:font-semibold lg:text-ink-3"
        >
          {t.directory.categories}
        </h2>
        <div class="scroll-row lg:hidden">
          <button type="button" class="chip" aria-pressed="true" data-filter="all">
            {t.directory.all}
          </button>
          {[...arabic, ...general].map((group) => (
            <button type="button" class="chip" aria-pressed="false" data-filter={group.category}>
              <span
                aria-hidden="true"
                class:list={['size-2 shrink-0 rounded-full', CATEGORY_STYLE[group.category].dot]}
              />
              {t.categories[group.category].name}
            </button>
          ))}
        </div>
        <div class="hidden flex-col gap-1 lg:flex">
          <button type="button" class={row} aria-pressed="true" data-filter="all">
            <span class="min-w-0 grow">{t.directory.all}</span>
            <span aria-hidden="true" class="text-meta text-ink-2 tabular-nums">
              {count}
            </span>
          </button>
          {arabic.length > 0 && (
            <p class="m-0 px-3 pt-4 pb-1 text-meta font-semibold text-brand-ink">
              {t.directory.arabicLayer}
            </p>
          )}
          {arabic.map((group) => (
            <button type="button" class={row} aria-pressed="false" data-filter={group.category}>
              <span
                aria-hidden="true"
                class:list={['size-2 shrink-0 rounded-full', CATEGORY_STYLE[group.category].dot]}
              />
              <span class="min-w-0 grow">{t.categories[group.category].name}</span>
              <span aria-hidden="true" class="text-meta text-ink-2 tabular-nums">
                {group.tools.length}
              </span>
            </button>
          ))}
          {arabic.length > 0 && general.length > 0 && (
            <div aria-hidden="true" class="my-2 h-px bg-line" />
          )}
          {general.map((group) => (
            <button type="button" class={row} aria-pressed="false" data-filter={group.category}>
              <span
                aria-hidden="true"
                class:list={['size-2 shrink-0 rounded-full', CATEGORY_STYLE[group.category].dot]}
              />
              <span class="min-w-0 grow">{t.categories[group.category].name}</span>
              <span aria-hidden="true" class="text-meta text-ink-2 tabular-nums">
                {group.tools.length}
              </span>
            </button>
          ))}
        </div>
      </div>
    </Fragment>

    <div id="tools-list" class="flex min-w-0 flex-col gap-8 lg:gap-10">
      {[...arabic, ...general].map((group) => (
        <section
          id={`cat-${group.category}`}
          aria-labelledby={`cat-${group.category}-title`}
          data-category={group.category}
          class="flex flex-col gap-3"
        >
          <div class="flex flex-col gap-1">
            <h2 id={`cat-${group.category}-title`} class="heading-2">
              {t.categories[group.category].name}
            </h2>
            <p class="m-0 max-w-[68ch] text-small text-ink-2 max-md:hidden">
              {t.categories[group.category].blurb}
            </p>
          </div>
          <ul class="tool-rows card m-0 flex list-none flex-col overflow-hidden p-0">
            {group.tools.map((tool) => (
              <li
                data-tool
                data-search={searchable(
                  [tool.slug, tool.copy.ar.title, tool.copy.en.title, tool.copy[lang].summary].join(
                    ' ',
                  ),
                )}
              >
                <ToolCard lang={lang} slug={tool.slug} />
              </li>
            ))}
          </ul>
        </section>
      ))}
      <p id="tools-none" hidden class="empty-state m-0 text-body">
        {t.directory.none}
      </p>
    </div>
  </PageColumns>
</Page>

<style>
  /*
   * A hairline between the rows that are shown. The search hides the rows it does not match, so a
   * border on every row but the last would leave one under the last row left, beside the card's own.
   */
  .tool-rows > li:not([hidden]) ~ li:not([hidden]) {
    border-top: 1px solid var(--color-line);
  }
</style>

<script>
  import { matchesAll, searchWords } from '../../lib/search'

  // The directory's search and its category buttons: rows whose name or line holds every word typed,
  // read as people type Arabic (lib/search.ts), within the category chosen, and the sections they
  // are in. The page works without any of it, every tool listed. A button pressed again lets go of
  // its category; the address keeps the category (#cat-…), as a tool page's breadcrumb names it. The
  // category buttons are drawn twice (a row of chips and a vertical list, one of them hidden by the
  // screen's width), and both are pressed together.
  const input = document.querySelector<HTMLInputElement>('#tools-search')
  const count = document.querySelector<HTMLElement>('#tools-count')
  const none = document.querySelector<HTMLElement>('#tools-none')
  const sections = [...document.querySelectorAll<HTMLElement>('section[data-category]')]
  const chips = [...document.querySelectorAll<HTMLButtonElement>('button[data-filter]')]
  const all = count?.textContent ?? ''
  // What to say for each number of tools shown, in the page's language (TOOLS_UI).
  const said = JSON.parse(count?.dataset.shown ?? '[]') as string[]
  const known = new Set(chips.map((chip) => chip.dataset.filter ?? ''))
  let category = 'all'

  function show() {
    const words = searchWords(input?.value ?? '')
    let shown = 0
    for (const section of sections) {
      const inCategory = category === 'all' || section.dataset.category === category
      let inSection = 0
      for (const card of section.querySelectorAll<HTMLElement>('[data-tool]')) {
        const match = inCategory && matchesAll(card.dataset.search ?? '', words)
        card.hidden = !match
        if (match) inSection++
      }
      section.hidden = inSection === 0
      shown += inSection
    }
    for (const chip of chips) {
      chip.setAttribute('aria-pressed', String((chip.dataset.filter ?? 'all') === category))
    }
    if (none !== null) none.hidden = shown > 0
    if (count !== null) {
      count.textContent = words.length === 0 && category === 'all' ? all : (said[shown] ?? all)
    }
  }

  input?.addEventListener('input', show)
  for (const chip of chips) {
    chip.addEventListener('click', () => {
      const chosen = chip.dataset.filter ?? 'all'
      category = chosen === category ? 'all' : chosen
      const hash = category === 'all' ? '' : `#cat-${category}`
      history.replaceState(null, '', `${window.location.pathname}${window.location.search}${hash}`)
      show()
    })
  }

  // An address with a category (a tool page's breadcrumb, or a shared link) opens with it chosen,
  // and so does one typed over this page's.
  function chosenByAddress(): boolean {
    const named = /^#cat-([a-z-]+)$/.exec(window.location.hash)?.[1]
    category = named !== undefined && known.has(named) ? named : 'all'
    return category !== 'all'
  }
  window.addEventListener('hashchange', () => {
    chosenByAddress()
    show()
  })
  if (chosenByAddress()) {
    show()
    document.querySelector(`#cat-${category}`)?.scrollIntoView()
  }
</script>
