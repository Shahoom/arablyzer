---
import { TOOLS_UI } from '@arablyzer/i18n'
import { breadcrumbList, webApplication } from '@arablyzer/seo/json-ld'
import { localePath, pageUrl, PATHS, type Lang } from '@arablyzer/seo/site'
import { STRINGS } from '@arablyzer/seo/strings'
import Check from '@lucide/astro/icons/check'
import CircleQuestionMark from '@lucide/astro/icons/circle-question-mark'
import FileCode from '@lucide/astro/icons/file-code'
import FlaskConical from '@lucide/astro/icons/flask-conical'
import ListChecks from '@lucide/astro/icons/list-checks'
import Network from '@lucide/astro/icons/network'
import Plus from '@lucide/astro/icons/plus'
import Wrench from '@lucide/astro/icons/wrench'
import X from '@lucide/astro/icons/x'
import HreflangGenerator from '../../islands/generators/HreflangGenerator'
import RobotsTester from '../../islands/generators/RobotsTester'
import SchemaGenerator from '../../islands/generators/SchemaGenerator'
import WhatsAppGenerator from '../../islands/generators/WhatsAppGenerator'
import ToolApp from '../../islands/ToolApp'
import Page from '../../layouts/Page.astro'
import { HEAD } from '../../lib/heads'
import { methodologyHref, scanFormHref, siteOf } from '../../lib/site'
import { CATEGORY_STYLE, TOOLS_DATA, toolData } from '../../lib/tool-data'
import Bidi from '../Bidi.astro'
import Breadcrumb from '../Breadcrumb.astro'
import SeverityPill from '../SeverityPill.astro'
import ToolCard from './ToolCard.astro'
import ToolSection from './ToolSection.astro'

interface Props {
  lang: Lang
  slug: string
}
const { lang, slug } = Astro.props
const tool = toolData(slug)
const copy = tool.copy[lang]
const t = TOOLS_UI[lang]
const headings = TOOLS_DATA.headings[lang]
const site = siteOf(Astro.site)
const path = PATHS.tool(slug)
const url = pageUrl(site, lang, path)
const toolsPath = localePath(lang, PATHS.tools)
const category = t.categories[tool.category].name
const dot = CATEGORY_STYLE[tool.category].dot
const jsonLd = [
  webApplication({ name: copy.title, description: copy.description, url, lang }),
  // From the home page, as the directory's: a search result shows this trail.
  breadcrumbList([
    { name: STRINGS[lang].home, url: pageUrl(site, lang, PATHS.home) },
    { name: t.directory.title, url: pageUrl(site, lang, PATHS.tools) },
    { name: copy.title, url },
  ]),
]
// What the tool's island is given: its name for the pill of its box, and its category's colour.
const boxed = { lang, tool: slug, title: copy.title, dot }
// A question's answer opens and closes (the script below): the heading is a button, the answer
// the panel after it, as the ARIA authoring practices have it. The methodology is the same.
// Its focus ring is drawn inside the button: the card clips whatever is drawn outside it.
const toggle =
  'group flex min-h-[64px] w-full cursor-pointer items-center justify-between gap-4 px-5 py-3 text-start text-[17px] leading-snug font-semibold text-ink focus-visible:outline-offset-[-3px] rounded-[17px] md:px-6'
const plus =
  'grid size-8 shrink-0 place-items-center rounded-[10px] bg-surface-2 text-ink-2 transition-[transform,background-color] duration-200 group-aria-expanded:rotate-45 group-aria-expanded:bg-indigo-soft group-aria-expanded:text-indigo-ink'
const accordion =
  'overflow-hidden rounded-[18px] border border-line bg-white shadow-[0_1px_2px_rgb(16_24_40/0.04)]'
---

<Page
  lang={lang}
  path={path}
  title={`${copy.title} — Arablyzer`}
  description={copy.description}
  jsonLd={jsonLd}
>
  <div class="relative isolate overflow-x-clip border-b border-line">
    {/* The head's tint, with its height capped and its foot faded: the hero grows with the result
        of a scan, and the tint must not follow it down to the notes under the box, whose grey is
        held to 4.5:1 on the plain ground. */}
    <div
      aria-hidden="true"
      class="page-wash max-h-[34rem] [mask-image:linear-gradient(to_bottom,#000_calc(100%-6rem),transparent)]"
    ></div>
    <div class="wrap">
      <div
        class:list={[
          'mx-auto flex w-full max-w-[880px] flex-col gap-5 pb-12 md:gap-6 md:pb-16',
          HEAD.top,
        ]}
      >
        <Breadcrumb
          lang={lang}
          label={t.page.breadcrumb}
          steps={[
            { name: t.directory.title, href: toolsPath },
            { name: category, href: `${toolsPath}#cat-${tool.category}`, dot },
          ]}
          current={copy.title}
        />
        <h1 class={HEAD.page}>
          <Bidi text={copy.title} lang={lang} />
        </h1>
        <p class={HEAD.lead}>
          <Bidi text={copy.description} lang={lang} />
        </p>
        {/* One island per tool, started when the browser is idle or after half a second at most: a
          busy page, such as CI's Chromium, may never be idle, and the tool waits for its island.
          Astro hydrates only islands it can name. */}
        <div class="mt-2 w-full">
          {tool.kind === 'scan' && (
            <ToolApp
              client:idle={{ timeout: 500 }}
              {...boxed}
              reportsOnly={tool.reportsOnly}
              reads={
                tool.renders
                  ? 'render'
                  : tool.tag === 'robots' ||
                      tool.tag === 'dns' ||
                      tool.tag === 'links' ||
                      tool.tag === 'sitemap' ||
                      tool.tag === 'crux'
                    ? tool.tag
                    : 'html'
              }
              readsLabel={t.tags[tool.tag]}
              fullScanHref={scanFormHref(lang)}
            />
          )}
          {slug === 'whatsapp-link-generator' && (
            <WhatsAppGenerator client:idle={{ timeout: 500 }} {...boxed} />
          )}
          {slug === 'hreflang-generator' && (
            <HreflangGenerator client:idle={{ timeout: 500 }} {...boxed} />
          )}
          {slug === 'schema-generator' && (
            <SchemaGenerator client:idle={{ timeout: 500 }} {...boxed} />
          )}
          {slug === 'robots-tester' && <RobotsTester client:idle={{ timeout: 500 }} {...boxed} />}
        </div>
      </div>
    </div>
  </div>

  <div class:list={['wrap pb-20 md:pb-28', HEAD.bodyTop]}>
    <div class="mx-auto flex w-full max-w-[880px] flex-col gap-14 md:gap-[72px]">
      <ToolSection id="checks" title={headings.checks}>
        <ListChecks slot="icon" size={22} stroke-width={1.9} />
        <div class="card p-5 md:p-7">
          <ul class="checks m-0 flex list-none flex-col gap-4 p-0">
            {copy.checks.map((item) => (
              <li class="flex items-start gap-3.5">
                <span
                  aria-hidden="true"
                  class="mt-1 grid size-7 shrink-0 place-items-center rounded-full bg-pass-soft text-pass"
                >
                  <Check size={15} stroke-width={2.6} />
                </span>
                <span
                  class="prose-tool text-base leading-[1.85] text-ink-2 md:text-[17px]"
                  set:html={item}
                />
              </li>
            ))}
          </ul>
        </div>
      </ToolSection>

      <ToolSection id="example" title={headings.example}>
        <FileCode slot="icon" size={22} stroke-width={1.9} />
        <div class="grid gap-4 md:grid-cols-2">
          {(['wrong', 'right'] as const).map((kind) => (
            <figure class="m-0 flex min-w-0 flex-col overflow-hidden rounded-2xl border border-line bg-white shadow">
              <figcaption class="flex items-center px-4 py-3">
                <span class:list={['sev gap-1.5', kind === 'wrong' ? 'sev-serious' : 'sev-pass']}>
                  {kind === 'wrong' ? (
                    <X size={13} stroke-width={2.6} aria-hidden="true" />
                  ) : (
                    <Check size={13} stroke-width={2.6} aria-hidden="true" />
                  )}
                  {headings[kind]}
                </span>
              </figcaption>
              <pre
                dir="ltr"
                tabindex="0"
                class:list={[
                  'ex-code panel-dark m-0 grow overflow-x-auto px-4 py-[18px] text-start font-mono text-[13px] leading-[1.75] text-panel-soft md:text-sm',
                  kind === 'wrong' ? 'ex-wrong' : 'ex-right',
                ]}
                set:html={copy.example[kind].html}
              />
            </figure>
          ))}
        </div>
      </ToolSection>

      <ToolSection id="fix" title={headings.fix}>
        <Wrench slot="icon" size={22} stroke-width={1.9} />
        <div class="card p-5 md:p-7">
          <div
            class="prose-fix prose-tool text-base leading-[1.85] text-ink-2 md:text-[17px]"
            set:html={copy.fix}
          />
        </div>
      </ToolSection>

      <ToolSection id="faq" title={headings.faq}>
        <CircleQuestionMark slot="icon" size={22} stroke-width={1.9} />
        <div class="flex flex-col gap-3">
          {copy.faq.map((entry, index) => (
            <div class={accordion} data-accordion>
              <h3 class="m-0">
                <button
                  type="button"
                  id={`faq-q-${index}`}
                  aria-expanded="true"
                  aria-controls={`faq-a-${index}`}
                  class={toggle}
                >
                  <span set:html={entry.question} />
                  <span aria-hidden="true" class={plus}>
                    <Plus size={16} stroke-width={2.2} />
                  </span>
                </button>
              </h3>
              <div
                id={`faq-a-${index}`}
                class="prose-fix prose-tool px-5 pb-5 text-base leading-[1.85] text-ink-2 md:px-6"
                set:html={entry.answer}
              />
            </div>
          ))}
        </div>
      </ToolSection>

      <ToolSection id="links" title={t.page.runs}>
        <Network slot="icon" size={22} stroke-width={1.9} />
        <div class="card overflow-hidden">
          <ul class="m-0 flex list-none flex-col p-0">
            {tool.rules.map((rule) => (
              <li class="flex flex-wrap items-center gap-x-3 gap-y-2 border-t border-line px-5 py-4 first:border-t-0 md:px-6">
                <code
                  dir="ltr"
                  class="rounded-lg bg-surface-2 px-2 py-0.5 font-mono text-[13px] text-ink-2"
                >
                  {rule.id}
                </code>
                <a
                  href={localePath(lang, PATHS.rule(rule.id))}
                  class="min-w-0 grow text-base leading-[1.6] font-semibold underline decoration-line-2 underline-offset-4 hover:text-brand-ink"
                >
                  <Bidi text={rule.title[lang]} lang={lang} />
                </a>
                <SeverityPill severity={rule.severity} lang={lang} />
              </li>
            ))}
          </ul>
        </div>
        {tool.related.length > 0 && (
          <nav aria-labelledby="near-title" class="flex flex-col gap-4 pt-3">
            <h2 id="near-title" class="m-0 text-xl leading-[1.4] font-semibold">
              {t.page.near}
            </h2>
            <ul class="m-0 grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3">
              {tool.related.map((other) => (
                <li>
                  <ToolCard lang={lang} slug={other} related />
                </li>
              ))}
            </ul>
          </nav>
        )}
      </ToolSection>

      <section id="about" aria-labelledby="about-title">
        <div class={accordion} data-accordion>
          <h2 id="about-title" class="m-0">
            <button
              type="button"
              id="about-toggle"
              aria-expanded="true"
              aria-controls="about-panel"
              class={toggle}
            >
              <span class="flex items-center gap-3.5">
                <span
                  aria-hidden="true"
                  class="grid size-9 shrink-0 place-items-center rounded-xl bg-indigo-soft text-indigo-ink"
                >
                  <FlaskConical size={19} stroke-width={1.9} />
                </span>
                {t.page.measure}
              </span>
              <span aria-hidden="true" class={plus}>
                <Plus size={16} stroke-width={2.2} />
              </span>
            </button>
          </h2>
          <div id="about-panel" class="flex flex-col gap-4 px-5 pb-5 md:px-6 md:pb-6">
            <div
              class="prose-fix prose-tool text-[15px] leading-[1.9] text-ink-2"
              set:html={copy.methodology}
            />
            <p class="m-0 flex flex-wrap items-center gap-x-6 gap-y-2 border-t border-dashed border-line-2 pt-4 text-sm text-ink-2">
              <span>
                {t.page.updated}{' '}
                <time datetime={tool.updated} dir="ltr" class="font-mono">
                  {tool.updated}
                </time>
              </span>
              <a
                href={methodologyHref(lang)}
                class="underline underline-offset-4 hover:text-brand-ink"
              >
                {t.page.methodology}
              </a>
              <a
                href={scanFormHref(lang)}
                class="underline underline-offset-4 hover:text-brand-ink"
              >
                {t.page.fullScan}
              </a>
            </p>
          </div>
        </div>
      </section>
    </div>
  </div>
</Page>

<script>
  // The questions and the methodology start folded and open one by one; without script they stay
  // open, which is why their buttons say they are expanded until this runs.
  for (const button of document.querySelectorAll<HTMLButtonElement>(
    '[data-accordion] button[aria-controls]',
  )) {
    const panel = document.getElementById(button.getAttribute('aria-controls') ?? '')
    if (panel === null) continue
    const show = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open))
      panel.hidden = !open
    }
    show(false)
    button.addEventListener('click', () => {
      show(button.getAttribute('aria-expanded') !== 'true')
    })
  }
</script>

<style>
  /*
   * The example's code is on the dark panel, where the highlighter's colours (made for a light
   * ground, and pinned by test/code.test.ts) do not read: muted text, the wrong example's values
   * and the right example's are redrawn in the panel's own tones, and each value is marked with a
   * tint of its colour, as the artboards mark the line that matters.
   */
  .ex-code :global(.text-ink-3) {
    color: var(--color-panel-dim);
  }
  .ex-wrong :global(.text-serious) {
    color: var(--color-panel-signal);
    background-color: rgb(251 146 60 / 0.16);
    border-radius: 4px;
  }
  .ex-right :global(.text-pass) {
    color: var(--color-panel-pass);
    background-color: rgb(94 234 212 / 0.14);
    border-radius: 4px;
  }
  /* Code in a check: the quiet chip the fix's code has. */
  .checks :global(code) {
    background-color: var(--color-surface-2);
    border-radius: var(--radius-xs);
    padding: 0.05rem 0.35rem;
  }
</style>
