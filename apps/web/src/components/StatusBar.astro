---
import { USER_AGENT } from '@arablyzer/engine/identity'
import { SITE } from '@arablyzer/i18n'
import { RULESET_VERSION } from '@arablyzer/rules/version'
import type { Lang } from '@arablyzer/seo/site'

interface Props {
  lang: Lang
}
const { lang } = Astro.props
// The bot's product token, as sites see it in their logs: "ArablyzerBot/1.0".
const bot = USER_AGENT.split(' ')[0]
---

<aside
  aria-label={SITE[lang].statusBar}
  class="flex min-h-[34px] flex-wrap items-center justify-between gap-x-6 gap-y-1 bg-panel px-5 py-1.5 text-xs text-panel-dim md:px-16"
>
  <span class="flex items-center gap-2.5">
    <span aria-hidden="true" class="size-1.5 bg-panel-pass"></span>
    {SITE[lang].statusBar}
  </span>
  <span dir="ltr" lang="en" class="hidden font-mono tracking-[0.04em] sm:inline">
    LAB-001 · {bot} · rules {RULESET_VERSION}
  </span>
</aside>
