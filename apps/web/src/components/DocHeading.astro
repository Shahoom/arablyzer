---
/**
 * A document section's heading (`heading-2`: 22 px on a phone, 28 from lg) with its number before
 * it, small and quiet: the same <h2> as ever, and its id for the links to it. The number is
 * decoration (the contents list numbers the sections the same way), so it is hidden from a screen
 * reader, and it has no coloured badge: a section does not need an icon to start.
 */
interface Props {
  id: string
  title: string
  number: number
}
const { id, title, number } = Astro.props
---

<div class="flex items-baseline gap-3">
  <span
    aria-hidden="true"
    dir="ltr"
    class="shrink-0 text-small font-semibold text-ink-3 tabular-nums"
  >
    {String(number).padStart(2, '0')}
  </span>
  <h2 id={id} class="heading-2">
    {title}
  </h2>
</div>
