---
import { PAGES_UI } from '@arablyzer/i18n'
import { breadcrumbList, techArticle } from '@arablyzer/seo/json-ld'
import { pageUrl, PATHS, type Lang } from '@arablyzer/seo/site'
import { STRINGS } from '@arablyzer/seo/strings'
import { HEAD } from '../../lib/heads'
import { METHODOLOGY_DATA } from '../../lib/methodology'
import { METHODOLOGY_SOURCE, siteOf } from '../../lib/site'
import DocHeading from '../DocHeading.astro'
import Contents from './Contents.astro'
import DocPage from './DocPage.astro'

// docs/methodology.md on the site (M2.4b): the page the tools, the rules and the reports link to.

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const doc = METHODOLOGY_DATA[lang]
const t = PAGES_UI[lang].methodology
const site = siteOf(Astro.site)
const url = pageUrl(site, lang, PATHS.methodology)
const jsonLd = [
  techArticle({ headline: doc.title, description: doc.description, url, lang }),
  breadcrumbList([
    { name: STRINGS[lang].home, url: pageUrl(site, lang, PATHS.home) },
    { name: doc.title, url },
  ]),
]
const prose = 'prose-fix prose-tool doc-links text-base leading-[1.85] text-ink-2 md:text-[17px]'
---

<DocPage
  lang={lang}
  path={PATHS.methodology}
  title={`${doc.title} — Arablyzer`}
  description={doc.description}
  jsonLd={jsonLd}
  crumb={doc.title}
  breadcrumbLabel={t.breadcrumb}
  asideFirst
>
  <Fragment slot="head">
    <h1 class={HEAD.page}>{doc.title}</h1>
    <p class={HEAD.lead}>{doc.description}</p>
  </Fragment>
  <Contents slot="aside" label={t.contents} sections={doc.sections}>
    <a
      href={METHODOLOGY_SOURCE}
      class="mx-3 mt-2 mb-1 border-t border-dashed border-line-2 pt-3 text-sm text-brand-ink underline underline-offset-4 hover:text-ink"
    >
      {t.source}
    </a>
  </Contents>
  {doc.sections.map((section, index) => (
    <section
      id={section.id}
      aria-labelledby={`${section.id}-title`}
      class="flex scroll-mt-6 flex-col gap-4"
    >
      <DocHeading id={`${section.id}-title`} number={index + 1} title={section.title} />
      <div class={prose} set:html={section.html} />
      {section.parts.map((part) => (
        <div class="flex flex-col gap-3 pt-2">
          <h3 class="m-0 text-xl font-semibold">{part.title}</h3>
          <div class={prose} set:html={part.html} />
        </div>
      ))}
    </section>
  ))}
</DocPage>
