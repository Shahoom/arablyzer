---
import { PAGES_UI, RULES_UI, TOOLS_UI } from '@arablyzer/i18n'
import { breadcrumbList, techArticle } from '@arablyzer/seo/json-ld'
import { localePath, pageUrl, PATHS, type Lang } from '@arablyzer/seo/site'
import { STRINGS } from '@arablyzer/seo/strings'
import { HEAD } from '../../lib/heads'
import { METHODOLOGY_DATA } from '../../lib/methodology'
import { METHODOLOGY_SOURCE, siteOf } from '../../lib/site'
import DocHeading from '../DocHeading.astro'
import Related from '../guides/Related.astro'
import Contents from './Contents.astro'
import DocPage from './DocPage.astro'

// docs/methodology.md on the site (M2.4b): the page the tools, the rules and the reports link to.

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const doc = METHODOLOGY_DATA[lang]
const t = PAGES_UI[lang].methodology
const site = siteOf(Astro.site)
const url = pageUrl(site, lang, PATHS.methodology)
const jsonLd = [
  techArticle({ headline: doc.title, description: doc.description, url, lang }),
  breadcrumbList([
    { name: STRINGS[lang].home, url: pageUrl(site, lang, PATHS.home) },
    { name: doc.title, url },
  ]),
]
// The pages that say what a scan checks, and what fetches the page.
const related = [
  {
    id: 'related-title',
    title: t.related,
    links: [
      { href: localePath(lang, PATHS.rules), title: RULES_UI[lang].library.title },
      { href: localePath(lang, PATHS.bot), title: PAGES_UI[lang].bot.title },
      { href: localePath(lang, PATHS.tools), title: TOOLS_UI[lang].directory.title },
    ],
  },
]
const prose = 'prose-fix prose-tool doc-links text-body text-ink-2'
const source = 'text-small font-semibold text-brand-ink underline underline-offset-4 hover:text-ink'
---

<DocPage
  lang={lang}
  path={PATHS.methodology}
  title={`${doc.title} — Arablyzer`}
  description={doc.description}
  jsonLd={jsonLd}
  crumb={doc.title}
  breadcrumbLabel={t.breadcrumb}
>
  <Fragment slot="head">
    <h1 class={HEAD.page}>{doc.title}</h1>
    <p class={HEAD.lead}>{doc.description}</p>
    <Contents variant="inline" label={t.contents} sections={doc.sections} />
  </Fragment>
  <div slot="aside" class="flex flex-col gap-3">
    <Contents label={t.contents} sections={doc.sections}>
      <a href={METHODOLOGY_SOURCE} class:list={['kb-link mt-1 border-t border-line pt-2', source]}>
        {t.source}
      </a>
    </Contents>
    <Related lang={lang} groups={related} />
  </div>
  {doc.sections.map((section) => (
    <section
      id={section.id}
      aria-labelledby={`${section.id}-title`}
      class="flex scroll-mt-6 flex-col gap-4"
    >
      <DocHeading id={`${section.id}-title`} title={section.title} />
      <div class={prose} set:html={section.html} />
      {section.parts.map((part) => (
        <div class="flex flex-col gap-3 pt-2">
          <h3 class="heading-3 m-0">{part.title}</h3>
          <div class={prose} set:html={part.html} />
        </div>
      ))}
    </section>
  ))}
  {/* On a phone the source link is here, at the foot: the aside's copy is for a desktop. */}
  <p class="m-0 lg:hidden">
    <a href={METHODOLOGY_SOURCE} class={source}>
      {t.source}
    </a>
  </p>
</DocPage>
