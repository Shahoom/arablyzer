---
import { PAGES_UI, RULES_UI, TOOLS_UI } from '@arablyzer/i18n'
import { breadcrumbList } from '@arablyzer/seo/json-ld'
import { localePath, pageUrl, PATHS, type Lang } from '@arablyzer/seo/site'
import { STRINGS } from '@arablyzer/seo/strings'
import { HEAD } from '../../lib/heads'
import { BOT_FACTS } from '../../lib/bot'
import { METHODOLOGY_DATA } from '../../lib/methodology'
import { siteOf } from '../../lib/site'
import DocHeading from '../DocHeading.astro'
import Related from '../guides/Related.astro'
import Rich from '../Rich.astro'
import Contents from './Contents.astro'
import DocPage from './DocPage.astro'

// The bot's page (BUILD-PLAN §13, M2.4b): who it is and what it does, each number the code's own,
// and how a site opts out.

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = PAGES_UI[lang].bot
const site = siteOf(Astro.site)
const url = pageUrl(site, lang, PATHS.bot)
const sections = [
  { id: 'identify', title: t.identify.title },
  { id: 'when', title: t.when.title },
  { id: 'fetches', title: t.fetches.title },
  { id: 'never', title: t.never.title },
  { id: 'opt-out', title: t.optOut.title },
] as const
const jsonLd = [
  breadcrumbList([
    { name: STRINGS[lang].home, url: pageUrl(site, lang, PATHS.home) },
    { name: t.title, url },
  ]),
]
// The pages that say what the bot reads for, and what it is asked to do.
const related = [
  {
    id: 'related-title',
    title: t.related,
    links: [
      {
        href: localePath(lang, PATHS.methodology),
        title: METHODOLOGY_DATA[lang].title,
      },
      { href: localePath(lang, PATHS.rules), title: RULES_UI[lang].library.title },
      { href: localePath(lang, PATHS.tools), title: TOOLS_UI[lang].directory.title },
    ],
  },
]
const text = 'm-0 text-body text-ink-2'
const list = 'm-0 flex flex-col gap-3 ps-5 text-body text-ink-2 marker:text-ink-3'
// A block of code, as the rules' pages set theirs: dark, left to right, scrolling inside itself and
// reachable by keyboard when it must.
const code =
  'm-0 overflow-x-auto rounded-card bg-navy px-4 py-3 text-start font-mono text-meta text-panel-soft md:text-small'
---

<DocPage
  lang={lang}
  path={PATHS.bot}
  title={t.meta.title}
  description={t.meta.description}
  jsonLd={jsonLd}
  crumb="ArablyzerBot"
  breadcrumbLabel={t.breadcrumb}
>
  <Fragment slot="head">
    <h1 class={HEAD.page}>
      <Rich text={t.title} lang={lang} />
    </h1>
    <p class={HEAD.lead}>
      <Rich text={t.intro} lang={lang} />
    </p>
    <Contents variant="inline" label={t.contents} sections={sections} />
  </Fragment>
  <div slot="aside" class="flex flex-col gap-3">
    <Contents label={t.contents} sections={sections} />
    <Related lang={lang} groups={related} />
  </div>

  <section id="identify" aria-labelledby="identify-title" class="flex scroll-mt-6 flex-col gap-4">
    <DocHeading id="identify-title" title={t.identify.title} />
    <p class={text}>{t.identify.lead}</p>
    <pre dir="ltr" tabindex="0" class={code}>{BOT_FACTS.userAgent}</pre>
    <p class={text}>{t.identify.browsers}</p>
    <pre dir="ltr" tabindex="0" class={code}>… {BOT_FACTS.browserToken}</pre>
  </section>

  <section id="when" aria-labelledby="when-title" class="flex scroll-mt-6 flex-col gap-4">
    <DocHeading id="when-title" title={t.when.title} />
    <ul class={list}>
      {t.when.items.map((item) => (
        <li>
          <Rich text={item} lang={lang} />
        </li>
      ))}
    </ul>
  </section>

  <section id="fetches" aria-labelledby="fetches-title" class="flex scroll-mt-6 flex-col gap-4">
    <DocHeading id="fetches-title" title={t.fetches.title} />
    <ol class:list={[list, 'list-decimal']}>
      {t.fetches.items(BOT_FACTS).map((item) => (
        <li>
          <Rich text={item} lang={lang} />
        </li>
      ))}
    </ol>
  </section>

  <section id="never" aria-labelledby="never-title" class="flex scroll-mt-6 flex-col gap-4">
    <DocHeading id="never-title" title={t.never.title} />
    <ul class={list}>
      {t.never.items.map((item) => (
        <li>
          <Rich text={item} lang={lang} />
        </li>
      ))}
    </ul>
  </section>

  <section id="opt-out" aria-labelledby="opt-out-title" class="flex scroll-mt-6 flex-col gap-4">
    <DocHeading id="opt-out-title" title={t.optOut.title} />
    <p class={text}>{t.optOut.lead}</p>
    <pre dir="ltr" tabindex="0" class={code}>User-agent: ArablyzerBot
Disallow: /</pre>
    <p class={text}>{t.optOut.paths}</p>
    <pre dir="ltr" tabindex="0" class={code}>User-agent: ArablyzerBot
Disallow: /account/
Disallow: /checkout/</pre>
    <ul class={list}>
      {t.optOut.notes.map((note) => (
        <li>
          <Rich text={note} lang={lang} />
        </li>
      ))}
    </ul>
  </section>
</DocPage>
