---
import type { JsonLd } from '@arablyzer/seo/json-ld'
import type { Lang } from '@arablyzer/seo/site'
import { HEAD } from '../../lib/heads'
import Page from '../../layouts/Page.astro'
import Breadcrumb from '../Breadcrumb.astro'

/**
 * A page that is a document (the methodology, the bot's page, a fix guide, a glossary term): the
 * trail and its heading (slot "head") over the tint of a page's head, then its sections in eight
 * of the design's twelve columns beside the aside (slot "aside"), which stays in view on a wide
 * screen. On a narrow one the aside comes after the sections, as links to more do, or before
 * them (`asideFirst`), as a page's contents do.
 */
interface Props {
  lang: Lang
  path: string
  title: string
  description: string
  jsonLd: readonly JsonLd[]
  /** The breadcrumb's last step, this page. */
  crumb: string
  breadcrumbLabel: string
  /** A step between the home page and this one: the page's section, such as the glossary. */
  parent?: { readonly name: string; readonly href: string }
  asideFirst?: boolean
}
const {
  lang,
  path,
  title,
  description,
  jsonLd,
  crumb,
  breadcrumbLabel,
  parent,
  asideFirst = false,
} = Astro.props
const aside = 'min-w-0 lg:sticky lg:top-24'
// On a wide screen the sections are the first column whichever comes first in the page.
const main = 'flex min-w-0 flex-col gap-12 md:gap-14 lg:order-first'
---

<Page lang={lang} path={path} title={title} description={description} jsonLd={jsonLd}>
  <section class="relative isolate border-b border-line">
    <div aria-hidden="true" class="page-wash"></div>
    <div class:list={['wrap flex flex-col gap-5 md:gap-6', HEAD.padding]}>
      <Breadcrumb
        lang={lang}
        label={breadcrumbLabel}
        steps={parent === undefined ? [] : [parent]}
        current={crumb}
      />
      <slot name="head" />
    </div>
  </section>
  <div
    class:list={[
      'wrap grid gap-10 pb-16 md:pb-24 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)] lg:items-start lg:gap-x-14',
      HEAD.bodyTop,
    ]}
  >
    {asideFirst ? (
      <>
        <aside class={aside}>
          <slot name="aside" />
        </aside>
        <div class={main}>
          <slot />
        </div>
      </>
    ) : (
      <>
        <div class={main}>
          <slot />
        </div>
        <aside class={aside}>
          <slot name="aside" />
        </aside>
      </>
    )}
  </div>
</Page>
