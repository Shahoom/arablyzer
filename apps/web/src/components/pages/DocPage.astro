---
import type { FeedLink, OpenGraph } from '@arablyzer/seo/head'
import type { JsonLd } from '@arablyzer/seo/json-ld'
import type { Lang } from '@arablyzer/seo/site'
import { HEAD } from '../../lib/heads'
import Page from '../../layouts/Page.astro'
import Breadcrumb from '../Breadcrumb.astro'
import PageBand from '../PageBand.astro'
import PageColumns from '../PageColumns.astro'

/**
 * A page that is a document (the methodology, the bot's page, a fix guide, a glossary term): the
 * trail and its heading (slot "head") on a white band, then its sections in
 * the main column of a PageColumns (760 px at the most) beside the aside (slot "aside"), which
 * stays in view on a wide screen. On a narrow one the aside comes after the sections, as links to
 * more do, or before them (`asideFirst`), as a page's contents do. This is the first page kind on
 * PageColumns (M2.6 R7a).
 */
interface Props {
  lang: Lang
  path: string
  title: string
  description: string
  jsonLd: readonly JsonLd[]
  /** The breadcrumb's last step, this page. */
  crumb: string
  breadcrumbLabel: string
  /** A step between the home page and this one: the page's section, such as the glossary. */
  parent?: { readonly name: string; readonly href: string }
  asideFirst?: boolean
  /** An article: the reading column (PageColumns' `reading`). */
  reading?: boolean
  /** What an article adds to its head (Page.astro): the languages it is in and its dates. */
  langs?: readonly Lang[]
  switchPath?: string
  article?: OpenGraph['article']
  feeds?: readonly FeedLink[]
}
const {
  lang,
  path,
  title,
  description,
  jsonLd,
  crumb,
  breadcrumbLabel,
  parent,
  asideFirst = false,
  reading = false,
  langs,
  switchPath,
  article,
  feeds,
} = Astro.props
---

<Page
  lang={lang}
  path={path}
  title={title}
  description={description}
  jsonLd={jsonLd}
  langs={langs}
  switchPath={switchPath}
  article={article}
  feeds={feeds}
>
  <PageBand>
    <Breadcrumb
      lang={lang}
      label={breadcrumbLabel}
      steps={parent === undefined ? [] : [parent]}
      current={crumb}
    />
    <slot name="head" />
  </PageBand>
  <PageColumns asideFirst={asideFirst} reading={reading} class:list={[HEAD.bodyTop, 'pb-section']}>
    <Fragment slot="aside">
      <slot name="aside" />
    </Fragment>
    <div class="flex flex-col gap-section">
      <slot />
    </div>
  </PageColumns>
</Page>
