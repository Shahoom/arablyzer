---
import { KNOWLEDGE_UI, PAGES_UI } from '@arablyzer/i18n'
import { localePath, PATHS, type Lang } from '@arablyzer/seo/site'
import Search from '@lucide/astro/icons/search'
import Page from '../../layouts/Page.astro'
import { HEAD } from '../../lib/heads'
import { scanFormHref } from '../../lib/site'
import Forward from '../Forward.astro'

// The page for an address that has none (M2.4b): Caddy serves it with the 404 status, the English
// one under /en/. Never indexed, and naming no canonical page, since it answers every such address.

interface Props {
  lang: Lang
}
const { lang } = Astro.props
const t = PAGES_UI[lang].notFound
const k = KNOWLEDGE_UI[lang]
const links = [
  { href: localePath(lang, PATHS.home), label: t.links.home },
  { href: localePath(lang, PATHS.tools), label: t.links.tools },
  { href: localePath(lang, PATHS.rules), label: t.links.rules },
  { href: scanFormHref(lang), label: t.links.scan },
]
---

<Page
  lang={lang}
  path={PATHS.home}
  title={`${t.title} — Arablyzer`}
  description={t.text}
  noindex
>
  <section class="relative isolate">
    <div aria-hidden="true" class="page-wash"></div>
    <div class="wrap flex flex-col items-center gap-6 pt-14 pb-20 text-center md:pt-24 md:pb-32">
      <span
        dir="ltr"
        class="gradient-text text-[96px] leading-none font-semibold tabular-nums md:text-[168px]"
      >
        404
      </span>
      <h1 class={HEAD.page}>{t.title}</h1>
      <p class="m-0 max-w-[640px] text-base leading-[1.85] text-ink-2 md:text-[19px]">{t.text}</p>
      <ul class="m-0 grid w-full max-w-[720px] list-none gap-3 p-0 text-start sm:grid-cols-2">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class="card card-lift flex items-center justify-between gap-3 px-5 py-4 text-base font-semibold text-ink hover:text-brand-ink"
            >
              {link.label}
              <Forward lang={lang} size={16} />
            </a>
          </li>
        ))}
      </ul>
      {/* The knowledge hub reads ?q=: the visitor's words go there when this page has no answer. */}
      <form
        action={localePath(lang, PATHS.knowledge)}
        method="get"
        role="search"
        class="flex w-full max-w-[720px] flex-col gap-2 text-start"
      >
        <label for="not-found-search" class="text-sm font-semibold text-ink-2">
          {k.search.label}
        </label>
        <div class="flex flex-col gap-2 sm:flex-row">
          <div class="flex h-14 min-w-0 grow items-center gap-3 rounded-2xl border border-field bg-white px-4 shadow focus-within:border-indigo focus-within:ring-4 focus-within:ring-indigo/15">
            <Search size={20} stroke-width={2} aria-hidden="true" class="shrink-0 text-ink-3" />
            <input
              id="not-found-search"
              name="q"
              type="search"
              autocomplete="off"
              placeholder={k.search.placeholder}
              class="h-full min-w-0 grow border-0 bg-transparent text-base text-ink outline-none placeholder:text-ink-3 md:text-[17px] [&::-webkit-search-cancel-button]:hidden"
            />
          </div>
          <button type="submit" class="btn-grad btn-lg">
            {k.search.submit}
          </button>
        </div>
      </form>
    </div>
  </section>
</Page>
