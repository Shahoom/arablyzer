---
import { SITE } from '@arablyzer/i18n'
import { renderHead } from '@arablyzer/seo/head'
import type { JsonLd } from '@arablyzer/seo/json-ld'
import { alternates, localePath, pageUrl, type Lang } from '@arablyzer/seo/site'
import { ogImagePath } from '@arablyzer/seo/sitemap'
import { Font } from 'astro:assets'
import SiteFooter from '../components/SiteFooter.astro'
import SiteHeader from '../components/SiteHeader.astro'
import { OG_HEIGHT, OG_WIDTH } from '../lib/og'
import { dirOf, siteOf } from '../lib/site'
import '../styles/global.css'

interface Props {
  lang: Lang
  /** The page's path, as PATHS gives it; the English one is derived from it. */
  path: string
  title: string
  description: string
  jsonLd?: readonly JsonLd[]
  /**
   * A user's report (/r/{id}): never indexed, and naming no canonical page or alternates, since
   * the same page serves every report (BUILD-PLAN §6.5). Links to it in the other language keep
   * the report's ID.
   */
  report?: boolean
  /**
   * A page search engines must not index, which names no canonical or alternates: the page for
   * an address that has none (404), served at every such address.
   */
  noindex?: boolean
}
const { lang, path, title, description, jsonLd = [], report = false, noindex = false } = Astro.props
const site = siteOf(Astro.site)
const url = pageUrl(site, lang, path)
// One source for <head>, shared with the templates the self-audit has checked since Phase 0.
// A report is never indexed, but its link is shared: its preview has the report page's title.
// Drawn for each page by the build (scripts/og-images.ts); the 404 page, never shared, has none.
const image = {
  url: `${site.origin}${ogImagePath(localePath(lang, path))}`,
  alt: title,
  width: OG_WIDTH,
  height: OG_HEIGHT,
}
const head =
  report || noindex
    ? renderHead({
        title,
        description,
        robots: 'noindex, nofollow',
        openGraph: report ? { title, description, image } : { title, description },
      })
    : renderHead({
        title,
        description,
        canonical: url,
        alternates: alternates(site, path),
        jsonLd,
        openGraph: { title, description, url, image },
      })
---

<!doctype html>
<html lang={lang} dir={dirOf(lang)}>
  <head>
    <Fragment set:html={head} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#007D88" />
    {/* Every page preloads the two weights of DM Sans it opens with, and an Arabic page the two of
        Plex Arabic too. An Arabic page draws the Latin letters of a heading, a lead or a tag in DM
        Sans, which, not preloaded, arrives after the first paint: the text re-wraps and moves the
        page under it (a glossary term 0.08 to 0.10 of layout shift, a guide 0.16, M2.6 R5; the home
        page and the tools 0.0004 to 0.005, R6). Two small files (14 KB each) against that. */}
    <Font
      cssVariable="--font-dm-sans"
      preload={[
        { subset: 'latin', weight: 600 },
        { subset: 'latin', weight: 400 },
      ]}
    />
    <Font
      cssVariable="--font-plex-arabic"
      preload={
        lang === 'ar'
          ? [
              { subset: 'arabic', weight: 600 },
              { subset: 'arabic', weight: 400 },
            ]
          : false
      }
    />
    <Font cssVariable="--font-plex-mono" />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only z-50 rounded-md bg-ink px-4 py-2 text-white focus:not-sr-only focus:absolute focus:start-4 focus:top-4"
    >
      {SITE[lang].skipToContent}
    </a>
    <SiteHeader lang={lang} path={path} keepId={report} />
    <main id="main" class="flex flex-col">
      <slot />
    </main>
    <SiteFooter lang={lang} path={path} keepId={report} />
    {report && <script>
      // The same report in the other language: /r/{id} and /en/r/{id}.
      const id = window.location.pathname.split('/').filter(Boolean).at(-1) ?? ''
      if (/^[A-Za-z0-9_-]{22}$/.test(id)) {
        for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-keep-id]')) {
          link.href = `${link.getAttribute('href') ?? ''}${id}`
        }
      }
    </script>}
  </body>
</html>
