node_modules/
dist/
coverage/
.turbo/
*.log
.DS_Store
.env
.env.*
!.env.example
# What the golden run keeps when a report differs (README).
golden-actual/
# Astro writes its generated types here (apps/web).
.astro/
# What apps/web/scripts/generate.ts writes before Astro runs.
apps/web/src/generated/
# TLS certificate and key for the VPS proxy (infra/compose.vps.yaml): never in git.
infra/certs/
# The GitHub Action runs its committed bundle (M5.2); CI checks that it is up to date.
!integrations/github-action/dist/
# What `pnpm ext:build` writes next to dist/ (M5.2): the zip for the Chrome Web Store.
integrations/chrome-extension/*.zip
__pycache__/
*.pyc
.pytest_cache/
