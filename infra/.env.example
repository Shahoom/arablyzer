# Copy to infra/.env and fill in; infra/.env stays out of git and out of the images.
# `openssl rand -base64 33` makes a good secret.

# The site's address, as visitors reach it. Turnstile's answer must name its host.
ARABLYZER_SITE=https://arablyzer.example
# The host's port the site's server listens on (the host's own proxy terminates TLS in front).
ARABLYZER_PORT=8080

# Cloudflare Turnstile. Cloudflare's test keys, which always pass, suit a local run:
# site key 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA, with
# ARABLYZER_SITE=https://example.com, the host their answer names (measured 2026-09-28); the
# pages are still served on ARABLYZER_PORT, only their canonical links name example.com.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# The limits: the owner's decision (Phase 2 design §7.2); the API will not start without them.
ARABLYZER_LIMIT_CONNECTION_SCANS=
ARABLYZER_LIMIT_CONNECTION_SECONDS=
ARABLYZER_LIMIT_HOST_SCANS=
ARABLYZER_LIMIT_HOST_SECONDS=
ARABLYZER_LIMIT_QUEUE=

# Secrets of the stack itself.
ARABLYZER_LIMIT_SECRET=
ARABLYZER_SCANNER_TOKEN=
VALKEY_PASSWORD=
POSTGRES_PASSWORD=

# The server's own public address, as a CIDR (203.0.113.7/32), and any other range to refuse:
# comma-separated. The egress proxy, the API and the scanner refuse them (BUILD-PLAN §18.3.1).
ARABLYZER_DENY_CIDRS=

# Optional: fewer engines (ARABLYZER_ENGINES=chromium,firefox), and a CrUX API key.
ARABLYZER_ENGINES=
ARABLYZER_CRUX_KEY=
