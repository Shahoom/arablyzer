# Copy to infra/.env and fill in; infra/.env stays out of git and out of the images.
# `openssl rand -hex 32` makes a good secret: each service refuses one shorter than 32 characters.
# Hex, not `openssl rand -base64`: the passwords go into connection URLs (redis://, postgres://),
# and one base64 secret in three holds a `/`, which no URL reads (the service then refuses to
# start, naming the variable; it never prints the URL, whose password would be in the log).

# Sections: 1 REQUIRED (the site, Turnstile, the limits, secrets, the server's own addresses), 2 OPTIONAL
# (empty: the feature is off or skipped, with a notice), 3 GATED (cost or terms: leave empty unless you
# accept them), 4 staging on one VPS (docs/deploy/staging.md). The stack starts only with section 1 complete:
# `docker compose config` names the first variable that is missing.

# ==================================================================================================
# 1. REQUIRED
# ==================================================================================================

# The site's address, as visitors reach it. Turnstile's answer must name its host, and a scan
# request's Origin must be exactly this address.
ARABLYZER_SITE=https://arablyzer.example
# Where the site's server listens on the host: loopback, so that only the host's own proxy, which
# terminates TLS in front of it, reaches it.
ARABLYZER_BIND=127.0.0.1
ARABLYZER_PORT=8080
# Whose X-Forwarded-For the site's server believes, read right to left to the visitor's address:
# ranges separated by spaces; private_ranges when empty. Name the host proxy's address. Behind
# Cloudflare, add its published ranges (https://www.cloudflare.com/ips/): otherwise every visitor
# who comes through one of its addresses shares that address's limit.
ARABLYZER_TRUSTED_PROXIES=

# Cloudflare Turnstile: the widget's site key (public, built into the pages) and its secret, made
# in the Cloudflare dashboard for the host ARABLYZER_SITE names; a local run can make a widget
# for localhost. The scan form's widget sets the action `scan`, which the API asks Cloudflare's
# answer to name. Cloudflare's test keys (site key 1x00000000000000000000AA, secret
# 1x0000000000000000000000000000000AA) pass every token, so the API refuses them here: it runs
# as production whatever NODE_ENV says. Only the end-to-end stack takes them, with
# ARABLYZER_SITE=https://example.com, the host their answer names (measured 2026-09-28): its
# compose.e2e.yaml sets ARABLYZER_ALLOW_TURNSTILE_TEST_KEYS, which this file never passes on.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ==================================================================================================
# 2. OPTIONAL: Google signals and other keys (empty: the check is skipped, with a notice)
# ==================================================================================================

# Google Search Console, "Connect Search Console" on a finished report: an OAuth 2.0 client of type
# "Web application" in Google Cloud, with the Search Console API and the Search Console URL
# Inspection API enabled, the scope https://www.googleapis.com/auth/webmasters.readonly, and the
# authorized redirect URI <ARABLYZER_SITE>/api/gsc/callback (exactly: the origin is ARABLYZER_SITE
# above). Both set, or neither: with neither, the button is not shown. Read-only, an online token
# used once and thrown away; nothing of the user's Search Console data is stored. Until Google
# verifies the app, only the consent screen's test users can connect (docs/design/plans/google-signals.md).
ARABLYZER_GSC_CLIENT_ID=
ARABLYZER_GSC_CLIENT_SECRET=

# Accounts (M4.1): optional sign-in with Google ("Sign in with Google" and One Tap), no password. Off
# unless ARABLYZER_ACCOUNTS=on; the site and the API work as before without it, and nothing is stored
# of anyone who does not sign in. An OAuth 2.0 client of type "Web application" in Google Cloud, with
# the scopes openid, email and profile only, and
#   Authorized JavaScript origins   <ARABLYZER_SITE> (One Tap and the button need it)
#   Authorized redirect URI         <ARABLYZER_SITE>/api/auth/callback/google
# (add http://127.0.0.1:8080 and its callback for a local run). The id is public: it goes into the
# pages when the site is built (compose passes it as PUBLIC_AUTH_GOOGLE_CLIENT_ID), so set it before
# `docker compose build`. On, the API refuses to start without the three below, the limits, and the
# egress proxy for its calls to Google. The names are not Search Console's even if one client serves both.
ARABLYZER_ACCOUNTS=off
ARABLYZER_AUTH_GOOGLE_CLIENT_ID=
ARABLYZER_AUTH_GOOGLE_CLIENT_SECRET=
# At least 32 characters: `openssl rand -hex 32`. Signs the session cookie; changing it signs everyone out.
BETTER_AUTH_SECRET=
# The sign-in limit: the requests one visitor may make to the sign-in routes in the window, valid or not.
ARABLYZER_LIMIT_SIGNIN_REQUESTS=
ARABLYZER_LIMIT_SIGNIN_SECONDS=
# The free account's numbers (M4.2; the owner's, Phase 4 design §2.4), all five required with accounts
# on. A signed-in person's scans take their own bucket (SCANS in SCAN_SECONDS), never below the anonymous
# visitor's, and they skip Turnstile; INFLIGHT is the scans queued or running at once; SAVED_SITES the
# sites they may save; HISTORY_DAYS how long their scans and reports are kept before the sweep deletes them.
ARABLYZER_PLAN_ACCOUNT_SCANS=
ARABLYZER_PLAN_ACCOUNT_SCAN_SECONDS=
ARABLYZER_PLAN_ACCOUNT_INFLIGHT=
ARABLYZER_PLAN_ACCOUNT_SAVED_SITES=
ARABLYZER_PLAN_ACCOUNT_HISTORY_DAYS=
# The owner's recommended numbers for the free account (2026-10): 5 scans a day, one at a time, 3 saved
# sites, history kept 5 days. Set exactly these to start with:
#   ARABLYZER_PLAN_ACCOUNT_SCANS=5            ARABLYZER_PLAN_ACCOUNT_SCAN_SECONDS=86400
#   ARABLYZER_PLAN_ACCOUNT_INFLIGHT=1         ARABLYZER_PLAN_ACCOUNT_SAVED_SITES=3
#   ARABLYZER_PLAN_ACCOUNT_HISTORY_DAYS=5
# The API refuses to start if the free account gets less than an anonymous visitor (ARABLYZER_LIMIT_CONNECTION_*
# and ARABLYZER_LIMIT_INFLIGHT below must not be above these), so set the visitor's limits first.
# Monitoring (M4.3): weekly, one site, the owner's numbers (Phase 4 design §3). Both optional: empty means 1
# site every 7 days. A paid plan will read the same names with its own prefix.
ARABLYZER_PLAN_ACCOUNT_MONITORED_SITES=
ARABLYZER_PLAN_ACCOUNT_MONITOR_EVERY_DAYS=
# Deep crawl (M4.5): pages one crawl checks (empty is 50), the pause between two pages in ms (empty is 1000),
# pages scanned in the browsers per template (empty is 1) and how many templates get any (empty is 10).
ARABLYZER_PLAN_ACCOUNT_CRAWL_PAGES=
ARABLYZER_CRAWL_DELAY_MS=
ARABLYZER_CRAWL_REPRESENTATIVES=
ARABLYZER_CRAWL_RENDERED_TEMPLATES=
# Alerts are sent to a webhook the person pastes (Slack, Discord or generic JSON, signed with HMAC-SHA256,
# through the egress proxy). Email waits for a provider: unset keeps it off, and any value is refused until
# one is built.
ARABLYZER_MAIL_PROVIDER=

# ==================================================================================================
# 1 (continued). REQUIRED: the limits, retention and the stack's own secrets
# ==================================================================================================

# The limits: the owner's decision (Phase 2 design §7.2); the API will not start without them.
# A visitor is an IPv4 address, or an IPv6 address's /48; a network is an IPv6 /32.
#   CONNECTION   the scans one visitor may start in the window
#   NETWORK      the scans one IPv6 network (a /32) may start in the window, all its visitors together
#   ATTEMPT      the requests one visitor may make to start a scan, valid or not: counted before
#                Turnstile is asked, so it is larger than CONNECTION
#   HOST         the scans of one site, by everyone together: of the site a scan is asked for, and
#                of the site it ends at after its redirects (the worker counts that one too)
#   QUEUE        the scans waiting; past it, new ones are refused
#   INFLIGHT     the scans one visitor may have queued or running at once
ARABLYZER_LIMIT_CONNECTION_SCANS=
ARABLYZER_LIMIT_CONNECTION_SECONDS=
ARABLYZER_LIMIT_NETWORK_SCANS=
ARABLYZER_LIMIT_NETWORK_SECONDS=
ARABLYZER_LIMIT_ATTEMPT_REQUESTS=
ARABLYZER_LIMIT_ATTEMPT_SECONDS=
ARABLYZER_LIMIT_HOST_SCANS=
ARABLYZER_LIMIT_HOST_SECONDS=
ARABLYZER_LIMIT_QUEUE=
ARABLYZER_LIMIT_INFLIGHT=

# How many days reports, and the scans they belong to, are kept: the owner's number (issue #33), with
# no default. Set, the worker deletes what is older, every hour. Empty, nothing is deleted by age,
# and the worker says so in its log when it starts; a report is still deleted by whoever holds
# its deletion token (DELETE /api/reports/:id).
ARABLYZER_REPORT_RETENTION_DAYS=

# Secrets of the stack itself.
ARABLYZER_LIMIT_SECRET=
ARABLYZER_SCANNER_TOKEN=
# What the site's server shows the API with every request: the API believes the visitor's address
# in X-Forwarded-For only from a request that carries it.
ARABLYZER_PROXY_SECRET=
# The password of Valkey's one user, `arablyzer` (its default user is off): the queue, the events and
# the limits. It is written to the server's settings as a hash, in memory, not put on its command line.
VALKEY_PASSWORD=
# PostgreSQL's bootstrap user (a superuser), which only the `migrate` step connects as, once, before
# the API and the worker start: it makes the roles and the tables, and sets the next password.
POSTGRES_PASSWORD=
# The password of arablyzer_app, the role the API and the worker connect as: it reads, writes and
# deletes scans and can change nothing else. Set on every deploy, so changing it here rotates it.
POSTGRES_APP_PASSWORD=
# The password of arablyzer_worker, the worker's role: it reads, updates and deletes scans and cannot
# read the accounts tables at all (M4.1). Set on every deploy, like the one above.
POSTGRES_WORKER_PASSWORD=

# Required: the server's own public addresses, each as a CIDR, and any other range to refuse,
# comma-separated: 203.0.113.7/32 for an IPv4 address, and 2001:db8::7/128 for its IPv6 address (or
# its /64), if it has one: a name can point at either, and would reach the server's own services.
# The egress proxy, the API and the scanner refuse them (BUILD-PLAN §18.3.1); neither Compose nor
# the egress proxy starts without it, and each says what the list leaves open (no IPv6 range). An
# address is written out in full: no `203.0.113/24`, no zone, and IPv4 not as ::ffff:a.b.c.d. Behind
# NAT the server does not see its public address on any interface: take it from the provider. The
# end-to-end test's stack uses 93.184.215.61/32, an address of its test network that nothing holds
# (compose.e2e.yaml), and an IPv6 one; infra/verify-deploy.ts checks the host's own addresses.
ARABLYZER_DENY_CIDRS=

# ==================================================================================================
# 2 (continued). OPTIONAL: engines and keys (empty: the check is skipped, with a notice)
# ==================================================================================================

# Optional: fewer engines (ARABLYZER_ENGINES=chromium,firefox; `chromium` alone is the smallest scanner,
# for a small shared server: docs/deploy/staging.md, section 2.3), and a CrUX API key. The key lives
# in the scanner's environment, which a browser that a page took over could read: restrict it, in
# Google Cloud, to the Chrome UX Report API.
ARABLYZER_ENGINES=
ARABLYZER_CRUX_KEY=
# Optional: a Google Safe Browsing API key for the check of the scanned page against Google's
# threat lists. Empty: the CrUX key above is used when it is set (one Google Cloud key may allow
# both APIs), and the check is skipped, with a notice, when neither is. Restrict it to the Safe
# Browsing API.
ARABLYZER_SAFE_BROWSING_KEY=
# Optional: a Knowledge Graph Search API key, for the check of the site's brand in Google's
# Knowledge Graph (the brand's name goes to Google). Empty: the CrUX key above is used when it is
# set, and the check is skipped, with a notice, when neither is.
ARABLYZER_KG_KEY=
# Optional: an Open PageRank API key (openpagerank.keywordseverywhere.com, free tier 30,000 domains a
# month; its data is Common Crawl's web graph), for the domain's authority, 0 to 10, with its trend
# and referring domains, in the report's header. The page's domain goes to Open PageRank. Empty: the check is
# skipped, with a notice.
ARABLYZER_OPR_KEY=
# ==================================================================================================
# 3. GATED: turned on by the owner's word (a third party's terms, or a cost per scan)
# ==================================================================================================

# Optional: 1 turns on the common search misspellings tool, which asks Google's public suggestion
# endpoint (suggestqueries.google.com) for at most 12 completions a scan, one at a time, as
# ArablyzerBot, cached for a day. That endpoint is not documented for automated use and Google's
# terms do not cover it: leave this empty unless you accept that. Empty: the tool says it is off.
ARABLYZER_SUGGEST=
# Optional: keys for the AI visibility tool, which asks each assistant that has a key 4 Arabic
# questions made from the scanned page (with its web search on, at most 600 tokens of answer each)
# and records whether the brand or domain is mentioned or cited. The page's brand, topic and country
# go to the provider. Cost per scan: about 4 requests for each key (docs/design/plans/arabic-native.md
# section 13). Empty: the tool says it is off and sends nothing. Optionally ARABLYZER_OPENAI_MODEL,
# ARABLYZER_GEMINI_MODEL and ARABLYZER_ANTHROPIC_MODEL change the model ids.
ARABLYZER_OPENAI_KEY=
ARABLYZER_GEMINI_KEY=
ARABLYZER_PERPLEXITY_KEY=
ARABLYZER_ANTHROPIC_KEY=
ARABLYZER_OPENAI_MODEL=
ARABLYZER_GEMINI_MODEL=
ARABLYZER_ANTHROPIC_MODEL=
# Optional: BigQuery, for the per-country Chrome UX tool (the CrUX API has no country dimension; the
# data is in BigQuery as chrome-ux-report.country_<cc>.<yyyymm>). A Google Cloud service account's JSON
# key (or base64 of it) with the BigQuery Job User role, and the project that pays for the queries; set both
# or neither. Each scan reads the nine Arab countries' tables once for the origin, after a free dry run,
# and BigQuery refuses to bill more than ARABLYZER_BIGQUERY_MAX_BYTES (default 21474836480, 20 GiB).
# The first dry run in the tool's notice tells the real size; see docs/design/plans/arabic-native.md section 14.
ARABLYZER_BIGQUERY_CREDENTIALS=
ARABLYZER_BIGQUERY_PROJECT=
ARABLYZER_BIGQUERY_MAX_BYTES=

# Optional: the DNS-over-HTTPS resolver (RFC 8484) that the scanner asks for the SPF and DMARC records
# of a page's domain, as a URL. The scanner resolves no name itself, so it asks through the egress
# proxy, like all its traffic; empty: https://cloudflare-dns.com/dns-query. The domain's name goes
# to that resolver, and nothing else of the page (docs/methodology.md).
ARABLYZER_DOH_URL=

# ==================================================================================================
# 4. STAGING on one VPS behind Cloudflare (docs/deploy/staging.md, section 0)
# ==================================================================================================

# infra/deploy-staging.sh writes the next three lines itself and keeps them current; they are listed
# so that a plain `docker compose` in infra/ sees the same stack:
#   COMPOSE_FILE=compose.yaml:compose.staging.yaml:compose.vps.yaml
#   ARABLYZER_RELEASE=<git rev-parse --short=12 HEAD>
#   ARABLYZER_HOST=<the hostname of ARABLYZER_SITE>
# The address the TLS proxy (compose.vps.yaml) listens on, port 443: all by default. Narrow it on a
# server with several addresses.
ARABLYZER_TLS_BIND=
# Cloudflare's published ranges (https://www.cloudflare.com/ips/), space separated: the TLS proxy
# believes CF-Connecting-IP from these alone. Empty: the list in compose.vps.yaml, which is as of
# 2026-10; compare it before the first start and when Cloudflare announces a change.
ARABLYZER_CLOUDFLARE_RANGES=

# Staging only, with infra/compose.staging.yaml (docs/deploy/staging.md): the files that Compose reads,
# and the release that the images are named for and that a deploy runs, `git rev-parse --short=12 HEAD`.
# Going back is setting the release before it, and starting the stack again without building. Written
# here, both reach every `docker compose` command run in infra/, and `pnpm verify:deploy`.
# COMPOSE_FILE=compose.yaml:compose.staging.yaml
# ARABLYZER_RELEASE=
