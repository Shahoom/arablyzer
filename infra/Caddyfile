# The site's server (M2.1 plan §5b): the pages, /api to the API, every report's link to its
# language's report page, compressed, with the security headers, errors included. It writes no
# access log, and its error log keeps no visitor's address and no request header (BUILD-PLAN §14).
{
	admin off
	# Behind the host's proxy, which terminates TLS: X-Forwarded-For is read right to left, past
	# the proxies trusted here, to the visitor's own address. The port is published on loopback,
	# so only the host reaches it; ARABLYZER_TRUSTED_PROXIES narrows or widens the list, with a
	# CDN's published ranges when one is in front (infra/.env.example).
	servers {
		trusted_proxies static {$ARABLYZER_TRUSTED_PROXIES:private_ranges}
		trusted_proxies_strict
	}
	# An error the server answers (handle_errors) is logged at the debug level alone, which is off;
	# one it cannot answer is logged with the request, whose addresses and headers go (§14).
	log default {
		output stderr
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers delete
				request>tls delete
			}
		}
	}
}

# Deleting a header defers the lot to the response, which an error writes around: so the
# errors import them too.
(security) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Cross-Origin-Opener-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
	}
}

:{$PORT:8080} {
	encode zstd gzip
	import security

	handle /api/* {
		reverse_proxy api:8787 {
			# One address, the visitor's, which the API counts its limits by (§14).
			header_up X-Forwarded-For {client_ip}
			# The API believes that address only of a request that carries this secret: the API's
			# port is reachable by whatever else is on the edge network, and by the host itself,
			# and any of them could write any address in the header. Set here, it replaces a
			# header of the same name that a visitor sends.
			header_up X-Arablyzer-Proxy-Secret {$ARABLYZER_PROXY_SECRET}
			# A scan's events go to its page as they come.
			flush_interval -1
		}
	}

	# A report's link opens the report page of its language, never indexed (§6.5). The page's
	# file by its name goes to /r/ or /en/r/ first, as every page's does (below).
	@report path_regexp report ^/(en/)?r/(?:[A-Za-z0-9_-]{22}/?)?$
	handle @report {
		header X-Robots-Tag "noindex, nofollow"
		root * /srv
		rewrite * /{re.report.1}r/index.html
		file_server
	}

	# A page is its path's .html file (Astro's build.format 'preserve'): /tools is tools.html,
	# /tools/rtl-check is tools/rtl-check.html; a directory's page is its index.html.
	handle {
		root * /srv
		# Each page has one address (§6.5): its file's name, or a slash after it, goes there for
		# good, with the query: /index.html is /, /en/index is /en/, /tools.html and /tools/ are
		# /tools. A directory with a page keeps its slash, and file_server sends /en to /en/.
		# Only paths in the site's own characters redirect: to a browser, /\host is another site.
		@index path_regexp index ^((?:/[\w.~-]+)*/)index(?:\.html)?$
		redir @index {re.index.1}{?query} 308
		@html path_regexp html ^((?:/[\w.~-]+)+)\.html$
		redir @html {re.html.1}{?query} 308
		@slash {
			path_regexp slash ^((?:/[\w.~-]+)+)/$
			not file {path}index.html
		}
		redir @slash {re.slash.1}{?query} 308
		try_files {path}.html {path}
		file_server
	}

	handle_errors {
		import security
		# An address with no page: the 404 page of its language (M2.4b), with the 404 status. It
		# is never indexed, and says so in its <head>.
		@missing expression `{err.status_code} == 404`
		handle @missing {
			root * /srv
			header X-Robots-Tag "noindex, nofollow"
			rewrite /en /en/404.html
			rewrite /en/* /en/404.html
			rewrite * /404.html
			file_server {
				status 404
			}
		}
		respond "{err.status_code} {err.status_text}"
	}
}
