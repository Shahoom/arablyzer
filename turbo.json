{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "cache": false,
      "outputs": ["dist/**"],
      "passThroughEnv": [
        "ARABLYZER_SITE",
        "ARABLYZER_API_ORIGIN",
        "PUBLIC_TURNSTILE_SITE_KEY",
        "PUBLIC_AUTH_GOOGLE_CLIENT_ID"
      ]
    },
    "typecheck": {
      "cache": false
    },
    "test": {
      "cache": false
    },
    "test:ssrf": {
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false
    },
    "test:browser": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": [
        "ARABLYZER_REQUIRE_ENGINES",
        "ARABLYZER_CHROMIUM_PATH",
        "ARABLYZER_FIREFOX_PATH",
        "ARABLYZER_WEBKIT_PATH",
        "PLAYWRIGHT_BROWSERS_PATH"
      ]
    },
    "test:services": {
      "cache": false,
      "passThroughEnv": [
        "ARABLYZER_TEST_VALKEY_URL",
        "ARABLYZER_TEST_DATABASE_URL",
        "ARABLYZER_REQUIRE_SERVICES"
      ]
    }
  }
}
