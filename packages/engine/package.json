    "@arablyzer/rules": "workspace:*",
    "@arablyzer/scoring": "workspace:*",
    "pdfjs-dist": "6.3.289"
  },
  "devDependencies": {
    "@arablyzer/fixtures": "workspace:*",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
