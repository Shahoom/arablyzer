{
  "name": "@arablyzer/mcp",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "description": "Arablyzer's Model Context Protocol server: scan a page, read its report and the rule library, over stdio or streamable HTTP. It calls the public API and never the engine.",
  "bin": {
    "arablyzer-mcp": "./src/stdio.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "tsx src/stdio.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@arablyzer/api-contract": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@arablyzer/report-schema": "workspace:*"
  }
}
