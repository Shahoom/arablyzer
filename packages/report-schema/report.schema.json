{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "0.2.0"
    },
    "generator": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "const": "arablyzer"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
        },
        "rulesetVersion": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
        }
      },
      "required": [
        "name",
        "version",
        "rulesetVersion"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1
        },
        "finalUrl": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "fetchedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        "userAgent": {
          "type": "string",
          "minLength": 1
        },
        "http": {
          "type": "object",
          "properties": {
            "status": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 599
                },
                {
                  "type": "null"
                }
              ]
            },
            "contentType": {
              "type": [
                "string",
                "null"
              ]
            },
            "redirects": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "type": "integer",
                    "minimum": 300,
                    "maximum": 399
                  }
                },
                "required": [
                  "url",
                  "status"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "status",
            "contentType",
            "redirects"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "url",
        "finalUrl",
        "fetchedAt",
        "userAgent",
        "http"
      ],
      "additionalProperties": false
    },
    "scan": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "failed"
          ]
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "notices": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "message": {
                "$ref": "#/$defs/Localized"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "render": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RenderRun"
          }
        }
      },
      "required": [
        "status",
        "durationMs",
        "notices"
      ],
      "additionalProperties": false
    },
    "page": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "lang": {
              "type": [
                "string",
                "null"
              ]
            },
            "dir": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "ltr",
                    "rtl",
                    "auto"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "dominantScript": {
              "type": "string",
              "enum": [
                "arabic",
                "latin",
                "other",
                "none"
              ]
            }
          },
          "required": [
            "lang",
            "dir",
            "dominantScript"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "summary": {
      "type": "object",
      "properties": {
        "pass": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "fail": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "needsReview": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "notApplicable": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "error": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "bySeverity": {
          "type": "object",
          "properties": {
            "critical": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "serious": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "moderate": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "minor": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "info": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "critical",
            "serious",
            "moderate",
            "minor",
            "info"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "pass",
        "fail",
        "needsReview",
        "notApplicable",
        "error",
        "bySeverity"
      ],
      "additionalProperties": false
    },
    "score": {
      "$ref": "#/$defs/Score"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
          },
          "category": {
            "$ref": "#/$defs/Category"
          },
          "severity": {
            "$ref": "#/$defs/Severity"
          },
          "wcag": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\d+\\.\\d+\\.\\d+$"
            }
          },
          "status": {
            "$ref": "#/$defs/RuleStatus"
          },
          "title": {
            "$ref": "#/$defs/Localized"
          },
          "findingsOmitted": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "error": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "required": [
          "id",
          "version",
          "category",
          "severity",
          "status",
          "title"
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ruleId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "severity": {
            "$ref": "#/$defs/Severity"
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          },
          "message": {
            "$ref": "#/$defs/Localized"
          },
          "evidence": {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "minLength": 1
              },
              "selector": {
                "type": "string",
                "minLength": 1
              },
              "snippet": {
                "type": "string",
                "maxLength": 300
              },
              "location": {
                "type": "object",
                "properties": {
                  "line": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  "column": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "line"
                ],
                "additionalProperties": false
              },
              "engines": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "$ref": "#/$defs/Engine"
                }
              },
              "box": {
                "$ref": "#/$defs/Box"
              },
              "values": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/JsonValue"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "ruleId",
          "severity",
          "fingerprint",
          "message",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "facts": {
      "type": "object",
      "properties": {
        "robots": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 599
                },
                {
                  "type": "null"
                }
              ]
            },
            "aiCrawlers": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "minLength": 1
                  },
                  "purpose": {
                    "type": "string",
                    "enum": [
                      "search",
                      "training",
                      "user-fetch"
                    ]
                  },
                  "allowed": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "token",
                  "purpose",
                  "allowed"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "url",
            "status",
            "aiCrawlers"
          ],
          "additionalProperties": false
        },
        "crux": {
          "$ref": "#/$defs/CruxFact"
        },
        "lab": {
          "$ref": "#/$defs/LabFact"
        },
        "platform": {
          "$ref": "#/$defs/PlatformFact"
        },
        "knowledgeGraph": {
          "$ref": "#/$defs/KnowledgeGraphFact"
        },
        "openPageRank": {
          "$ref": "#/$defs/OpenPageRankFact"
        },
        "arabicFonts": {
          "$ref": "#/$defs/ArabicFontsFact"
        },
        "searchTest": {
          "$ref": "#/$defs/SearchTestFact"
        },
        "countryFit": {
          "$ref": "#/$defs/CountryFitFact"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "generator",
    "target",
    "scan",
    "page",
    "summary",
    "score",
    "rules",
    "findings",
    "facts"
  ],
  "additionalProperties": false,
  "title": "Arablyzer report",
  "description": "Output of one Arablyzer scan (arablyzer <url> --json).",
  "$defs": {
    "Localized": {
      "type": "object",
      "properties": {
        "ar": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "ar",
        "en"
      ],
      "additionalProperties": false
    },
    "RenderRun": {
      "type": "object",
      "properties": {
        "engine": {
          "$ref": "#/$defs/Engine"
        },
        "version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "rendered",
            "failed",
            "timeout",
            "unavailable",
            "refused"
          ]
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "requests": {
          "type": "object",
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "refused": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "total",
            "refused"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "engine",
        "version",
        "status",
        "durationMs",
        "requests"
      ],
      "additionalProperties": false
    },
    "Engine": {
      "type": "string",
      "enum": [
        "chromium",
        "firefox",
        "webkit"
      ]
    },
    "Score": {
      "type": "object",
      "properties": {
        "overall": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "categories": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/Category"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "partial": {
          "type": "boolean"
        },
        "rules": {
          "type": "object",
          "properties": {
            "ran": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "ran",
            "total"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "overall",
        "categories",
        "partial",
        "rules"
      ],
      "additionalProperties": false
    },
    "Category": {
      "type": "string",
      "enum": [
        "crawl",
        "index",
        "onpage",
        "links",
        "schema",
        "intl",
        "speed",
        "commerce",
        "ai",
        "trust",
        "ar-render",
        "rtl",
        "ar-content",
        "forms",
        "locale"
      ]
    },
    "Severity": {
      "type": "string",
      "enum": [
        "critical",
        "serious",
        "moderate",
        "minor",
        "info"
      ]
    },
    "RuleStatus": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "needs-review",
        "not-applicable",
        "error"
      ]
    },
    "Box": {
      "type": "object",
      "properties": {
        "x": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "y": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "width": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonValue"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          }
        }
      ]
    },
    "CruxFact": {
      "type": "object",
      "properties": {
        "outcome": {
          "type": "string",
          "enum": [
            "found",
            "not-found"
          ]
        },
        "scope": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "url",
                "origin"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "key": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "period": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "first": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "last": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                }
              },
              "required": [
                "first",
                "last"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "lcp": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "inp": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "cls": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "outcome",
        "scope",
        "key",
        "period",
        "lcp",
        "inp",
        "cls"
      ],
      "additionalProperties": false
    },
    "LabFact": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "measured",
            "failed",
            "timeout",
            "unavailable",
            "skipped"
          ]
        },
        "lighthouse": {
          "type": "string",
          "minLength": 1
        },
        "chromium": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "requests": {
          "type": "object",
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "refused": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "total",
            "refused"
          ],
          "additionalProperties": false
        },
        "performance": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "metrics": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "fcp": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "lcp": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "tbt": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "si": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "cls": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "fcp",
                "lcp",
                "tbt",
                "si",
                "cls"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "lighthouse",
        "chromium",
        "durationMs",
        "requests",
        "performance",
        "metrics"
      ],
      "additionalProperties": false
    },
    "PlatformFact": {
      "type": "object",
      "properties": {
        "primary": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "platform",
                    "builder",
                    "plugin",
                    "service"
                  ]
                },
                "version": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 32
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "confidence": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                }
              },
              "required": [
                "id",
                "name",
                "kind",
                "version",
                "confidence"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "technologies": {
          "maxItems": 40,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "kind": {
                "type": "string",
